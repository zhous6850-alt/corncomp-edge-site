{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corncomp-edge-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-19",
  "routes": [
    { "pattern": "corn-comp.com/*", "zone_name": "corn-comp.com" },
    { "pattern": "www.corn-comp.com/*", "zone_name": "corn-comp.com" }
  ],
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
