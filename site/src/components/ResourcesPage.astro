---
const { preview = true } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from '../components/ResponsiveMedia.astro';
import { mediaFor } from '../lib/visual-media.mjs';
import { englishInventory } from '../lib/localization.mjs';
import { contentText } from '../lib/content-routes.mjs';

const guides = [
  { title: 'Custom printed paper cups', topic: 'PRINT & CUSTOMIZATION', text: 'Prepare the artwork, cup construction and packing details for your brief.', route: '/resources/guides/custom-printed-paper-cups/' },
  { title: 'Food packaging certifications', topic: 'CERTIFICATION & MATERIALS', text: 'Understand what a certificate covers and which evidence to request.', route: '/resources/guides/food-packaging-certifications/' },
];
const sizeRoute = '/resources/guides/paper-cup-sizes/';
const previewImages = {
  [sizeRoute]: { src: '/media/generated/resources-cup-sizes-v2.png', width: 1536, height: 1024, alt: 'Illustrative comparison of four increasing paper cup sizes', fit: 'contain', position: 'center', evidence: 'product' },
  '/resources/guides/custom-printed-paper-cups/': { src: '/media/generated/resources-cup-print-v2.png', width: 1536, height: 1024, alt: 'Concept illustration of geometric paper cup printing and a matching paper sample', fit: 'contain', position: 'center', evidence: 'product' },
};
const guideMedia = (route) => previewImages[route] || mediaFor('architecture:' + route.replace(/^\/+|\/+$/g, ''));
const posts = englishInventory().filter((entry) => entry.type === 'post').slice(0, 3);
const enquiry = '/contact/?' + new URLSearchParams({ source: '/resources/', category: 'Packaging resources' });
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Know your packaging. Make informed choices.', url: 'https://corn-comp.com/resources/', about: { '@id': 'https://corn-comp.com/#organization' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://corn-comp.com/' }, { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://corn-comp.com/resources/' }] },
];
---
<BaseLayout title={preview ? 'Food Packaging Resources - Design Preview | Corncomp' : 'Food Packaging Resources | Corncomp'} description="Practical guides to packaging sizes, custom printing and certification review for foodservice buyers." pathname="/resources/" bodyClass="architecture-site" structuredData={schema} image={guideMedia(sizeRoute).src}>
  {preview && <p class="preview-note">DESIGN PREVIEW · 资源中心 · 正式站未修改</p>}
  <div class="resources-preview">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Resources</span></nav>
    <header class="resource-heading"><p class="eyebrow">CORNCOMP RESOURCES</p><h1>Know your packaging.<br/><span>Make informed choices.</span></h1><p>Practical guides to sizes, custom printing and certification scope. Find the details you need before your next inquiry.</p></header>
    <nav class="topic-nav" aria-label="Resource topics"><a href="#sizes">Sizes & selection <span>↘</span></a><a href="#guides">Printing & certification <span>↘</span></a><a href="#articles">Buyer articles <span>↘</span></a></nav>
    <section id="sizes" class="featured" aria-labelledby="featured-title">
      <a class="featured-image" href={preview ? '/design-preview/paper-cup-sizes/' : '/resources/guides/paper-cup-sizes/'} aria-label="Read the Paper Cup Sizes Guide"><ResponsiveMedia media={guideMedia(sizeRoute)} eager/></a>
      <div class="featured-copy"><p class="eyebrow">START WITH THE RIGHT FIT</p><h2 id="featured-title">A cup size is more<br/>than a volume.</h2><p>Compare capacity, rim diameter and height. Then check the lid and construction before choosing your cup.</p><a class="read-link" href={preview ? '/design-preview/paper-cup-sizes/' : '/resources/guides/paper-cup-sizes/'}>Explore the sizes guide <span aria-hidden="true">↗</span></a><p class="guide-note">Paper Cup Sizes Guide</p></div>
    </section>
    <section id="guides" class="guides-section" aria-labelledby="guides-title">
      <div class="section-heading"><h2 id="guides-title">Plan the details.</h2><p>From a print brief to a document check, start with the questions that matter.</p></div>
      <div class="guide-grid">{guides.map((guide) => <article class="guide"><a href={guide.route}><div class="guide-image"><ResponsiveMedia media={guideMedia(guide.route)}/></div><div class="guide-copy"><p class="topic">{guide.topic}</p><h3>{guide.title}<span aria-hidden="true">↗</span></h3><p>{guide.text}</p></div></a></article>)}</div>
    </section>
    <section id="articles" class="articles-section" aria-labelledby="articles-title"><div class="articles-heading"><h2 id="articles-title">More for buyers.</h2><a class="read-link" href={preview ? '/design-preview/blog/' : '/blog/'}>View all articles <span aria-hidden="true">↗</span></a></div>
      <div class="article-list">{posts.map((post) => <article class="article"><a href={post.route}><div class="article-image"><ResponsiveMedia media={mediaFor(post.contentKey)}/></div><div><p class="topic">BUYER READING</p><h3>{contentText(post.title)}</h3></div><span aria-hidden="true">↗</span></a></article>)}</div>
    </section>
    <aside class="resource-help"><div><h2>Need details for a specific product?</h2><p>Send the item reference and destination market. We can review the available specifications and relevant documents.</p></div><a class="help-action" href={enquiry}>Ask our team <span aria-hidden="true">↗</span></a></aside>
  </div>
</BaseLayout>
<style>
  .resources-preview{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;color:var(--ink);max-width:1320px;padding:0 48px 64px;margin:auto}.preview-note{margin:0;padding:8px 16px;background:#edf1e7;text-align:center;font-size:11px;color:#405e42}.crumb{display:flex;gap:12px;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}h1,h2,h3,p{text-wrap:pretty}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}a:active{opacity:.8}section{scroll-margin-top:110px}
  .resource-heading{padding:24px 0 32px;max-width:890px}.eyebrow,.topic{font-size:10px;letter-spacing:.13em;font-weight:700;margin:0 0 18px}.resource-heading h1{font-size:clamp(40px,4.5vw,64px);line-height:1.08;letter-spacing:-.045em;margin:0 0 24px}.resource-heading h1 span{color:#718466}.resource-heading>p:last-child{max-width:610px;font-size:17px;line-height:1.8;color:var(--muted);margin:0}
  .topic-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;border-block:1px solid var(--line);margin-bottom:40px}.topic-nav a{display:flex;justify-content:space-between;gap:12px;padding:22px 0;text-decoration:none;font-size:14px}.topic-nav a:hover{text-decoration:underline;text-underline-offset:5px}
  .featured{display:grid;grid-template-columns:1.1fr 1fr;background:#edf1e7;align-items:center;min-width:0}.featured-image{display:block;min-width:0}.featured-image :global(img){display:block;width:100%;height:360px;object-fit:cover}.featured-copy{padding:36px 44px}.featured h2{font-size:clamp(30px,3vw,42px);line-height:1.12;letter-spacing:-.035em;margin:0 0 22px}.featured-copy>p:not(.eyebrow):not(.guide-note){font-size:15px;line-height:1.8;color:var(--muted);max-width:380px;margin:0 0 26px}.read-link{display:inline-flex;align-items:center;gap:24px;font-size:13px;font-weight:600;text-underline-offset:6px;min-height:44px}.read-link:hover{color:#4b6c35}.guide-note{font-size:10px;color:var(--muted);margin:18px 0 0}
  .guides-section{padding:64px 0}.section-heading{margin-bottom:28px}.section-heading h2,.articles-heading h2{font-size:38px;letter-spacing:-.035em;line-height:1.15;margin:0 0 14px}.section-heading p{font-size:15px;color:var(--muted);line-height:1.8;max-width:550px;margin:0}.guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.guide a{text-decoration:none;display:block}.guide-image{background:#eef0e9;overflow:hidden}.guide-image :global(img){width:100%;height:240px;object-fit:cover;display:block;transition:transform .2s}.guide a:hover :global(img){transform:scale(1.025)}.guide-copy{padding:22px 0 0}.topic{color:#526c48;font-size:9px;margin:0 0 12px}.guide h3{display:flex;gap:24px;justify-content:space-between;font-size:26px;letter-spacing:-.025em;line-height:1.2;margin:0 0 14px}.guide h3 span{font-size:22px;font-weight:400}.guide-copy>p:last-child{font-size:14px;line-height:1.8;color:var(--muted);max-width:440px;margin:0}.guide a:hover h3{text-decoration:underline;text-underline-offset:5px}
  .articles-section{border-top:1px solid var(--line);padding:40px 0 56px;display:grid;grid-template-columns:.8fr 1.2fr;gap:64px}.articles-heading h2{max-width:230px}.article a{display:grid;grid-template-columns:110px minmax(0,1fr) 20px;gap:22px;align-items:center;text-decoration:none;padding:20px 0;border-bottom:1px solid var(--line)}.article:first-child a{padding-top:0}.article-image :global(img){width:110px;height:86px;object-fit:cover;display:block}.article h3{font-size:20px;letter-spacing:-.02em;line-height:1.35;margin:0}.article a:hover h3{text-decoration:underline;text-underline-offset:4px}.article a>span{font-size:21px}.article .topic{margin-bottom:8px}
  .resource-help{display:flex;justify-content:space-between;align-items:center;gap:40px;background:#e8ede2;padding:36px 40px}.resource-help h2{font-size:26px;letter-spacing:-.025em;line-height:1.2;margin:0 0 14px}.resource-help p{font-size:14px;line-height:1.8;color:var(--muted);max-width:640px;margin:0}.help-action{display:inline-flex;align-items:center;gap:30px;white-space:nowrap;padding:16px 22px;min-height:48px;background:#3d6145;color:#f3f1dd;border-radius:3px;font-size:13px;font-weight:600;text-decoration:none}.help-action:hover{background:#1c3927}
  @media(prefers-reduced-motion:reduce){.guide-image :global(img){transition:none}}
  @media(max-width:1000px){.resources-preview{padding-inline:28px}.featured-copy{padding:28px}.featured-image :global(img){height:340px}.articles-section{gap:36px;grid-template-columns:.7fr 1.3fr}}
  @media(max-width:760px){.resources-preview{padding:0 20px 36px}.crumb{padding:22px 0;font-size:12px}.resource-heading{padding:16px 0 28px}.resource-heading h1{font-size:40px}.resource-heading>p:last-child{font-size:16px}.topic-nav{grid-template-columns:1fr;gap:0;margin-bottom:28px}.topic-nav a{padding:16px 0;border-bottom:1px solid var(--line)}.topic-nav a:last-child{border:0}.featured{grid-template-columns:1fr}.featured-image :global(img){height:240px}.featured-copy{padding:28px}.featured h2{font-size:34px}.guides-section{padding:40px 0}.guide-grid{grid-template-columns:1fr;gap:32px}.guide-image :global(img){height:220px}.guide h3{font-size:25px}.section-heading h2,.articles-heading h2{font-size:32px}.articles-section{grid-template-columns:1fr;gap:24px;padding:32px 0 40px}.articles-heading h2{max-width:none;margin-bottom:6px}.article a{grid-template-columns:80px minmax(0,1fr) 16px;gap:16px}.article-image :global(img){width:80px;height:78px}.article h3{font-size:18px}.resource-help{align-items:start;flex-direction:column;gap:22px;padding:28px}.resource-help h2{font-size:25px}}
</style>
