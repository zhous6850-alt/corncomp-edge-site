---
import {englishInventory,routeFor} from '../lib/localization.mjs';
import {SIZE_SOURCE,SIZE_LABELS,paperCupSizeRows} from '../data/paper-cup-sizes.mjs';
const {language}=Astro.props;
const t=SIZE_LABELS[language],rows=paperCupSizeRows(englishInventory());
const source=routeFor(language,`product:${SIZE_SOURCE}`);
---
<section id="paper-cup-sizes" class="paper-cup-sizes" aria-labelledby="cup-sizes-title"><h3 id="cup-sizes-title">{t.title}</h3><p>{t.intro}</p><p><a href={source}>{t.source} ↗</a></p><div class="table-scroll" role="region" aria-labelledby="cup-sizes-title" tabindex="0"><table class="cup-size-table"><caption>{t.note}</caption><thead><tr>{t.headers.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{rows.map(row=><tr><th scope="row"><a href={source}><bdi>{row.code}</bdi></a></th><td><bdi>{row.volume}</bdi></td><td><bdi>{row.top}</bdi></td><td><bdi>{row.bottom}</bdi></td><td><bdi>{row.height}</bdi></td></tr>)}</tbody></table></div><h4>{t.measureTitle}</h4><dl>{t.steps.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><p class="fit-note">{t.fit}</p><nav aria-label={t.title}><a href="#paper-cup-comparison">{t.links[0]} ↑</a><a href="#paper-cup-lids-title">{t.links[1]} ↓</a><a href={routeFor(language,'architecture:custom-packaging/custom-printed-paper-cups')}>{t.links[2]} ↗</a></nav></section>
<style>
 .paper-cup-sizes{padding:36px 0 12px;color:#1c3927;scroll-margin-top:125px}h3{font-size:clamp(25px,2.5vw,32px);line-height:1.2;margin:0 0 16px}h4{font-size:23px;margin:30px 0 18px}p{font-size:15px;line-height:1.7;color:#617065;margin:0 0 18px}.table-scroll{overflow-x:auto;overscroll-behavior-x:contain;max-width:100%;border:1px solid #dce3da;background:#fff}table{border-collapse:collapse;width:100%;min-width:760px;text-align:start;font-size:14px}th,td{text-align:start;padding:16px 18px;border-bottom:1px solid #dce3da;line-height:1.5}thead th{font-size:12px;background:#edf1e7}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}caption{caption-side:bottom;text-align:start;padding:16px 20px;background:#f7f9f4;color:#617065;font-size:13px;line-height:1.7}bdi{white-space:nowrap}dl{margin:0}dl>div{display:grid;grid-template-columns:190px 1fr;gap:24px;padding:18px 0;border-top:1px solid #dce3da}dt{font-weight:700;line-height:1.5}dd{margin:0;color:#617065;line-height:1.7;font-size:15px}.fit-note{padding:18px 20px;background:#edf1e7;border-inline-start:3px solid #71935e;margin:20px 0}nav{display:flex;flex-wrap:wrap;gap:20px}a{color:inherit;text-underline-offset:4px;font-size:14px}.table-scroll:focus-visible,a:focus-visible{outline:3px solid #71935e;outline-offset:3px}@media(max-width:650px){dl>div{grid-template-columns:1fr;gap:8px}th,td{padding:14px}.paper-cup-sizes{padding-top:28px}}
</style>
