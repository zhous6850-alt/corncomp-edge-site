---
import { Image } from 'astro:assets';
import { FOREST_PRODUCT_IMAGES, PRODUCT_IMAGE_BACKGROUND } from '../data/product-image-background.mjs';

const { media, eager = false, class: className = '' } = Astro.props;
---
{media && <Image
  src={media.src}
  width={media.width}
  height={media.height}
  alt={media.evidence === 'decorative' ? '' : media.alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
  class={className}
  style={`object-fit: ${media.fit}; object-position: ${media.position};${FOREST_PRODUCT_IMAGES.has(media.src) ? ` background: ${PRODUCT_IMAGE_BACKGROUND};` : ''}`}
/>}
