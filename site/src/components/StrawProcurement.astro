---
import {englishInventory,localizedEntry,routeFor} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import {companyCertificates} from '../data/certificates.mjs';
import {BPI_STRAW_LISTING,strawProcurementRows,STRAW_LABELS} from '../data/straw-procurement.mjs';
const {language,page}=Astro.props;
const t=STRAW_LABELS[language],certificate=companyCertificates(language).find(record=>record.key==='bpi-straws');
const rows=strawProcurementRows(englishInventory());
const quote=row=>routeFor(language,'architecture:contact')+'?'+new URLSearchParams({product:contentText(localizedEntry(language,'product:'+row.slug).title),category:page.title,source:page.route});
const documents=row=>routeFor(language,'architecture:contact')+'?'+new URLSearchParams({product:`${t.docProduct} — ${row.diameter} × ${row.length} mm`,sku:row.sku,category:page.title,source:page.route});
---
<section id="straw-procurement" class="straw-procurement" aria-labelledby="straw-procurement-title">
 <header><h2 id="straw-procurement-title">{t.title}</h2><p>{t.intro}</p></header>
 <div class="bpi-answer"><h3>{t.bpiTitle}</h3><p>{t.bpiAnswer}</p><p class="certificate-scope">{certificate.scope}</p>
  <dl class="certificate-meta">{[certificate.holder,certificate.certificateNumber,certificate.standard,certificate.validUntil].map((value,index)=><div><dt>{t.fields[index]}</dt><dd><bdi>{value}</bdi></dd></div>)}</dl>
  <p>{t.scopeNote}</p><div class="document-links"><a href={routeFor(language,'architecture:quality')+'#documents'}>{t.quality} <span aria-hidden="true">↗</span></a><a href={BPI_STRAW_LISTING.source} rel="noopener" target="_blank">{t.registry} <span aria-hidden="true">↗</span></a></div>
 </div>
 <p class="listing-date">{t.checked}: <time datetime={BPI_STRAW_LISTING.checkedOn}>{BPI_STRAW_LISTING.checkedOn}</time></p>
 <details class="bpi-list"><summary>{t.listing}</summary><p>{t.listNote}</p><p class="scroll-hint">{t.scroll}</p>
  <div class="table-scroll" role="region" aria-label={t.listing} tabindex="0"><table class="bpi-straw-table"><thead><tr>{t.bpiHeaders.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{BPI_STRAW_LISTING.items.map(row=><tr><th scope="row"><bdi class="item-code">{row.sku}</bdi></th><td><bdi>{row.diameter}</bdi></td><td><bdi>{row.length}</bdi></td><td><a class="document-quote" href={documents(row)}>{t.request} <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div>
 </details>
 <div class="series-comparison"><h3 id="straw-series-title">{t.seriesTitle}</h3><p class="scroll-hint" id="straw-scroll-hint">{t.scroll}</p>
  <div class="table-scroll" role="region" aria-labelledby="straw-series-title" aria-describedby="straw-scroll-hint" tabindex="0"><table class="straw-series-table"><caption>{t.packingNote}</caption><thead><tr>{t.seriesHeaders.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{rows.map(row=><tr><th scope="row">{contentText(localizedEntry(language,'product:'+row.slug).title)}{row.format==='bare'?` — ${t.formatBare}`:row.format==='wrapped'?` — ${t.formatWrapped}`:''}</th><td><bdi>{row.perPack}</bdi></td><td><bdi>{row.packs}</bdi></td><td><bdi>{row.total}</bdi></td><td><a href={routeFor(language,'product:'+row.slug)}>{t.details} <span aria-hidden="true">↗</span></a></td><td><a class="series-quote" href={quote(row)}>{t.quote} <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div>
 </div>
 <div class="order-brief"><h3>{t.orderTitle}</h3><p>{t.orderText}</p><a class="custom-route" href={routeFor(language,'architecture:custom-packaging/custom-paper-straws')}>{t.custom} <span aria-hidden="true">↗</span></a></div>
</section>
<style>
 .straw-procurement{padding:40px 0 20px;color:#1c3927;scroll-margin-top:130px}.straw-procurement header{max-width:920px}.straw-procurement h2{font-size:clamp(28px,3vw,36px);letter-spacing:-.03em;line-height:1.15;margin:0 0 16px}.straw-procurement h3{font-size:clamp(24px,2.5vw,30px);letter-spacing:-.025em;line-height:1.2;margin:0 0 14px}.straw-procurement p{font-size:15px;line-height:1.65;color:#617065;margin:0 0 18px}.bpi-answer{margin-top:28px;padding:28px 30px;background:#edf1e7;border-inline-start:3px solid #71935e}.straw-procurement .certificate-scope{font-size:18px;font-weight:600;color:#1c3927;max-width:920px}.certificate-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 40px;margin:24px 0}.certificate-meta>div{border-top:1px solid #d4ddcd;padding-top:12px;min-width:0}dt{font-size:12px;color:#617065;margin-bottom:5px}dd{font-size:16px;line-height:1.5;margin:0;overflow-wrap:anywhere}.document-links{display:flex;flex-wrap:wrap;gap:16px 30px;font-size:14px;font-weight:700}a{color:inherit;text-underline-offset:4px}a:focus-visible,summary:focus-visible,.table-scroll:focus-visible{outline:3px solid #71935e;outline-offset:3px}.straw-procurement .listing-date{font-size:12px;margin:18px 0 10px}.bpi-list{border:1px solid #dce3da;background:#fff;padding:18px 22px}.bpi-list summary{font-size:16px;font-weight:700;cursor:pointer;line-height:1.5}.bpi-list[open] summary{margin-bottom:20px}.series-comparison{padding-top:36px}.straw-procurement .scroll-hint{font-size:12px;margin:0 0 8px}.table-scroll{overflow-x:auto;overscroll-behavior-x:contain;max-width:100%;border:1px solid #dce3da;background:#fff}table{width:100%;border-collapse:collapse;font-size:14px;line-height:1.5;text-align:start}.straw-series-table{min-width:950px}.bpi-straw-table{min-width:630px}th,td{padding:16px 18px;border-bottom:1px solid #dce3da;text-align:start;vertical-align:middle}thead th{font-size:12px;background:#edf1e7;font-weight:700}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.straw-series-table tbody th{max-width:260px;min-width:210px;font-size:15px;font-weight:600}.item-code{font-family:ui-monospace,monospace;font-size:13px;white-space:nowrap}.series-quote,.document-quote{font-weight:700;font-size:12px}caption{caption-side:bottom;text-align:start;padding:16px 20px;font-size:13px;line-height:1.6;color:#617065;background:#f7f9f4}.order-brief{padding:32px 0 24px;border-bottom:1px solid #dce3da}.order-brief p{max-width:950px}.custom-route{display:inline-flex;align-items:center;gap:24px;background:#1c3927;color:#fffdf8;padding:16px 20px;font-size:14px;font-weight:700;text-decoration:none}.custom-route:hover{text-decoration:underline}
 @media(max-width:680px){.straw-procurement{padding-top:30px}.bpi-answer{padding:22px 20px}.certificate-meta{grid-template-columns:1fr;gap:14px}.straw-procurement .certificate-scope{font-size:17px}.straw-procurement p{font-size:14px}.bpi-list{padding:16px}.series-comparison{padding-top:30px}th,td{padding:14px}.document-links{flex-direction:column;gap:14px}}
</style>
