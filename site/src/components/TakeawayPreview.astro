---
const {preview = true} = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import {englishInventory} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import mediaInventory from '../data/media.json';
const steps=[
 {title:'Pack the meal.',label:'THE MAIN PORTION',slug:'natural-kraft-menu-box',copy:'Start with the filled portion. A folded meal box gives you a format to compare for rice dishes, vegetables and other prepared meals.',choose:'Portion footprint, food height and space needed to close the lid.',try:'Fill a sample with your usual serving. Close it without pressing on the food and check the pack during handling.',link:'Compare meal box sizes'},
 {title:'Choose a second format.',label:'ALTERNATIVES & EXTRA ITEMS',slug:'white-cardboard-box-wire-handle',copy:'A wire-handle food pail offers a different shape to consider for your menu. Choose it around the food you pack, rather than adding it to every order.',choose:'Filled volume, opening size and how staff fill and close the top.',try:'Use the actual food and portion to check access, closure and handling. Liquid or sauce requirements need a separate suitability review.',link:'Explore handled food pails'},
 {title:'Plan the handover.',label:'THE COMPLETE ORDER',slug:'kraft-handle-paper-bag',copy:'Bring the selected packs together with cutlery and any other order items. Compare the carrier with the complete order, not just one empty box.',choose:'Bag base dimensions, filled pack arrangement and total order weight.',try:'Trial the filled order in the proposed bag, including lifting and the planned handover. Size alone does not establish carrying performance.',link:'View paper bag options'},
].map(s=>{
 const p=englishInventory().find(p=>p.type==='product'&&p.slug===s.slug),a=p.featuredMedia,size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...s,product:p,media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const enquiry='/contact/?'+new URLSearchParams({category:'Takeaway & Delivery',source:'/applications/takeaway-packaging/'}).toString();
const schema={'@context':'https://schema.org','@type':'WebPage',name:'From your kitchen to their table.',url:'https://corn-comp.com/applications/takeaway-packaging/',about:{'@id':'https://corn-comp.com/#organization'}};
---
<BaseLayout title={preview ? 'Takeaway & Delivery Packaging - Design Preview | Corncomp' : 'Takeaway & Delivery Packaging | Corncomp'} description="Plan meal boxes, alternative food formats and carrying bags around the complete takeaway order." pathname="/applications/takeaway-packaging/" bodyClass="architecture-site" structuredData={[schema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:'Takeaway & Delivery',item:schema.url}]}]}>
 {preview && <div class="preview-note">DESIGN PREVIEW · TAKEAWAY & DELIVERY V2 · 正式站未修改</div>}
 <div class="takeaway-page">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? "/design-preview/applications/" : "/applications/"}>Applications</a><span>/ Takeaway & Delivery</span></nav>
 <header class="takeaway-heading"><p class="eyebrow">TAKEAWAY & DELIVERY / THE WHOLE ORDER</p><div><h1>From your kitchen<br/><span>to their table.</span></h1><div><p>The meal box is only part of the order.<br/>Plan how the food is packed, what goes with it and how it is handed over.</p><a href="#packing-journey">Build the takeaway set ↓</a></div></div></header>
 <figure class="packing-scene"><img src="/media/generated/takeaway-packing-scene-preview.png" width="1536" height="1024" alt="Illustrative restaurant packing counter with a meal box, handled food pail and paper carrier bag" fetchpriority="high"/><figcaption><span>AT THE PASS / portion · closure · complete order</span><span>AI-generated scene illustration. Product photos below show catalogue formats.</span></figcaption></figure>
 <nav class="journey-index" aria-label="Takeaway packing stages">{steps.map((s,i)=><a href={'#pack-'+i}><span>0{i+1}</span>{s.title}<b>↓</b></a>)}</nav>
 <section id="packing-journey" class="packing-journey" aria-label="Build the takeaway order">{steps.map((s,i)=><article id={'pack-'+i} class="journey-step"><div class="step-number">0{i+1}<span>{s.label}</span></div><div class="step-content"><div class="step-copy"><h2>{s.title}</h2><p>{s.copy}</p><dl><div><dt>Choose by</dt><dd>{s.choose}</dd></div><div><dt>Try with a filled sample</dt><dd>{s.try}</dd></div></dl><div class="product-actions"><a href={s.product.route}>{s.link} ↗</a><a href={enquiry+'&product='+encodeURIComponent(contentText(s.product.title))}>Ask about this format ↗</a></div></div><a class="step-image" href={s.product.route} aria-label={'View '+contentText(s.product.title)}><ResponsiveMedia media={s.media}/></a></div></article>)}</section>
 <section class="dispatch-check"><div><p class="eyebrow">BEFORE THE ORDER LEAVES</p><h2>Test the order<br/>as one set.</h2><p>Use the meal, accessories and carrier together under the conditions you expect during service.</p></div><div class="dispatch-list"><div><h3>Food & holding time</h3><p>Share the serving temperature, sauce or oil content, and time between packing and eating.</p></div><div><h3>Closure & arrangement</h3><p>Check lid clearance, separate items and the way the filled packs sit inside the carrier.</p></div><div><h3>Collection & transport</h3><p>Describe counter pickup or delivery, handling, stacking and carrying requirements.</p></div></div><p class="suitability-note">Final suitability depends on the selected material, construction and actual food conditions. Leak resistance, temperature suitability, carrying strength and holding performance need appropriate item-specific checks; the images do not establish these properties.</p></section>
 <section class="takeaway-close"><div><p class="eyebrow">START WITH YOUR USUAL ORDER</p><h2>What leaves<br/>your kitchen together?</h2><p>Send a menu or portion photo, filled dimensions, typical order contents, serving and delivery conditions, quantity and destination.</p></div><div><a class="project-button" href={enquiry}>Plan your takeaway packaging ↗</a><a href="/custom-packaging/">Need your branding? Explore custom packaging ↗</a><a href={preview ? "/design-preview/applications/" : "/applications/"}>← All applications</a></div></section>
 </div>
</BaseLayout>
<style>
 .takeaway-page{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;text-align:center;color:#405e42;padding:8px 16px;font-size:11px}.crumb{display:flex;gap:12px;flex-wrap:wrap;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}.takeaway-heading{padding:22px 0 36px}.takeaway-heading>div{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.takeaway-heading h1{font-size:clamp(44px,4.8vw,68px);line-height:1.05;letter-spacing:-.045em;margin:0}.takeaway-heading h1 span{color:#718466}.takeaway-heading p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted);margin:0 0 20px}.takeaway-heading a{font-size:14px;font-weight:700;text-underline-offset:5px}.packing-scene{margin:0}.packing-scene>img{width:100%;height:420px;object-fit:cover;display:block}.packing-scene figcaption{padding:13px 0;display:flex;justify-content:space-between;gap:25px;font-size:10px;color:var(--muted);line-height:1.7}.journey-index{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line);margin-top:20px}.journey-index a{display:flex;align-items:center;gap:20px;font-size:14px;text-decoration:none;padding:22px 20px;border-right:1px solid var(--line)}.journey-index a:first-child{padding-left:0}.journey-index a:last-child{border:0}.journey-index span{font-size:10px;color:#7b8b70}.journey-index b{margin-left:auto;font-weight:400}.journey-step{display:grid;grid-template-columns:110px 1fr;gap:28px;padding:48px 0;border-bottom:1px solid var(--line);scroll-margin-top:120px}.step-number{font-size:48px;font-weight:400;line-height:1;color:#8a9a7c;letter-spacing:-.04em}.step-number span{display:block;font-size:9px;letter-spacing:.1em;line-height:1.8;margin-top:16px;color:#74836a;max-width:100px}.step-content{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}.step-copy h2,.dispatch-check h2,.takeaway-close h2{font-size:clamp(32px,3.2vw,44px);line-height:1.1;letter-spacing:-.035em;margin:0 0 20px}.step-copy>p{font-size:16px;line-height:1.8;color:var(--muted);max-width:500px}.step-copy dl{margin:24px 0}.step-copy dl>div{border-top:1px solid var(--line);padding:15px 0}.step-copy dt{font-size:12px;font-weight:700;margin-bottom:8px}.step-copy dd{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.product-actions{display:flex;gap:16px 24px;flex-wrap:wrap}.product-actions a{font-size:13px;font-weight:700;text-underline-offset:5px}.step-image{display:block;background:#fff}.step-image :global(img){display:block;object-fit:contain;width:100%;height:350px}.journey-step:nth-child(2) .step-content{direction:rtl}.journey-step:nth-child(2) .step-content>*{direction:ltr}.dispatch-check{display:grid;grid-template-columns:.9fr 1.1fr;gap:36px 65px;background:#edf1e7;padding:44px;margin-top:44px}.dispatch-check>div>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted)}.dispatch-list>div{border-top:1px solid #cad5c3;padding:18px 0}.dispatch-list h3{font-size:20px;letter-spacing:-.02em;margin:0 0 10px}.dispatch-list p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.suitability-note{grid-column:1/-1;font-size:12px;line-height:1.8;color:var(--muted);border-top:1px solid #cad5c3;padding-top:18px;margin:0}.takeaway-close{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding-top:56px}.takeaway-close p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:550px}.takeaway-close>div:last-child{display:flex;flex-direction:column;align-items:start;gap:22px}.takeaway-close a{font-size:12px;text-underline-offset:5px}.project-button{display:inline-flex;background:var(--ink);color:#f3f1dd;min-height:52px;padding:17px 22px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}
 @media(max-width:950px){.takeaway-page{padding-inline:28px}.takeaway-heading>div{gap:32px}.journey-step{grid-template-columns:70px 1fr;gap:20px}.step-content{gap:28px}.step-image :global(img){height:280px}.dispatch-check{padding:32px;gap:30px}}
 @media(max-width:650px){.takeaway-page{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.takeaway-heading{padding:16px 0 28px}.takeaway-heading>div{grid-template-columns:1fr;gap:24px}.takeaway-heading h1{font-size:44px}.takeaway-heading p:not(.eyebrow){font-size:16px}.packing-scene>img{height:270px}.packing-scene figcaption{flex-direction:column;gap:7px}.journey-index{grid-template-columns:1fr}.journey-index a,.journey-index a:first-child{padding:16px 0;border-right:0;border-bottom:1px solid var(--line)}.journey-index a:last-child{border:0}.journey-step{grid-template-columns:1fr;gap:24px;padding:32px 0}.step-number{font-size:36px;display:flex;align-items:center;gap:20px}.step-number span{margin:0;max-width:none;font-size:9px}.step-content{display:flex;flex-direction:column;gap:25px;align-items:stretch}.journey-step:nth-child(2) .step-content{direction:ltr}.step-image{order:-1}.step-image :global(img){height:280px}.step-copy h2,.dispatch-check h2,.takeaway-close h2{font-size:33px}.dispatch-check{grid-template-columns:1fr;padding:28px 24px;gap:24px;margin-top:32px}.takeaway-close{grid-template-columns:1fr;gap:24px;padding-top:40px}.preview-note{font-size:10px}}
</style>
