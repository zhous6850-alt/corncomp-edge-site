---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_GROUPS } from '../data/faq.mjs';
const { preview = true } = Astro.props;
const schema = [
  {'@context':'https://schema.org','@type':'FAQPage',name:'Frequently asked questions.',url:'https://corn-comp.com/faq/',mainEntity:FAQ_GROUPS.flatMap(group=>group.items).map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[['Home','/'],['Resources','/resources/'],['FAQ','/faq/']].map(([name,route],index)=>({'@type':'ListItem',position:index+1,name,item:'https://corn-comp.com'+route}))},
];
---
<BaseLayout title={preview ? 'FAQ | Design Preview | Corncomp' : 'Frequently Asked Questions | Corncomp'} description="Answers about minimum orders, samples, custom printing, materials, certifications and international delivery. Confirm terms for your selected product." pathname="/faq/" bodyClass="architecture-site" structuredData={schema}>
  {preview && <div class="preview-note">DESIGN PREVIEW · FAQ 问答页 · 正式站未修改</div>}
  <main class="faq-page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>FAQ</span></nav>
    <header class="faq-hero"><p class="eyebrow">CORNCOMP / BUYER SUPPORT</p><h1>Frequently asked<br/><span>questions.</span></h1><p>Practical answers about ordering, custom printing and choosing packaging for your business.</p></header>
    <div class="faq-layout">
      <aside class="topic-sidebar"><nav aria-label="FAQ topics"><p>Browse by topic</p>{FAQ_GROUPS.map(group=><a href={'#'+group.id}>{group.title}<span aria-hidden="true">↘</span></a>)}</nav><div class="quotation-note"><h2>Before you order</h2><p>Final specifications, minimum quantities, timing and commercial terms are confirmed in your quotation and order.</p></div></aside>
      <div class="question-groups">{FAQ_GROUPS.map((group,index)=><section class="faq-group" id={group.id} aria-labelledby={group.id+'-title'}><header><h2 id={group.id+'-title'}>{group.title}</h2><p>{group.description}</p></header><div class="questions">{group.items.map((item,itemIndex)=><details id={item.id} open={index===0 && itemIndex===0}><summary>{item.question}<span class="toggle" aria-hidden="true"></span></summary><div class="answer"><p>{item.answer}</p>{item.link && <a href={item.link[1]}>{item.link[0]} <span aria-hidden="true">↗</span></a>}</div></details>)}</div></section>)}</div>
    </div>
    <section class="faq-contact"><div><h2>Have a question<br/>about a specific product?</h2><p>Send the item reference, quantity, intended use and destination so we can review the details with you.</p></div><a class="action" href="/contact/?source=%2Ffaq%2F">Ask our team <span aria-hidden="true">↗</span></a></section>
  </main>
</BaseLayout>
<script is:inline>
  (() => {
    const openLinkedAnswer = () => {
      const target = document.getElementById(window.location.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    };
    openLinkedAnswer();
    window.addEventListener('hashchange', openLinkedAnswer);
  })();
</script>
<style>
  .faq-page{--ink:#1d3826;--muted:#657068;--line:#d4dbcf;max-width:1320px;margin:auto;padding:36px 48px 90px;color:var(--ink);text-wrap:pretty}.preview-note{background:#ecf0e6;text-align:center;padding:9px;font-size:12px;letter-spacing:.08em}.crumb{display:flex;flex-wrap:wrap;gap:12px;font-size:14px;color:var(--muted);margin-bottom:56px}.crumb a{text-decoration:none}.faq-hero{max-width:820px;margin-bottom:72px}.eyebrow{font-size:12px;letter-spacing:.16em;font-weight:700;margin:0 0 22px}.faq-hero h1{font-size:clamp(42px,6.5vw,86px);line-height:1.03;letter-spacing:-.045em;margin:0}.faq-hero h1 span{color:#78846c}.faq-hero>p:last-child{max-width:580px;font-size:20px;line-height:1.65;margin:28px 0 0;color:var(--muted)}.faq-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:9%;align-items:start}.topic-sidebar{position:sticky;top:120px}.topic-sidebar nav>p{font-size:12px;color:var(--muted);margin:0 0 16px}.topic-sidebar nav a{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:16px 0;font-size:15px;font-weight:600;text-decoration:none;border-bottom:1px solid var(--line);min-height:48px}.topic-sidebar nav a:hover{color:#406345}.topic-sidebar nav span{font-size:18px}.quotation-note{margin-top:32px;background:#ecf0e6;padding:24px}.quotation-note h2{font-size:18px;margin:0 0 14px;letter-spacing:-.015em}.quotation-note p{font-size:14px;line-height:1.75;color:var(--muted);margin:0}.faq-group{scroll-margin-top:120px;margin-bottom:62px}.faq-group:last-child{margin-bottom:0}.faq-group>header{padding-bottom:18px;border-bottom:1px solid var(--ink)}.faq-group h2{font-size:30px;letter-spacing:-.025em;line-height:1.2;margin:0 0 12px}.faq-group header p{font-size:15px;line-height:1.6;color:var(--muted);margin:0}.questions details{border-bottom:1px solid var(--line);scroll-margin-top:120px}.questions summary{display:flex;justify-content:space-between;align-items:center;gap:24px;list-style:none;font-size:18px;font-weight:600;line-height:1.45;cursor:pointer;min-height:76px;padding:23px 0}.questions summary::-webkit-details-marker{display:none}.toggle{width:16px;height:16px;position:relative;flex-shrink:0}.toggle:before,.toggle:after{content:'';display:block;background:currentColor;position:absolute;left:0;top:7px;width:16px;height:1px}.toggle:after{transform:rotate(90deg)}details[open] .toggle:after{transform:rotate(0)}details[open] summary{color:#406345}.answer{padding:0 40px 26px 0}.answer p{font-size:16px;line-height:1.85;color:#536057;margin:0}.answer a{display:inline-block;font-size:14px;font-weight:600;text-underline-offset:5px;margin-top:18px}.faq-contact{display:flex;justify-content:space-between;align-items:center;gap:48px;margin-top:88px;padding:48px;background:#ecf0e6}.faq-contact h2{font-size:36px;letter-spacing:-.03em;line-height:1.15;margin:0 0 20px}.faq-contact p{max-width:550px;font-size:16px;line-height:1.75;color:var(--muted);margin:0}.action{display:inline-flex;gap:40px;justify-content:space-between;white-space:nowrap;padding:20px 24px;background:#406345;color:#fffdf8;font-size:15px;font-weight:600;text-decoration:none;min-height:48px}a:focus-visible,summary:focus-visible{outline:3px solid #829768;outline-offset:5px}.action:hover{background:var(--ink)}.action:active{transform:translateY(1px)}
  @media(max-width:800px){.faq-page{padding:26px 22px 60px}.crumb{margin-bottom:40px}.faq-hero{margin-bottom:36px}.faq-hero>p:last-child{font-size:18px}.faq-layout{grid-template-columns:1fr;gap:36px}.topic-sidebar{position:static}.topic-sidebar nav{display:grid;grid-template-columns:1fr 1fr;column-gap:24px}.topic-sidebar nav>p{grid-column:1/-1}.topic-sidebar nav a{font-size:13px;line-height:1.45}.quotation-note{margin-top:24px;padding:20px}.quotation-note h2{font-size:17px}.faq-group{margin-bottom:42px;scroll-margin-top:90px}.faq-group h2{font-size:26px}.questions summary{font-size:17px;gap:20px}.answer{padding-right:0}.answer p{font-size:15px}.faq-contact{margin-top:56px;display:block;padding:28px 24px}.faq-contact h2{font-size:30px}.faq-contact .action{margin-top:28px}}
</style>
