---
import PageHero from './PageHero.astro';
import EditorialCard from './EditorialCard.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import CertificateGallery from './CertificateGallery.astro';
import { mediaFor, mediaListFor } from '../lib/visual-media.mjs';
import { companyCertificates, supplyChainDocuments } from '../data/certificates.mjs';
import { contentText } from '../lib/content-routes.mjs';
import { contentKeyForArchitecture, localizedEntry, routeFor, architectureLabelsFor } from '../lib/localization.mjs';
import { PRODUCT_GROUPS, mediaKeyForArchitecture } from '../lib/site-architecture.mjs';

const { source, page, language, ui, contactRoute, labels, recentPosts = [] } = Astro.props;
const { homeLabel, rangeLabel, sentLabel, nameLabel, emailLabel, companyLabel, countryLabel, phoneLabel, quantityLabel, productLabel, skuLabel, categoryFormLabel, requirementsLabel, sendLabel, preparedLabel, reviewedLabel, sourcesLabel, officialLabel } = labels;
const visualLabels = architectureLabelsFor(language);
const visibleTitle = contentText;
const media = mediaFor(mediaKeyForArchitecture(source), language);
const quality = source.route === '/quality/';
const about = source.route.startsWith('/about/');
const resources = source.kind === 'resources';
const localizedArchitecture = (route) => localizedEntry(language, contentKeyForArchitecture({ route }));
const linkedMedia = (index) => source.links[index].route === '/contact/' ? null : mediaFor(mediaKeyForArchitecture({ route: source.links[index].route }), language);
const factoryPage = localizedEntry(language, 'architecture:about/factory');
const factoryMedia = mediaListFor('architecture:about/factory', language);
const companyMedia = [mediaFor('architecture:products', language), ...factoryMedia];
const blogRoute = language === 'en' ? '/blog/' : `/${language}/blog/`;
---
{source.kind === 'contact' ? <section class="content-shell architecture-page contact-page">
  <PageHero eyebrow={ui.contactUs} title={visibleTitle(page.title)} intro={page.intro} />
  <div class="contact-layout">
    <div class="contact-support"><ResponsiveMedia media={media} eager /><div class="contact-direct"><a href="mailto:inquiry@corn-comp.com">inquiry@corn-comp.com</a><span>+86 574 8696 1222</span></div></div>
    <div class="inquiry-panel"><p id="inquiry-sent" class="inquiry-success" role="status">{sentLabel}</p><form class="corncomp-inquiry-form" action="/api/inquiry" method="post"><div class="form-grid"><label>{nameLabel}<input name="name" autocomplete="name" required></label><label>{emailLabel}<input name="email" type="email" autocomplete="email" required></label><label>{companyLabel}<input name="company" autocomplete="organization" required></label><label>{countryLabel}<input name="country" autocomplete="country-name" required></label><label>{phoneLabel}<input name="phone" autocomplete="tel"></label><label>{quantityLabel}<input name="quantity" inputmode="numeric"></label><label class="form-wide">{productLabel}<input name="productName"></label><label>{skuLabel}<input name="productSku"></label><label>{categoryFormLabel}<input name="category"></label><label class="form-wide">{requirementsLabel}<textarea name="message" rows="6" required></textarea></label></div><input type="hidden" name="sourcePath"><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button-primary" type="submit">{sendLabel}</button></form></div>
  </div>
  <script is:inline>(() => { const form = document.querySelector('.corncomp-inquiry-form'); if (!form) return; const params = new URLSearchParams(window.location.search); const values = { productName: params.get('product'), productSku: params.get('sku'), category: params.get('category'), sourcePath: params.get('source') || document.referrer || window.location.pathname }; for (const [name, value] of Object.entries(values)) if (value && form.elements[name]) form.elements[name].value = value; if (params.get('sent') === '1') document.getElementById('inquiry-sent')?.classList.add('is-visible'); })();</script>
</section> : source.kind === 'products' ? <section class="content-shell architecture-page">
  <PageHero eyebrow={rangeLabel} title={visibleTitle(page.title)} intro={page.intro} media={media} />
  <div class="architecture-grid product-group-grid">{PRODUCT_GROUPS.map((group) => {
    const item = localizedArchitecture(group.route);
    return <EditorialCard title={visibleTitle(item.title)} text={item.intro} href={item.route} media={mediaFor(mediaKeyForArchitecture(group), language)} label={ui.productGroup} />;
  })}</div><section class="buying-guidance"><div class="architecture-grid">{page.sections.map((section) => <article class="architecture-card"><h2>{section.title}</h2><p>{section.text}</p></article>)}</div><a class="button-primary" href={contactRoute}>{ui.requestQuote}</a></section>
</section> : <section class="content-shell architecture-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav>
  <PageHero eyebrow={visibleTitle(page.title)} title={visibleTitle(page.title)} intro={page.intro} media={quality ? null : media} />
  {source.kind === 'guide' && <p class="guide-meta">{preparedLabel}{' '}{page.preparedBy} <span aria-hidden="true">·</span> {reviewedLabel}{' '}{page.reviewedLabel}</p>}
  {quality && <>
    <CertificateGallery company={companyCertificates(language)} language={language} />
    <section class="quality-factory-evidence"><div class="evidence-split"><ResponsiveMedia media={factoryMedia[0]} /><div><p class="eyebrow">{visualLabels.factoryEvidence}</p><h2>{factoryPage.title}</h2><p>{factoryPage.intro}</p><a class="text-link" href={factoryPage.route}>{factoryPage.title}</a></div></div></section>
    <CertificateGallery supplyChain={supplyChainDocuments(language)} language={language} />
  </>}
  {resources ? <>
    <section class="featured-guide"><p class="eyebrow">{visualLabels.featuredGuide}</p><EditorialCard title={visibleTitle(page.links[0].title)} text={page.links[0].text} href={page.links[0].route} media={linkedMedia(0)} /></section>
    <section class="remaining-guides"><h2>{visualLabels.remainingGuides}</h2><div class="architecture-grid editorial-card-grid">{page.links.slice(1).map((item, index) => <EditorialCard title={visibleTitle(item.title)} text={item.text} href={item.route} media={linkedMedia(index + 1)} />)}</div></section>
    <section class="latest-articles"><div class="section-heading"><h2>{visualLabels.latestArticles}</h2><a class="text-link" href={blogRoute}>{visualLabels.allArticles}</a></div><div class="architecture-grid">{recentPosts.map(({ source: post, entry }) => <EditorialCard title={visibleTitle(entry.title)} text={entry.description} href={entry.route} media={mediaFor(post.contentKey, language)} />)}</div></section>
  </> : !about && page.links.length > 0 && <div class="architecture-grid linked-page-grid editorial-card-grid">{page.links.map((item, index) => <EditorialCard title={visibleTitle(item.title)} text={item.text} href={item.route} media={linkedMedia(index)} />)}</div>}
  {about ? <div class="company-evidence">{page.sections.map((section, index) => <section class:list={['evidence-split', { 'evidence-split--reverse': index % 2 === 1 }]}><ResponsiveMedia media={source.route === '/about/' ? companyMedia[index % companyMedia.length] : factoryMedia[index % factoryMedia.length]} /><div><h2>{section.title}</h2><p>{section.text}</p></div></section>)}</div> : <div class:list={['architecture-grid', 'content-section-grid', { 'has-links': page.links.length > 0 }]}>{page.sections.map((section) => <article class="architecture-card"><h2>{section.title}</h2><p>{section.text}</p></article>)}</div>}
  {about && page.links.length > 0 && <div class="architecture-grid linked-page-grid editorial-card-grid">{page.links.map((item, index) => <EditorialCard title={visibleTitle(item.title)} text={item.text} href={item.route} media={linkedMedia(index)} />)}</div>}
  {page.table && <section class="guide-table-section" aria-label={page.table.caption}><div class="guide-table-scroll"><table class="guide-table"><caption>{page.table.caption}</caption><thead><tr>{page.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{page.table.rows.map((row) => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div></section>}{page.sources?.length > 0 && <section class="guide-sources"><p class="eyebrow">{sourcesLabel}</p><h2>{officialLabel}</h2><p>{page.sourceIntro}</p><ul>{page.sources.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{visibleTitle(item.title)}</a></li>)}</ul></section>}<section class="architecture-cta"><div><p class="eyebrow">{ui.requestQuote}</p><h2>{visibleTitle(page.title)}</h2><p>{page.description}</p></div><a class="button-primary" href={`${contactRoute}?source=${encodeURIComponent(page.route)}`}>{ui.requestQuote}</a></section>
</section>}
