---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import { mediaListFor } from '../lib/visual-media.mjs';
const { preview = true } = Astro.props;
const photos = mediaListFor('architecture:about/factory', 'en');
const steps = [
  ['Paper & construction', 'Choose the paper, coating and product format for the intended use. Food-contact requirements depend on the complete construction.'],
  ['Printing & preparation', 'Printing, slitting and die-cutting prepare paper for the selected format. The route differs between straws, cups and bowls.'],
  ['Forming', 'Paper is formed into the selected product. Straw manufacture and container forming use different equipment and settings.'],
  ['Finishing & packing', 'Finishing and packing follow the product specification, including individual wrapping where required.'],
];
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'Inside our manufacturing.', url: 'https://corn-comp.com/about/factory/', about: { '@id': 'https://corn-comp.com/#organization' } }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: ['Home', 'About Corncomp', 'Factory & manufacturing'].map((name,index) => ({ '@type':'ListItem',position:index+1,name,item:'https://corn-comp.com'+['/','/about/','/about/factory/'][index] })) }];
---
<BaseLayout title={preview ? 'Factory & Manufacturing | Design Preview | Corncomp' : 'Factory & Manufacturing | Corncomp'} description="Explore Corncomp’s Ningbo manufacturing base, paper converting processes and the distinction between factory production and alliance supply." pathname="/about/factory/" structuredData={schema} bodyClass="architecture-site" image={photos[0].src}>
  {preview && <div class="factory-note">DESIGN PREVIEW · 工厂页首版 · 正式站未修改</div>}
  <main class="factory-page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/about/">About Corncomp</a><span>/</span><span>Factory & manufacturing</span></nav>
    <header class="factory-hero">
      <div><p class="eyebrow">CORNCOMP / NINGBO, CHINA</p><h1>Inside our<br/><em>manufacturing.</em></h1></div>
      <div class="hero-intro"><p>Paper straws. Paper food packaging.<br/>A closer look at where they take shape.</p><a href="#facility">Explore the factory <span aria-hidden="true">↘</span></a></div>
    </header>
    <figure class="factory-panorama"><ResponsiveMedia media={photos[0]} eager/><figcaption><span>Inside the Corncomp production facility</span><span>Ningbo · Zhejiang · China</span></figcaption></figure>
    <nav class="factory-index" aria-label="Page sections"><a href="#facility">The facility ↘</a><a href="#process">Production stages ↘</a><a href="#scope">Manufacturing & supply ↘</a><a href="#quality">Quality & documentation ↘</a></nav>

    <section id="facility" class="facility">
      <div class="facility-copy"><p class="eyebrow">OUR MANUFACTURING BASE</p><h2>Built around<br/>paper converting.</h2><p>Corncomp was founded in Ningbo in 2018. Its company profiles describe a manufacturing business focused on paper straws and paper tableware, including cups and bowls.</p><p>Production brings together paper preparation, printing, forming and packing. Different products follow different routes; the equipment and material needed depend on the specification.</p><div class="facility-fact"><strong>8,000<span>m²</span></strong><p>Total company area, including the factory.</p></div><div class="facility-fact"><strong>6,800<span>m²</span></strong><p>Factory area within the company premises.</p></div></div>
      <figure><ResponsiveMedia media={photos[1]}/><figcaption>Machinery and production space inside the Corncomp workshop.</figcaption></figure>
    </section>

    <section id="process" class="process"><div class="section-intro"><p class="eyebrow">FROM PAPER TO PACKAGING</p><h2>Different products.<br/>A considered production route.</h2><p>The company profiles describe these manufacturing stages. Not every product passes through every stage.</p></div><ol>{steps.map(([title,text],index)=><li><span class="step-number">0{index+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>

    <section id="scope" class="scope"><div class="section-intro"><p class="eyebrow">CLEAR RESPONSIBILITIES</p><h2>One product range.<br/>Not one production line.</h2><p>Knowing who makes the product matters as much as choosing its shape.</p></div><div class="scope-columns"><article><span class="scope-type">CORNCOMP MANUFACTURING</span><h3>Our Ningbo operation</h3><p>The company profiles identify paper straws, cups and bowls as Corncomp’s manufacturing focus.</p><a href="/products/cups-bowls/">Explore cups & bowls ↗</a><a href="/products/foodservice-supplies/paper-straws/">Explore paper straws ↗</a></article><article><span class="scope-type">ALLIANCE SUPPLY</span><h3>A broader packaging range</h3><p>The 2023 alliance introduction separately identifies Millionpack for paper containers and Plastik / Jieyu for PLA and PP tableware. Their factory figures are not Corncomp’s own factory figures.</p><p>For a proposed order, confirm the manufacturer, production site and applicable documentation for that item.</p></article></div></section>

    <section id="quality" class="quality"><div><p class="eyebrow">QUALITY & DOCUMENTATION</p><h2>Look beyond<br/>the factory floor.</h2><p>A facility photograph shows the production environment. Certificates and test reports provide different evidence. Match their holder, site, scope and validity to the product you plan to buy.</p><a class="action" href="/quality/">Review quality & certifications <span aria-hidden="true">↗</span></a></div><div class="quality-list"><article><h3>Company & site</h3><p>Review the company-held management, packaging-site and chain-of-custody documents.</p></article><article><h3>Product & material</h3><p>Check food-contact and compostability evidence against the exact paper, coating, ink and intended use.</p></article><article><h3>Your order</h3><p>Include the item, quantity, artwork, packing, destination and required documents in your enquiry.</p></article></div></section>
    <section class="factory-close"><p class="eyebrow">START WITH YOUR PRODUCT</p><h2>Let’s discuss<br/>what you need to make.</h2><a class="action" href="/contact/?category=Manufacturing%20enquiry&source=%2Fabout%2Ffactory%2F">Discuss your project <span aria-hidden="true">↗</span></a><a class="about-link" href="/about/">About Corncomp ↗</a></section>
    <details class="source-note"><summary>About the information on this page</summary><p>Facility background and production stages are drawn from Corncomp’s 2023 and 2024 company profiles and the May 2023 alliance introduction. Historical figures are not a guarantee of current order capacity. Confirm the proposed production site, specification and timing with the team.</p></details>
  </main>
</BaseLayout>
<style>
  .factory-page{--ink:#1d3826;--muted:#697267;--line:#d4dbcf;max-width:1440px;margin:auto;padding:36px 48px 60px;color:var(--ink);text-wrap:pretty}.factory-note{text-align:center;background:#ecf0e6;padding:9px;font-size:12px;letter-spacing:.08em}.crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:14px;color:var(--muted);margin-bottom:64px}.crumb a{text-decoration:none}.factory-hero{display:grid;grid-template-columns:1.5fr 1fr;align-items:end;gap:60px;margin-bottom:40px}.eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;margin:0 0 24px}.factory-page h1{font-size:clamp(48px,6.4vw,96px);line-height:1.02;letter-spacing:-.055em;margin:0}.factory-page em{font-style:normal;color:#78846c}.hero-intro{max-width:390px;padding-bottom:6px}.hero-intro p{font-size:21px;line-height:1.6;margin:0 0 28px}.hero-intro a,.scope a,.about-link{font-weight:600;text-underline-offset:7px}.hero-intro a{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:20px}.factory-page figure{margin:0}.factory-panorama :global(img){display:block;width:100%;height:auto;aspect-ratio:2.3;object-fit:cover!important}.factory-page figcaption{font-size:12px;color:var(--muted);margin-top:12px;line-height:1.6}.factory-panorama figcaption{display:flex;justify-content:space-between}.factory-index{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:32px}.factory-index a{padding:24px 12px 24px 0;text-decoration:none;font-size:14px}.factory-page section{scroll-margin-top:110px}.facility{display:grid;grid-template-columns:1fr 1.15fr;gap:9%;padding:110px 0}.factory-page h2{font-size:clamp(32px,3.8vw,56px);line-height:1.08;letter-spacing:-.035em;margin:0 0 28px}.factory-page section p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted)}.facility :global(img){width:100%;height:auto;aspect-ratio:4/5;object-fit:cover!important}.facility-fact{margin-top:40px;border-top:1px solid var(--line);padding-top:24px;display:flex;gap:24px;align-items:center}.facility-fact strong{font-size:48px;font-weight:500;letter-spacing:-.04em;white-space:nowrap}.facility-fact strong span{font-size:22px;margin-left:6px}.facility-fact p{font-size:13px!important;max-width:160px;margin:0}.process{display:grid;grid-template-columns:1fr 1fr;gap:9%;background:#ecf0e6;padding:64px}.process ol{list-style:none;padding:0;margin:0}.process li{display:flex;gap:28px;border-top:1px solid #cad3c4;padding:23px 0}.step-number{font-size:13px;color:var(--muted);padding-top:5px}.factory-page h3{font-size:23px;line-height:1.25;margin:0 0 12px;letter-spacing:-.02em}.process li p{font-size:15px!important;margin:0}.scope{padding:110px 0}.scope .section-intro{max-width:700px}.scope-columns{display:grid;grid-template-columns:1fr 1fr;gap:7%;margin-top:44px}.scope-columns article{border-top:1px solid var(--ink);padding-top:22px}.scope-type{display:block;font-size:11px;letter-spacing:.13em;color:var(--muted);margin-bottom:28px}.scope-columns h3{font-size:30px}.scope a{display:block;font-size:15px;margin-top:18px}.quality{background:var(--ink);color:#fffdf6;padding:64px;display:grid;grid-template-columns:1.1fr 1fr;gap:10%}.quality p:not(.eyebrow){color:#c5cfbf!important}.quality-list article{border-top:1px solid #65765e;padding-top:22px;margin-bottom:28px}.quality-list p{font-size:15px!important}.action{display:inline-flex;justify-content:space-between;gap:40px;padding:20px 24px;background:#406345;color:white;text-decoration:none;font-size:15px;font-weight:600;margin-top:20px}.quality .action{background:#e5ebdb;color:var(--ink)}.factory-close{padding:100px 0 70px}.factory-close h2{font-size:clamp(38px,5vw,72px)}.about-link{margin-left:32px;font-size:15px}.source-note{border-top:1px solid var(--line);padding-top:20px;color:var(--muted);font-size:12px;line-height:1.8}.source-note summary{cursor:pointer}.source-note p{max-width:850px}a:hover{text-decoration:underline;text-underline-offset:5px}a:focus-visible,summary:focus-visible{outline:3px solid #829768;outline-offset:5px}
  @media(max-width:800px){.factory-page{padding:26px 22px 40px}.crumb{margin-bottom:40px}.factory-hero,.facility,.process,.quality{grid-template-columns:1fr;gap:32px}.factory-hero{margin-bottom:28px}.hero-intro{max-width:none}.hero-intro p{font-size:18px}.factory-panorama :global(img){aspect-ratio:4/3}.factory-panorama figcaption{display:block}.factory-panorama figcaption span{display:block}.factory-index{grid-template-columns:1fr 1fr}.factory-index a{padding:18px 6px;font-size:12px}.facility,.scope{padding:64px 0}.facility :global(img){aspect-ratio:4/3}.process,.quality{padding:32px 24px}.scope-columns{grid-template-columns:1fr;gap:38px}.factory-page h1{font-size:clamp(42px,9vw,70px)}.factory-close{padding:64px 0 48px}.about-link{display:block;margin:28px 0 0}.facility-fact strong{font-size:42px}}
</style>
