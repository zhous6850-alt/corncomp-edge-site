---
import { navigationFor } from '../lib/site-config.mjs';
import { localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';
const { language = 'en' } = Astro.props;
const nav = navigationFor(language);
const ui = uiFor(language);
const footerLinks = [
  [nav.home[0], 'home'],
  [nav.product[0], 'architecture:products'],
  [nav.custom?.[0], 'architecture:custom-packaging'],
  [nav.applications?.[0], 'architecture:applications'],
  [nav.certifications?.[0], 'architecture:quality'],
  [nav.resources?.[0], 'architecture:resources'],
  [nav.about[0], 'architecture:about'],
  [ui.requestQuote, 'architecture:contact'],
].map(([label, contentKey]) => {
  const entry = localizedEntry(language, contentKey);
  return { label: label || entry.title, route: entry.route };
});
---
<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/media/corncomp-logo.png" width="111" height="104" alt="Corncomp">
      <div class="social-links" aria-label={ui.socialMediaLabel}>
        <a href="https://www.facebook.com/profile.php?id=61592477933421" target="_blank" rel="noopener">Facebook</a>
        <a href="https://www.instagram.com/zxh_0927" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.linkedin.com/in/sam-zhou-431ab9424/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://wa.me/6581603123" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
    <div class="footer-address">
      <strong>{ui.addressHeading}</strong>
      <p>No.2 Building, No.3 Wanquanhe Road, Xiapu Street,<br>Beilun District, Ningbo City, Zhejiang Province, China</p>
      <a href="tel:008657486961222">Tel: 0086-574-86961222</a>
      <a href="https://wa.me/6581603123">WhatsApp: +65 8160 3123</a>
      <a href="https://wa.me/8613806632002">WhatsApp: +86 138 0663 2002</a>
      <a href="mailto:inquiry@corn-comp.com">inquiry@corn-comp.com</a>
    </div>
    <nav aria-label={ui.footerNavigationLabel}>
      {footerLinks.map(({ label, route }) => <a href={route}>{label}</a>)}
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>{ui.copyrightLabel}</span>
    <button type="button" class="analytics-settings" data-analytics-settings>{ui.analyticsSettings}</button>
  </div>
</footer>
<a class="floating-whatsapp" href="https://wa.me/6581603123?text=Hello%20I%20would%20like%20to%20inquire%20about%20paper%20packaging%20products" target="_blank" rel="noopener" aria-label="WhatsApp">WhatsApp</a>
<a class="floating-contact" href={routeFor(language, 'architecture:contact')}>{ui.contactUs}</a>

<style>
  footer { padding: 56px 0; background: var(--corncomp-deep-green); color: #fff; }
  .footer-inner { display: grid; grid-template-columns: .8fr 1.4fr .8fr; align-items: start; gap: 50px; }
  .footer-brand img { width: 90px; height: 84px; object-fit: contain; filter: brightness(0) invert(1); }
  strong { font-size: 1.1rem; letter-spacing: .01em; }
  p { max-width: 440px; margin: 10px 0 0; color: rgba(255, 255, 255, .7); }
  .social-links { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: 22px; }
  .footer-address { display: grid; gap: 8px; }
  .footer-address p { margin: 8px 0; line-height: 1.6; }
  nav { display: flex; flex-direction: column; gap: 12px; font-size: .82rem; font-weight: 700; }
  a { color: rgba(255, 255, 255, .84); text-decoration: none; }
  a:hover, a:focus-visible { color: white; text-decoration: underline; text-underline-offset: 5px; }
  .footer-bottom { margin-top: 42px; padding-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-top: 1px solid rgba(255,255,255,.2); color: rgba(255,255,255,.72); font-size: .8rem; }
  .analytics-settings { padding: 0; border: 0; background: transparent; color: rgba(255,255,255,.84); cursor: pointer; font-size: inherit; text-decoration: underline; text-underline-offset: 4px; }
  .analytics-settings:hover, .analytics-settings:focus-visible { color: #fff; }
  .floating-whatsapp, .floating-contact { position: fixed; right: 20px; z-index: 40; padding: 12px 18px; border-radius: 999px; color: #fff; font-size: .82rem; font-weight: 800; text-decoration: none; box-shadow: 0 5px 18px rgba(18,56,35,.22); }
  .floating-whatsapp { bottom: 76px; background: #168942; }
  .floating-contact { bottom: 20px; background: var(--corncomp-green); }
  @media (max-width: 800px) { footer { padding: 42px 0; } .footer-inner { grid-template-columns: 1fr; gap: 34px; } nav { flex-flow: row wrap; } }
  @media (max-width: 600px) { .footer-bottom { align-items: flex-start; flex-direction: column; } .floating-whatsapp, .floating-contact { right: 12px; padding: 11px 14px; font-size: .74rem; } }
</style>
