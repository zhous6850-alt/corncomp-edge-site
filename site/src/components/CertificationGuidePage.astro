---
const { preview = true } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from '../components/ResponsiveMedia.astro';
import { ARCHITECTURE_PAGES } from '../lib/site-architecture.mjs';
import { companyCertificates } from '../data/certificates.mjs';
const source = ARCHITECTURE_PAGES.find(page=>page.route==='/resources/guides/food-packaging-certifications/');
const example = companyCertificates().find(record=>record.key==='iso-9001');
const categories = [
  ['Management & site certification', 'ISO 9001 / BRCGS', 'Read the certified system, site and activities.', 'A certificate does not automatically establish every claim for every SKU.'],
  ['Chain of Custody', 'FSC', 'Check the certified product groups and supporting sales documents.', 'The certificate alone does not confirm the claim on an individual order.'],
  ['Product compostability', 'BPI', 'Match the listed product and construction to the proposed item.', 'Coverage for one construction does not extend to all packaging.'],
  ['Food-contact testing', 'Applicable test reports', 'Match the tested material, coating, ink and intended use.', 'A report for a different construction may not apply to your product.'],
];
const fields = [
  ['Holder & site', example.holder, source.sections[0].text],
  ['Certificate number', example.certificateNumber, 'Use the number and holder together when checking the issuing body’s records.'],
  ['Scope', example.scope, 'Match the covered activities to the supplier and production relevant to the order.'],
  ['Document expiry', example.validUntil, 'This is the date stated on the document. Check current status with the issuer.'],
];
const enquiry='/contact/?'+new URLSearchParams({category:'Product certification documents',source:source.route});
const headline='Read the scope. Match the product.';
const schema=[
  {'@context':'https://schema.org','@type':'Article',headline,description:source.description,url:'https://corn-comp.com'+source.route,author:{'@id':'https://corn-comp.com/#organization'},publisher:{'@id':'https://corn-comp.com/#organization'}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Resources',item:'https://corn-comp.com/resources/'},{'@type':'ListItem',position:3,name:'Food packaging certifications guide',item:'https://corn-comp.com'+source.route}]},
];
---
<BaseLayout title={preview ? 'Food Packaging Certifications Guide - Design Preview | Corncomp' : 'Food Packaging Certifications Guide | Corncomp'} description={source.description} pathname={source.route} bodyClass="architecture-site" structuredData={schema} image={example.image.src}>
{preview && <p class="preview-note">DESIGN PREVIEW · 认证指南 · 正式站未修改</p>}
<article class="cert-guide">
  <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>Certification guide</span></nav>
  <header class="guide-heading"><p class="eyebrow">FOOD PACKAGING CERTIFICATIONS GUIDE</p><h1>Read the scope.<br/><span>Match the product.</span></h1><p>{source.intro}</p><div class="byline">Prepared by Corncomp<span>Buyer reference guide</span></div></header>
  <div class="reading-layout">
    <aside class="contents"><nav aria-label="On this page"><p>IN THIS GUIDE</p><a href="#document-types">What each document covers</a><a href="#read-certificate">Read a real certificate</a><a href="#verify">Check the record and the item</a><a href="#checklist">Your document checklist</a><a href="#official">Official resources</a></nav><a class="quality-link" href="/quality/">View Corncomp certificates ↗</a></aside>
    <div class="guide-body">
      <section id="document-types"><h2>Different documents.<br/>Different evidence.</h2><p>{source.sections[2].text}</p><div class="document-types">{categories.map(([title,label,check,limit])=><article class="document-type"><div><p class="type-label">{label}</p><h3>{title}</h3></div><div><p>{check}</p><p class="limit">{limit}</p></div></article>)}</div></section>
      <section id="read-certificate"><h2>Read beyond the logo.</h2><p>Use this Corncomp-held ISO 9001 certificate as a reading example. The holder, number, scope and date answer different questions.</p><div class="certificate-reading"><figure><button class="certificate-trigger" type="button" aria-haspopup="dialog" aria-controls="document-viewer" aria-label="Enlarge the ISO 9001 certificate"><ResponsiveMedia media={example.image}/><span>Enlarge certificate <b aria-hidden="true">↗</b></span></button><figcaption>Original certificate image. An example of a management-system certificate, not certification of every product.</figcaption></figure><dl>{fields.map(([label,value,explanation])=><div><dt>{label}</dt><dd><strong>{value}</strong><p>{explanation}</p></dd></div>)}</dl></div></section>
      <section id="verify"><h2>Check the record.<br/>Then check your item.</h2><div class="verification-steps"><article><h3>Find the official record</h3><p>{source.sections[1].text}</p><p>Use the issuer’s directory where available. Compare the record with the supplied document.</p></article><article><h3>Match the supplier and scope</h3><p>{source.sections[0].text}</p><p>Read the scope statement and any annexes, including product or material restrictions.</p></article><article><h3>Confirm the exact construction</h3><p>{source.sections[3].text}</p><p>A logo on a catalogue page is not enough to establish that match.</p></article></div></section>
      <section id="checklist"><h2>What to ask your supplier.</h2><p>Use these questions when reviewing the documents for a proposed order.</p><div class="table-scroll" role="region" tabindex="0" aria-label={source.table.caption}><table><caption>{source.table.caption}</caption><thead><tr>{source.table.headers.map(header=><th scope="col">{header}</th>)}</tr></thead><tbody>{source.table.rows.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div></section>
      <section id="official"><h2>Check the source.</h2><p>{source.sourceIntro}</p><div class="official-links">{source.sources.map((item,index)=><a href={item.url} target="_blank" rel="noopener"><span>{item.title}<small>{index<3?'Certificate or product directory':'Food-contact requirements reference'}</small></span><b aria-hidden="true">↗</b></a>)}</div><p class="reference-note">Directory records and requirements can change. Verify current status and applicability for the selected product and market.</p></section>
      <aside class="next-step"><h2>Review Corncomp’s documents.</h2><p>Browse the available certificates, or send a specific item and destination market so we can review the relevant documentation.</p><div><a class="action" href="/quality/">Quality & certifications ↗</a><a class="text-link" href={enquiry}>Ask about a specific product ↗</a></div></aside>
    </div>
  </div>
</article>
<dialog id="document-viewer" aria-labelledby="document-title"><header><h2 id="document-title">ISO 9001:2015</h2><button type="button" data-close>Close</button></header><div class="document-image"><img src={example.image.src} width={example.image.width} height={example.image.height} alt={example.image.alt} loading="lazy"/></div><footer>Original certificate image. Scroll to inspect. Press Escape to close.</footer></dialog>
</BaseLayout>
<script>
  const viewer=document.querySelector<HTMLDialogElement>('#document-viewer');
  const trigger=document.querySelector<HTMLButtonElement>('.certificate-trigger');
  trigger?.addEventListener('click',()=>viewer?.showModal());
  viewer?.querySelector('[data-close]')?.addEventListener('click',()=>viewer.close());
  viewer?.addEventListener('click',event=>{if(event.target===viewer)viewer.close();});
</script>
<style>
  .cert-guide{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1280px;padding:0 48px 64px;margin:auto;color:var(--ink)}.preview-note{margin:0;background:#edf1e7;padding:8px 16px;text-align:center;color:#405e42;font-size:11px}.crumb{display:flex;flex-wrap:wrap;gap:12px;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}h1,h2,h3,p{text-wrap:pretty}a:focus-visible,button:focus-visible,.table-scroll:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:110px}
  .guide-heading{padding:24px 0 40px;border-bottom:1px solid var(--line)}.eyebrow{font-size:10px;letter-spacing:.13em;font-weight:700;margin:0 0 20px}h1{font-size:clamp(42px,4.7vw,64px);line-height:1.08;letter-spacing:-.045em;margin:0 0 26px}h1 span{color:#718466}.guide-heading>p:not(.eyebrow){font-size:18px;line-height:1.8;color:var(--muted);max-width:750px;margin:0 0 24px}.byline{display:flex;flex-wrap:wrap;gap:12px 28px;font-size:11px;color:var(--muted)}
  .reading-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:64px;padding-top:40px}.contents{position:sticky;top:120px;align-self:start}.contents nav{display:flex;flex-direction:column}.contents nav>p{font-size:10px;letter-spacing:.12em;margin:0 0 16px}.contents nav a{font-size:13px;line-height:1.5;color:var(--muted);text-decoration:none;padding:10px 0}.contents nav a:hover{text-decoration:underline;text-underline-offset:4px;color:var(--ink)}.quality-link{display:inline-block;margin-top:24px;font-size:12px;line-height:1.7;text-underline-offset:5px;min-height:44px}
  .guide-body{min-width:0}.guide-body section{margin-bottom:52px}.guide-body h2{font-size:34px;line-height:1.15;letter-spacing:-.03em;margin:0 0 22px}.guide-body p{font-size:16px;line-height:1.85;color:var(--muted);margin:0 0 24px}.document-types{border-top:1px solid var(--line)}.document-type{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px;padding:24px 0;border-bottom:1px solid var(--line)}.document-type h3{font-size:22px;line-height:1.25;letter-spacing:-.02em;margin:0}.document-type .type-label{font-size:10px;color:#526c48;margin:0 0 10px}.document-type p{font-size:14px;margin:0 0 12px}.document-type .limit{font-size:12px;margin:0;color:#78816d}
  .certificate-reading{display:grid;grid-template-columns:.85fr 1.15fr;gap:32px;background:#edf1e7;padding:28px}.certificate-reading figure{margin:0;min-width:0}.certificate-trigger{display:block;width:100%;border:0;padding:12px;background:#fff;color:var(--ink);cursor:zoom-in}.certificate-trigger :global(img){display:block;width:100%;height:270px;object-fit:contain}.certificate-trigger>span{display:flex;justify-content:space-between;gap:12px;font-size:11px;padding-top:14px}.certificate-trigger b{font-weight:400}.certificate-trigger:hover{outline:1px solid #718466}.certificate-reading figcaption{font-size:10px;line-height:1.8;color:var(--muted);margin-top:14px}.certificate-reading dl{margin:0}.certificate-reading dl>div{margin-bottom:18px}.certificate-reading dl>div:last-child{margin:0}.certificate-reading dt{font-size:10px;color:#526c48;margin-bottom:6px}.certificate-reading dd{margin:0}.certificate-reading strong{font-size:13px;line-height:1.7;font-weight:600;overflow-wrap:anywhere}.certificate-reading dd p{font-size:12px;line-height:1.7;margin:7px 0 0}
  .verification-steps{border-left:1px solid #c2ceba;padding-left:28px}.verification-steps article{padding-bottom:24px}.verification-steps article:last-child{padding:0}.verification-steps h3{font-size:22px;letter-spacing:-.02em;margin:0 0 12px}.verification-steps p{font-size:14px;margin:0 0 12px}
  .table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:560px;font-size:13px;line-height:1.8;text-align:left}caption{text-align:left;color:var(--muted);font-size:11px;padding-bottom:14px}th,td{padding:18px 14px;vertical-align:top;border-bottom:1px solid var(--line)}thead{background:#edf1e7}thead th{font-size:11px}tbody th{font-weight:600;width:24%}td{color:var(--muted)}
  .official-links{border-top:1px solid var(--line)}.official-links a{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px 0;border-bottom:1px solid var(--line);font-size:14px;text-decoration:none;line-height:1.6}.official-links small{display:block;font-size:10px;color:var(--muted);margin-top:5px}.official-links b{font-weight:400;font-size:22px}.official-links a:hover>span{text-decoration:underline;text-underline-offset:4px}.guide-body .reference-note{font-size:11px;margin-top:18px;line-height:1.8}.next-step{padding:30px;background:#e8ede2}.next-step>div{display:flex;align-items:center;flex-wrap:wrap;gap:18px 24px}.action{display:inline-block;padding:16px 20px;border-radius:3px;background:#3d6145;color:#f3f1dd;font-size:13px;font-weight:600;text-decoration:none}.action:hover{background:#1c3927}.text-link{font-size:13px;text-underline-offset:5px}
  dialog{width:min(860px,calc(100vw - 32px));max-height:94dvh;border:1px solid #d4ddcf;border-radius:3px;padding:0;background:#fffef8;color:#1c3927}dialog::backdrop{background:rgb(14 30 20 / .76)}dialog header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px 24px}dialog h2{font-size:22px;letter-spacing:-.02em;margin:0}dialog button{padding:12px 18px;min-height:44px;font:inherit;font-size:12px;background:#edf1e7;color:#1c3927;border:1px solid #cbd5c3;cursor:pointer}.document-image{max-height:72dvh;overflow:auto;padding:20px;background:#e8e9e1}.document-image img{display:block;width:100%;height:auto}dialog footer{padding:14px 24px;font-size:11px;line-height:1.7;color:#657064}
  @media(max-width:1000px){.cert-guide{padding-inline:28px}.reading-layout{grid-template-columns:180px minmax(0,1fr);gap:32px}.certificate-reading{gap:22px;padding:22px}}
  @media(max-width:760px){.cert-guide{padding:0 20px 36px}.crumb{font-size:12px;padding:22px 0}.guide-heading{padding:16px 0 28px}h1{font-size:42px}.guide-heading>p:not(.eyebrow){font-size:16px}.reading-layout{grid-template-columns:1fr;gap:32px;padding-top:26px}.contents{position:static;background:#edf1e7;padding:24px}.contents nav a{padding:8px 0}.quality-link{margin-top:14px;min-height:30px}.guide-body h2{font-size:30px}.guide-body p{font-size:15px}.guide-body section{margin-bottom:36px}.document-type{grid-template-columns:1fr;gap:16px;padding:22px 0}.document-type p{font-size:14px}.certificate-reading{grid-template-columns:1fr;gap:26px;padding:24px}.certificate-trigger :global(img){height:300px}.certificate-reading dd p{font-size:13px}.certificate-reading strong{font-size:14px}.verification-steps{padding-left:20px}.verification-steps p{font-size:14px}.next-step{padding:24px}dialog header{padding:16px}dialog h2{font-size:20px}.document-image{padding:12px}}
</style>
