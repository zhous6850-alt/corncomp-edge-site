---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import { mediaFor, mediaListFor } from '../lib/visual-media.mjs';
const { preview = true } = Astro.props;
const showroom = mediaFor('architecture:products', 'en');
const factory = mediaListFor('architecture:about/factory', 'en')[0];
const families = [
  ['Cups & bowls', 'Paper cups and bowls, with sizes and matching lid options listed by product.', '/products/cups-bowls/'],
  ['Food boxes & containers', 'Trays, meal boxes and takeaway formats for different foods and serving needs.', '/products/food-boxes-containers/'],
  ['Foodservice supplies', 'Paper straws, cutlery, plates and bags to complete a foodservice range.', '/products/foodservice-supplies/'],
  ['Bagasse tableware', 'Plates, bowls, trays and clamshells in moulded fibre formats.', '/products/bagasse/'],
];
const schema = [{ '@context':'https://schema.org','@type':'AboutPage',name:'Paper packaging. Made with care.',url:'https://corn-comp.com/about/',about:{'@id':'https://corn-comp.com/#organization'} },{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'About Corncomp',item:'https://corn-comp.com/about/'}]}];
---
<BaseLayout title={preview ? 'About Corncomp | Design Preview' : 'About Corncomp | Paper Food Packaging Manufacturer'} description="Meet Corncomp, a Ningbo-based manufacturer and supplier of paper straws, paper tableware and foodservice packaging, founded in 2018." pathname="/about/" bodyClass="architecture-site" structuredData={schema} image={showroom.src}>
  {preview && <div class="preview-note">DESIGN PREVIEW · About 公司介绍 · 正式站未修改</div>}
  <main class="about-page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>About Corncomp</span></nav>
    <header class="about-hero"><div><p class="eyebrow">NINGBO CORNCOMP TECH CO., LTD.</p><h1>Paper packaging.<br/><span>Made with care.</span></h1></div><div class="hero-copy"><p>We manufacture paper straws and paper tableware in Ningbo, China, and supply a wider foodservice packaging range through our alliance.</p><a href="#company">Get to know Corncomp <span aria-hidden="true">↘</span></a></div></header>
    <figure class="showroom"><ResponsiveMedia media={showroom} eager/><figcaption><span>A selection of products in the Corncomp showroom.</span><span>Ningbo, China</span></figcaption></figure>

    <section id="company" class="company-story"><p class="eyebrow">ABOUT CORNCOMP</p><div><h2>A manufacturing business<br/>with foodservice at its centre.</h2><div class="story-columns"><p>Founded in 2018, Ningbo Corncomp Tech Co., Ltd. develops and manufactures paper straws and paper tableware. Our work covers paper preparation, printing, forming and packing, with different production routes for different products.</p><p>Alongside our Ningbo operation, we work with alliance manufacturers to supply other food containers and tableware. This gives buyers access to a broader range while keeping the production site and documentation specific to each item.</p></div></div></section>
    <dl class="company-facts"><div><dt>Founded in Ningbo</dt><dd>2018</dd></div><div><dt>Total company area</dt><dd>8,000<span>m²</span></dd></div><div><dt>Factory area</dt><dd>6,800<span>m²</span></dd></div></dl>

    <section class="manufacturing"><figure><ResponsiveMedia media={factory}/><figcaption>Inside our Ningbo production facility.</figcaption></figure><div><p class="eyebrow">OUR MANUFACTURING BASE</p><h2>See where<br/>the work happens.</h2><p>Our factory occupies 6,800 m² within company premises totalling 8,000 m². Paper straws, cups and bowls are part of our manufacturing focus.</p><p>Take a closer look at the workshop, the production stages and how our own manufacturing differs from alliance supply.</p><a class="action" href={preview ? '/design-preview/factory/' : '/about/factory/'}>Inside our factory <span aria-hidden="true">↗</span></a></div></section>

    <section id="products" class="products"><div class="section-lead"><h2>What we make.<br/>What we supply.</h2><p>Explore the catalogue by product family. Materials, coatings, sizes and document requirements are reviewed for the selected item.</p></div><div class="product-list">{families.map(([title,text,href])=><a href={href}><h3>{title}</h3><p>{text}</p><span aria-hidden="true">↗</span></a>)}</div></section>

    <section class="export"><div><p class="eyebrow">WORKING ACROSS MARKETS</p><h2>Based in Ningbo.<br/>Supplying overseas.</h2><p>Our company profiles document exports to the United States, Europe, Canada, Australia and Japan.</p><p>For wholesale and private-label enquiries, we review the product together with artwork, packing, destination and document requirements. The final specification determines what can be supplied.</p><a href="/custom-packaging/">Explore custom packaging ↗</a></div><div class="brief"><h3>Tell us about your order</h3><dl><div><dt>Product</dt><dd>Format, size, material and intended use</dd></div><div><dt>Branding</dt><dd>Artwork, print coverage and colours</dd></div><div><dt>Supply</dt><dd>Quantity, packing, destination and timing</dd></div><div><dt>Documentation</dt><dd>Required certificates and test reports</dd></div></dl></div></section>

    <section class="principles"><div><p class="eyebrow">HOW WE WORK</p><h2>Care starts<br/>with the details.</h2><p>Our company materials express a simple aim: to make disposable tableware responsibly. That means discussing the actual product, its use and the evidence behind its claims.</p></div><div class="principle-list"><article><h3>Specify the product clearly</h3><p>Agree the construction, dimensions, print and packing before production.</p></article><article><h3>Match the evidence to the item</h3><p>Company certificates, material documents and product tests cover different things. Check the applicable scope.</p><a href="/quality/">Quality & certifications ↗</a></article><article><h3>Be precise about environmental claims</h3><p>Paper-based, recyclable and compostable are different descriptions. Suitability depends on the construction and local disposal options.</p><a href="/resources/guides/food-packaging-certifications/">Read the certification guide ↗</a></article></div></section>
    <section class="closing"><p class="eyebrow">LET’S TALK PACKAGING</p><h2>What are you<br/>planning to serve?</h2><div><a class="action" href="/contact/?source=%2Fabout%2F">Discuss your project <span aria-hidden="true">↗</span></a><a class="secondary" href="/products/">Browse our products ↗</a></div></section>
  </main>
</BaseLayout>
<style>
  .about-page{--ink:#1d3826;--muted:#697267;--line:#d4dbcf;max-width:1440px;margin:auto;padding:36px 48px 70px;color:var(--ink);text-wrap:pretty}.preview-note{background:#ecf0e6;text-align:center;font-size:12px;padding:9px;letter-spacing:.08em}.crumb{display:flex;gap:12px;font-size:14px;color:var(--muted);margin-bottom:64px}.crumb a{text-decoration:none}.about-hero{display:grid;grid-template-columns:1.5fr 1fr;align-items:end;gap:7%;margin-bottom:44px}.eyebrow{font-size:12px;letter-spacing:.15em;font-weight:700;margin:0 0 24px}.about-page h1{font-size:clamp(48px,6.5vw,94px);line-height:1.03;letter-spacing:-.05em;margin:0}.about-page h1 span{color:#78846c}.hero-copy p{font-size:20px;line-height:1.65;margin:0 0 30px}.hero-copy a{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:20px;font-size:15px}.about-page figure{margin:0}.showroom :global(img){display:block;width:100%;height:auto;aspect-ratio:2.15;object-fit:cover!important}.about-page figcaption{font-size:12px;line-height:1.6;color:var(--muted);margin-top:12px}.showroom figcaption{display:flex;justify-content:space-between}.about-page h2{font-size:clamp(34px,3.8vw,56px);line-height:1.1;letter-spacing:-.035em;margin:0 0 28px}.about-page section p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted)}.company-story{display:grid;grid-template-columns:1fr 3fr;gap:5%;padding:100px 0 40px;scroll-margin-top:110px}.company-story>.eyebrow{padding-top:12px}.story-columns{display:grid;grid-template-columns:1fr 1fr;gap:7%}.story-columns p{margin:0}.company-facts{display:grid;grid-template-columns:repeat(3,1fr);margin:0 0 100px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.company-facts>div{padding:28px 30px;border-right:1px solid var(--line)}.company-facts>div:first-child{padding-left:0}.company-facts>div:last-child{border:0}.company-facts dt{font-size:13px;color:var(--muted);margin-bottom:20px}.company-facts dd{font-size:64px;line-height:1;letter-spacing:-.04em;margin:0}.company-facts dd span{font-size:24px;margin-left:8px}.manufacturing{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:8%;margin-bottom:100px}.manufacturing :global(img){display:block;width:100%;height:auto;aspect-ratio:1.08;object-fit:cover!important}.action{display:inline-flex;justify-content:space-between;gap:50px;padding:21px 25px;background:#406345;color:white;text-decoration:none;font-weight:600;font-size:15px;margin-top:16px}.products{border-top:1px solid var(--ink);padding:60px 0 100px}.section-lead{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:start}.section-lead p{max-width:430px;margin:4px 0 0}.product-list{margin-top:28px}.product-list>a{display:grid;grid-template-columns:1fr 1.4fr 30px;gap:28px;border-bottom:1px solid var(--line);padding:28px 0;text-decoration:none;align-items:center}.about-page h3{font-size:25px;letter-spacing:-.025em;line-height:1.2;margin:0 0 14px}.product-list h3{margin:0}.product-list p{font-size:15px!important;margin:0}.product-list span{font-size:25px}.export{background:#ecf0e6;padding:64px;display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:center}.export a,.principles a,.secondary{font-size:15px;font-weight:600;text-underline-offset:6px}.brief{border-top:1px solid #9aa58f;padding-top:26px}.brief h3{font-size:28px;margin-bottom:28px}.brief dl{margin:0}.brief dl>div{display:grid;grid-template-columns:110px 1fr;gap:20px;border-bottom:1px solid #cbd4c3;padding:18px 0;font-size:14px;line-height:1.65}.brief dt{font-weight:600}.brief dd{margin:0;color:var(--muted)}.principles{display:grid;grid-template-columns:1fr 1fr;gap:12%;padding:100px 0}.principle-list article{border-top:1px solid var(--line);padding:25px 0}.principle-list article:first-child{border-top:1px solid var(--ink)}.principle-list p{font-size:15px!important;margin:0 0 18px}.closing{background:var(--ink);color:#fffdf6;padding:64px}.closing h2{font-size:clamp(40px,5vw,72px)}.closing .action{background:#e5ebdb;color:var(--ink)}.secondary{display:inline-block;margin-left:30px}a:hover{text-decoration:underline;text-underline-offset:5px}a:focus-visible{outline:3px solid #829768;outline-offset:5px}.product-list a:hover h3{color:#597349}
  @media(max-width:800px){.about-page{padding:26px 22px 40px}.crumb{margin-bottom:40px}.about-hero,.company-story,.story-columns,.manufacturing,.section-lead,.export,.principles{grid-template-columns:1fr;gap:28px}.about-page h1{font-size:clamp(42px,9vw,70px)}.hero-copy p{font-size:18px}.showroom :global(img){aspect-ratio:4/3}.showroom figcaption{display:block}.showroom figcaption span{display:block}.company-story{padding:64px 0 30px;gap:0}.company-facts{margin-bottom:64px}.company-facts>div{padding:20px 10px}.company-facts dt{font-size:11px;min-height:30px;margin-bottom:12px}.company-facts dd{font-size:clamp(26px,6.7vw,42px)}.company-facts dd span{display:block;font-size:16px;margin:8px 0 0}.manufacturing{margin-bottom:64px}.manufacturing :global(img){aspect-ratio:4/3}.products{padding:40px 0 64px}.product-list>a{grid-template-columns:1fr 24px;gap:10px;padding:24px 0}.product-list h3{font-size:23px}.product-list p{grid-column:1}.product-list span{grid-column:2;grid-row:1}.export,.closing{padding:32px 24px}.brief dl>div{grid-template-columns:95px 1fr;gap:12px}.principles{padding:64px 0}.secondary{display:block;margin:28px 0 0}}
</style>
