---
import { companyCertificates } from '../data/certificates.mjs';
import { routeFor } from '../lib/localization.mjs';
import homeImages from '../data/home-images.json';

const { language } = Astro.props;
const copy = {
  en: {
    title: 'Quality & certifications',
    intro: 'View the certificates held by Corncomp and what each one covers.',
    scopes: ['Packaging materials', 'Chain of Custody', 'Quality management', 'Printed paper straws'],
    view: 'View certificate',
    note: 'BPI covers printed paper straws up to 352 g/m². Certification scope varies by document and product.',
  },
  zh: {
    title: '品质与认证',
    intro: '查看遇米持有的四项认证，了解每份证书的适用范围。',
    scopes: ['包装材料', '产销监管链', '质量管理体系', '印刷纸吸管'],
    view: '查看证书',
    note: 'BPI 适用于最大克重 352 g/m² 的印刷纸吸管。各项认证的适用范围不同，请查看证书详情。',
  },
  fr: {
    title: 'Qualité et certifications',
    intro: 'Consultez les certificats détenus par Corncomp et leur champ d’application.',
    scopes: ['Matériaux d’emballage', 'Chaîne de contrôle', 'Management de la qualité', 'Pailles en papier imprimées'],
    view: 'Voir le certificat',
    note: 'BPI couvre les pailles en papier imprimées jusqu’à 352 g/m². Le champ de certification varie selon le document et le produit.',
  },
  es: {
    title: 'Calidad y certificaciones',
    intro: 'Consulte los certificados de Corncomp y el alcance de cada uno.',
    scopes: ['Materiales de embalaje', 'Cadena de custodia', 'Gestión de la calidad', 'Pajitas de papel impresas'],
    view: 'Ver certificado',
    note: 'BPI cubre pajitas de papel impresas de hasta 352 g/m². El alcance de la certificación varía según el documento y el producto.',
  },
  de: {
    title: 'Qualität und Zertifikate',
    intro: 'Sehen Sie die Zertifikate von Corncomp und ihren jeweiligen Geltungsbereich.',
    scopes: ['Verpackungsmaterialien', 'Produktkette', 'Qualitätsmanagement', 'Bedruckte Papierstrohhalme'],
    view: 'Zertifikat ansehen',
    note: 'BPI gilt für bedruckte Papierstrohhalme bis 352 g/m². Der Geltungsbereich hängt vom jeweiligen Zertifikat und Produkt ab.',
  },
  ar: {
    title: 'الجودة والشهادات',
    intro: 'اطّلع على الشهادات التي تحملها كورنكومب ونطاق كل منها.',
    scopes: ['مواد التعبئة والتغليف', 'سلسلة الحيازة', 'إدارة الجودة', 'ماصات ورقية مطبوعة'],
    view: 'عرض الشهادة',
    note: 'تغطي شهادة BPI الماصات الورقية المطبوعة حتى 352 g/m². ويختلف نطاق الشهادة حسب الوثيقة والمنتج.',
  },
}[language];
const standards = [
  ['brcgs-packaging', 'BRCGS'],
  ['fsc-coc', 'FSC'],
  ['iso-9001', 'ISO 9001'],
  ['bpi-straws', 'BPI'],
];
const certificates = companyCertificates(language);
const quality = routeFor(language, 'architecture:quality') + '#documents';
---
<section id="home-certifications" class="home-certifications" aria-labelledby="home-certifications-title">
  <div class="content-shell certificates-inner">
    <header class="certificates-heading">
      <h2 id="home-certifications-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </header>
    <div class="certificate-lineup">
      {standards.map(([key, mark], index) => {
        const certificate = certificates.find((certificate) => certificate.key === key);
        return <a class="home-certificate" href={quality}>
          <div class="certificate-image">
            <img {...homeImages['certificate:' + key]} width={certificate.image.width} height={certificate.image.height} sizes="(max-width: 600px) 112px, (max-width: 900px) 125px, 140px" alt={certificate.image.alt} loading="lazy" decoding="async"/>
          </div>
          <h3 dir="ltr">{mark}</h3>
          <p>{copy.scopes[index]}</p>
          <span class="certificate-action">{copy.view}<span aria-hidden="true">↗</span></span>
        </a>;
      })}
    </div>
    <p class="certificates-scope">{copy.note}</p>
  </div>
</section>
<style>
  .home-certifications{background:#e8eee3;scroll-margin-top:110px}
  .certificates-inner{padding-block:56px}
  .certificates-heading{max-width:700px;margin:0 auto 32px;text-align:center}
  .certificates-heading h2{margin:0;color:var(--corncomp-deep-green);font-size:clamp(1.9rem,3.4vw,2.8rem);line-height:1.15;letter-spacing:-.035em}
  .certificates-heading p{margin:14px 0 0;color:#4e6251;font-size:1rem;line-height:1.6;text-wrap:pretty}
  .certificate-lineup{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px}
  .home-certificate{min-width:0;text-align:center;text-decoration:none;color:var(--corncomp-deep-green)}
  .certificate-image{height:236px;display:grid;place-items:center;padding:18px;background:#f8faf5;border:1px solid #ccd8c6}
  .certificate-image img{display:block;width:100%;height:198px;object-fit:contain;filter:drop-shadow(0 3px 5px rgba(18,56,35,.12))}
  .home-certificate h3{margin:22px 0 7px;font-size:clamp(1.7rem,2.4vw,2.1rem);line-height:1.1;letter-spacing:-.035em}
  .home-certificate p{min-height:2.8em;margin:0;color:#4e6251;font-size:.95rem;line-height:1.4;text-wrap:balance}
  .certificate-action{display:inline-flex;align-items:center;gap:16px;min-height:44px;margin-top:8px;font-size:.85rem;font-weight:700}
  .certificate-action>span{font-size:18px}
  .home-certificate:hover .certificate-image{border-color:var(--corncomp-green);background:#fffdf8}
  .home-certificate:hover .certificate-action{text-decoration:underline;text-underline-offset:5px}
  .home-certificate:focus-visible{outline:3px solid var(--corncomp-green);outline-offset:7px}
  .home-certificate:active{opacity:.8}
  .certificates-scope{max-width:850px;margin:24px auto 0;color:#4e6251;text-align:center;font-size:.8rem;line-height:1.7;text-wrap:pretty}
  @media(max-width:900px){.certificate-lineup{gap:18px}.certificate-image{height:206px;padding:14px}.certificate-image img{height:176px}.home-certificate h3{font-size:1.6rem}}
  @media(max-width:600px){.certificates-inner{padding-block:40px}.certificates-heading{margin-bottom:26px}.certificate-lineup{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 16px}.certificate-image{height:184px;padding:12px}.certificate-image img{height:158px}.home-certificate h3{margin-top:16px;font-size:1.6rem}.home-certificate p{font-size:.85rem}.certificate-action{gap:9px;font-size:.78rem}.certificates-scope{margin-top:24px;text-align:start}}
</style>
