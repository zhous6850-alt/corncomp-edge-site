---
const {preview = true} = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import {englishInventory} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import mediaInventory from '../data/media.json';
const choices=[
 {slug:'bagasse-three-compartment-plate',role:'THE FOOD',title:'Serve the meal.',copy:'A compartment plate is a starting point for portions that need separate spaces. Compare it with the dishes you serve, rather than choosing by plate diameter alone.',points:[['Choose around','The size of the main portion, sides and any sauces.'],['Try in service','Fill the plate as staff would at the counter. Check portion space, handling and the time before eating.']],link:'Compare compartment plates'},
 {slug:'double-wall-kraft-paper-cup',role:'THE DRINK',title:'Plan the drinks.',copy:'Select cups around the beverage and the way it is served. A double-wall kraft cup is one format to compare for your drinks menu.',points:[['Choose around','Fill volume, serving temperature, handling and whether a lid is required.'],['Complete the cup','If a lid or accessory is needed, identify the exact item and confirm the fit. A capacity label alone is not enough.']],link:'Explore paper cups'},
 {slug:'wooden-bamboo-cutlery',role:'THE ACCESSORIES',title:'Set out the essentials.',copy:'Choose the utensils the menu actually needs. Decide whether guests pick them up separately or staff include them with each serving.',points:[['Choose around','The food, utensil type and how the set will be presented.'],['Plan the station','Agree loose or packed presentation, dispenser or counter space, and the way staff replenish stock.']],link:'View wooden cutlery'},
].map(c=>{
 const p=englishInventory().find(p=>p.type==='product'&&p.slug===c.slug),a=p.featuredMedia,size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...c,product:p,media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const enquiry='/contact/?'+new URLSearchParams({category:'Restaurant & Foodservice',source:'/applications/restaurant-packaging/'}).toString();
const schema={'@context':'https://schema.org','@type':'WebPage',name:'A place for every part of the meal.',url:'https://corn-comp.com/applications/restaurant-packaging/',about:{'@id':'https://corn-comp.com/#organization'}};
---
<BaseLayout title={preview ? 'Restaurant & Foodservice Packaging - Design Preview | Corncomp' : 'Restaurant & Foodservice Packaging | Corncomp'} description="Plan plates, cups and utensils around your menu, service counter and replenishment needs." pathname="/applications/restaurant-packaging/" bodyClass="architecture-site" structuredData={[schema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:'Restaurant & Foodservice',item:schema.url}]}]}>
 {preview && <div class="preview-note">DESIGN PREVIEW · RESTAURANT & FOODSERVICE V2 · 正式站未修改</div>}
 <div class="foodservice-page">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? "/design-preview/applications/" : "/applications/"}>Applications</a><span>/ Restaurant & Foodservice</span></nav>
 <header class="service-heading"><p class="eyebrow">RESTAURANT & FOODSERVICE / MENU TO COUNTER</p><div><h1>A place for every<br/><span>part of the meal.</span></h1><div><p>Plan the plate, cup and utensils around what you serve and how guests receive it.</p><a href="#service-range">Build your service range ↓</a></div></div></header>
 <figure class="service-scene"><img src="/media/generated/restaurant-service-scene-preview.png" width="1664" height="936" alt="Illustrative restaurant lunch setting with a compartment plate, kraft cup and wooden utensils" fetchpriority="high"/><figcaption><span>AT THE TABLE / meal · drink · utensils</span><span>AI-generated scene illustration. Product photos below show catalogue formats.</span></figcaption></figure>
 <section id="service-range" class="service-range"><div class="range-heading"><p class="eyebrow">START WITH YOUR MENU</p><h2>Choose each part<br/>for a reason.</h2><p>These are three formats to explore. Your service may need a different plate, bowl or cup, or no accessory at all.</p></div><div class="service-grid">{choices.map(c=><article class="service-choice"><a class="choice-image" href={c.product.route} aria-label={'View '+contentText(c.product.title)}><ResponsiveMedia media={c.media}/></a><div class="choice-copy"><p class="eyebrow">{c.role}</p><h3>{c.title}</h3><p>{c.copy}</p><dl>{c.points.map(([title,copy])=><div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl><a class="product-link" href={c.product.route}>{c.link} ↗</a><a class="enquire-link" href={enquiry+'&product='+encodeURIComponent(contentText(c.product.title))}>Ask about this format ↗</a></div></article>)}</div></section>
 <section id="service-check" class="service-check"><div><p class="eyebrow">A SHORT SERVICE TRIAL</p><h2>Walk through<br/>a typical serving.</h2><p>Use your food, drink and staff workflow to check the proposed range before settling on the specification.</p><a href="/products/cups-bowls/">Need bowls instead? Browse cups & bowls ↗</a></div><ol><li><span>01</span><div><h3>At the preparation point</h3><p>Fill the selected plate or bowl with the usual portion. Check food separation, serving space and handling.</p></div></li><li><span>02</span><div><h3>At the service counter</h3><p>Set out cups and utensils where guests or staff need them. Try the intended pickup sequence and any required matching components.</p></div></li><li><span>03</span><div><h3>During replenishment</h3><p>Check the space for inner packs and cartons, how stock is opened and how often each item needs replacing.</p></div></li></ol><p class="scope-note">Confirm the selected material, construction and required documents against the food and service conditions. Temperature suitability, holding performance and component fit require item-specific checks. Illustrations do not establish these properties.</p></section>
 <section class="service-close"><div><p class="eyebrow">A USEFUL PLACE TO START</p><h2>Tell us how<br/>your service works.</h2><p>Share a menu or portion photo, drinks, service format, estimated volume, packing needs and destination. We’ll help narrow down the product range.</p></div><div><a class="project-button" href={enquiry}>Plan your foodservice range ↗</a><a href="/custom-packaging/">Explore branding for your range ↗</a><a href={preview ? "/design-preview/applications/" : "/applications/"}>← All applications</a></div></section>
 </div>
</BaseLayout>
<style>
 .foodservice-page{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;color:#405e42;text-align:center;padding:8px 16px;font-size:11px}.crumb{display:flex;gap:12px;flex-wrap:wrap;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}.service-heading{padding:22px 0 36px}.service-heading>div{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.service-heading h1{font-size:clamp(44px,4.8vw,68px);line-height:1.05;letter-spacing:-.045em;margin:0}.service-heading h1 span{color:#718466}.service-heading p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted);max-width:420px;margin:0 0 22px}.service-heading a{font-size:14px;font-weight:700;text-underline-offset:5px}.service-scene{margin:0}.service-scene>img{display:block;width:100%;height:420px;object-fit:cover}.service-scene figcaption{display:flex;justify-content:space-between;gap:24px;font-size:10px;color:var(--muted);line-height:1.7;padding:13px 0;border-bottom:1px solid var(--line)}.service-range{padding:56px 0}.range-heading{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;align-items:end;margin-bottom:30px}.range-heading>.eyebrow{grid-column:1/-1}.range-heading h2,.service-check h2,.service-close h2{font-size:clamp(32px,3.2vw,44px);line-height:1.1;letter-spacing:-.035em;margin:0 0 20px}.range-heading>p:last-child{font-size:16px;line-height:1.8;color:var(--muted);max-width:460px}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.service-choice{min-width:0;border:1px solid var(--line)}.choice-image{display:block;background:#fff}.choice-image :global(img){display:block;width:100%;height:270px;object-fit:contain}.choice-copy{padding:26px}.choice-copy .eyebrow{color:#718466;font-size:9px;margin-bottom:14px}.choice-copy h3{font-size:28px;line-height:1.1;letter-spacing:-.03em;margin:0 0 18px}.choice-copy>p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);margin:0 0 22px}.choice-copy dl{margin:0 0 22px}.choice-copy dl>div{border-top:1px solid var(--line);padding:15px 0}.choice-copy dt{font-size:12px;font-weight:700;margin-bottom:8px}.choice-copy dd{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.product-link,.enquire-link{display:block;font-size:12px;text-underline-offset:5px}.product-link{font-weight:700;margin-bottom:18px}.enquire-link{color:var(--muted)}.service-check{background:#edf1e7;display:grid;grid-template-columns:.9fr 1.1fr;gap:32px 60px;padding:44px}.service-check>div>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted)}.service-check>div>a{display:inline-block;margin-top:12px;font-size:13px;text-underline-offset:5px}.service-check ol{list-style:none;padding:0;margin:0}.service-check li{display:flex;gap:22px;border-top:1px solid #cad5c3;padding:20px 0}.service-check li>span{font-size:10px;color:#7c8b72}.service-check h3{font-size:20px;letter-spacing:-.02em;margin:0 0 10px}.service-check li p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.scope-note{grid-column:1/-1;border-top:1px solid #cad5c3;padding-top:18px;font-size:12px;line-height:1.8;color:var(--muted);margin:0}.service-close{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding-top:56px}.service-close p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:550px}.service-close>div:last-child{display:flex;flex-direction:column;align-items:start;gap:22px}.service-close a{font-size:12px;text-underline-offset:5px}.project-button{display:inline-flex;min-height:52px;background:var(--ink);color:#f3f1dd;padding:17px 22px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:120px}
 @media(max-width:1000px){.foodservice-page{padding-inline:28px}.service-heading>div{gap:32px}.service-grid{gap:18px}.choice-copy{padding:20px}.choice-copy h3{font-size:25px}.choice-image :global(img){height:230px}.service-check{padding:32px;gap:30px}}
 @media(max-width:650px){.foodservice-page{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.service-heading{padding:16px 0 28px}.service-heading>div{grid-template-columns:1fr;gap:24px}.service-heading h1{font-size:44px}.service-heading p:not(.eyebrow){font-size:16px}.service-scene>img{height:270px}.service-scene figcaption{flex-direction:column;gap:7px}.service-range{padding:40px 0}.range-heading{display:block}.range-heading h2,.service-check h2,.service-close h2{font-size:33px}.service-grid{grid-template-columns:1fr;gap:24px}.choice-image :global(img){height:280px}.choice-copy{padding:24px}.choice-copy h3{font-size:28px}.service-check{grid-template-columns:1fr;padding:28px 24px;gap:24px}.service-close{grid-template-columns:1fr;gap:24px;padding-top:40px}.preview-note{font-size:10px}}
</style>
