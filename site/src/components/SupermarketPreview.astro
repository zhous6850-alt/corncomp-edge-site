---
const {preview = true} = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import {englishInventory} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import mediaInventory from '../data/media.json';
const choices=[
 {food:'Sushi & small portions',slug:'black-white-cardboard-sushi-box-pla-window',name:'Low-profile sushi boxes',why:'Keep the sushi arrangement in view with a long, shallow box and a top window.',check:'Match the box height and window to your portion and the way it sits on the shelf.'},
 {food:'Fresh salads',slug:'multi-window-salad-box',name:'Multi-window salad boxes',why:'Give shoppers a view of the salad from above and through the side windows.',check:'Choose around portion size, topping height and label placement.'},
 {food:'Prepared meals & deli',slug:'kraft-window-menu-box',name:'Hinged window meal boxes',why:'Explore a deeper hinged box for deli portions, with a top window and a paper surround for label placement.',check:'Match the depth to your filled portion and the paper area to your label.'},
].map(c=>{
 const p=englishInventory().find(p=>p.type==='product'&&p.slug===c.slug),a=p.featuredMedia,size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...c,product:p,media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const enquiry='/contact/?'+new URLSearchParams({category:'Supermarket',source:'/applications/supermarket-packaging/'}).toString();
const title='Fresh food. A clearer packaging choice.';
const schema={'@context':'https://schema.org','@type':'WebPage',name:title,url:'https://corn-comp.com/applications/supermarket-packaging/',about:{'@id':'https://corn-comp.com/#organization'}};
---
<BaseLayout title={preview ? 'Supermarket Fresh Food Packaging - Design Preview | Corncomp' : 'Supermarket Fresh Food Packaging | Corncomp'} description="Compare sushi, salad and prepared meal box formats for supermarket fresh food." pathname="/applications/supermarket-packaging/" bodyClass="architecture-site" structuredData={[schema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:'Supermarket',item:schema.url}]}]}>
 {preview && <div class="preview-note">DESIGN PREVIEW · SUPERMARKET V2 · 正式站未修改</div>}
 <div class="retail-page">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? "/design-preview/applications/" : "/applications/"}>Applications</a><span>/ Supermarket</span></nav>
 <header class="retail-heading"><div><p class="eyebrow">SUPERMARKET / DELI / GRAB & GO</p><h1>Fresh food.<br/><span>A clearer packaging choice.</span></h1></div><div><p>Start with the food on your counter.<br/>Compare formats for sushi, salads and prepared meals, with portion fit, visibility and label space in mind.</p><a href="#food-selector">Choose your food ↓</a></div></header>
 <figure class="retail-scene"><img src="/media/generated/supermarket-retail-scene-preview.png" width="1536" height="1024" alt="Illustrative supermarket fresh-food shelf with windowed paper boxes for sushi, salads and prepared meals" fetchpriority="high"/><figcaption><span>THE RETAIL SETTING / visibility · portion fit · label space</span><span>AI-generated scene illustration. Product photos below show catalogue formats.</span></figcaption></figure>
 <section id="food-selector" class="food-selector"><div class="section-heading"><p class="eyebrow">WHAT ARE YOU PACKING?</p><h2>Choose by the food you sell.</h2><p>Find your food category below, compare the box format and open the product page for sizes and item references.</p></div><nav aria-label="Choose your food">{choices.map((c,i)=><a href={'#choice-'+i}><span>0{i+1}</span><strong>{c.food}</strong><b>↓</b></a>)}</nav></section>
 <section class="choice-list" aria-label="Food to packaging choices">{choices.map((c,i)=><article id={'choice-'+i} class="retail-choice"><a class="choice-image" href={c.product.route}><ResponsiveMedia media={c.media}/></a><div class="choice-copy"><p class="eyebrow">0{i+1} / {c.food.toUpperCase()}</p><h2>{c.name}</h2><p>{c.why}</p><dl><div><dt>Format</dt><dd>{i===0?'Low profile / top-window presentation':i===1?'Multiple viewing faces / hinged format':'Deeper format / hinged lid'}</dd></div><div><dt>Choose by</dt><dd>{c.check}</dd></div></dl><div class="choice-actions"><a href={c.product.route}>Compare sizes ↗</a><a href={enquiry+'&product='+encodeURIComponent(contentText(c.product.title))}>Enquire about this box ↗</a></div></div></article>)}</section>
 <section class="retail-check"><div><p class="eyebrow">BEFORE THE SHELF</p><h2>Try it with<br/>your food and label.</h2><p>A filled sample helps you see the portion, the label and the finished pack together.</p></div><ol><li><span>01</span><div><h3>Fill it with the actual portion.</h3><p>Use your usual portion and toppings. Check how the food looks through the window and how the pack closes.</p></div></li><li><span>02</span><div><h3>Place the actual label.</h3><p>Try your label on the paper area. Keep the food visible and leave enough room for the information shoppers need.</p></div></li><li><span>03</span><div><h3>Share the retail conditions.</h3><p>Tell us how the food is filled, stored, displayed and transported, including temperature and holding time.</p></div></li></ol><p class="suitability-note">These formats are starting points for selection. Shelf life, leak resistance and storage suitability depend on the selected construction and actual food conditions; confirm them with appropriate samples, tests and product documents.</p></section>
 <section class="brief-close"><div><p class="eyebrow">LET’S FIND YOUR FORMAT</p><h2>Show us your food.<br/>Tell us how you sell it.</h2><p>Send a portion photo or dimensions, your label size, retail conditions, quantity and destination. We’ll help narrow down the box options.</p></div><div><a class="project-button" href={enquiry}>Plan your supermarket range ↗</a><a href={preview ? "/design-preview/applications/" : "/applications/"}>← Back to all applications</a></div></section>
 </div>
</BaseLayout>
<style>
 .retail-page{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;text-align:center;padding:8px 16px;font-size:11px;color:#405e42}.crumb{display:flex;gap:12px;flex-wrap:wrap;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}.retail-heading{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:end;padding:22px 0 36px}.retail-heading h1{font-size:clamp(44px,4.7vw,66px);line-height:1.06;letter-spacing:-.045em;margin:0}.retail-heading h1 span{color:#718466}.retail-heading>div>p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted)}.retail-heading a{font-size:14px;font-weight:700;text-underline-offset:5px}.retail-scene{margin:0}.retail-scene>img{display:block;width:100%;height:420px;object-fit:cover}.retail-scene figcaption{display:flex;justify-content:space-between;gap:24px;font-size:10px;color:var(--muted);line-height:1.6;padding:13px 0;border-bottom:1px solid var(--line)}.food-selector{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding:60px 0 40px}.section-heading h2,.retail-check h2,.brief-close h2{font-size:clamp(32px,3.2vw,44px);line-height:1.12;letter-spacing:-.035em;margin:0 0 20px}.section-heading>p:last-child{font-size:15px;color:var(--muted);line-height:1.8;max-width:390px}.food-selector nav a{display:flex;gap:20px;align-items:center;padding:22px 0;border-top:1px solid var(--line);text-decoration:none}.food-selector nav span{font-size:10px;color:#7c8b72}.food-selector nav strong{font-size:22px;font-weight:500;flex:1;letter-spacing:-.02em}.food-selector nav b{font-size:20px;font-weight:400}.retail-choice{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:center;padding:36px 0;border-top:1px solid var(--line);scroll-margin-top:120px}.choice-image{display:block;background:#fff}.choice-image :global(img){width:100%;height:330px;object-fit:contain;display:block}.choice-copy h2{font-size:34px;letter-spacing:-.03em;line-height:1.1;margin:0 0 18px}.choice-copy>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:560px}.choice-copy dl{margin:24px 0}.choice-copy dl>div{display:grid;grid-template-columns:130px 1fr;gap:20px;border-top:1px solid var(--line);padding:14px 0}.choice-copy dt{font-size:12px;font-weight:700}.choice-copy dd{margin:0;font-size:14px;line-height:1.7;color:var(--muted)}.choice-actions{display:flex;flex-wrap:wrap;gap:15px 26px}.choice-actions a{font-size:13px;font-weight:700;text-underline-offset:5px}.suitability-note{grid-column:1/-1;font-size:12px;line-height:1.7;color:var(--muted);margin:0;border-top:1px solid #cad5c3;padding-top:18px}.retail-check{background:#edf1e7;display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;padding:44px;margin-top:32px}.retail-check>div>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted)}.retail-check ol{list-style:none;padding:0;margin:0}.retail-check li{display:flex;gap:22px;border-top:1px solid #cad5c3;padding:20px 0}.retail-check li>span{font-size:10px;color:#7c8b72}.retail-check h3{font-size:20px;letter-spacing:-.02em;margin:0 0 10px}.retail-check li p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.brief-close{padding:56px 0 0;display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center}.brief-close p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:590px}.brief-close>div:last-child{display:flex;flex-direction:column;gap:22px;align-items:start}.brief-close a{font-size:13px;text-underline-offset:5px}.project-button{display:inline-flex;min-height:52px;background:var(--ink);color:#f3f1dd;padding:17px 22px;font-weight:700;text-decoration:none;border-radius:3px}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:120px}
 @media(max-width:900px){.retail-page{padding-inline:28px}.retail-heading{gap:30px}.retail-choice{gap:30px}.choice-copy dl>div{grid-template-columns:100px 1fr}.retail-check{gap:32px;padding:32px}}
 @media(max-width:650px){.retail-page{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.retail-heading{grid-template-columns:1fr;gap:20px;padding:16px 0 28px}.retail-heading h1{font-size:44px}.retail-heading>div>p:not(.eyebrow){font-size:16px}.retail-scene>img{height:280px}.retail-scene figcaption{flex-direction:column;gap:8px}.food-selector{grid-template-columns:1fr;gap:24px;padding:40px 0 20px}.food-selector nav strong{font-size:20px}.retail-choice{grid-template-columns:1fr;gap:25px;padding:28px 0}.choice-image :global(img){height:280px}.choice-copy h2{font-size:30px}.choice-copy dl>div{grid-template-columns:1fr;gap:7px}.retail-check{grid-template-columns:1fr;padding:28px 24px;gap:24px}.retail-check h2,.brief-close h2,.section-heading h2{font-size:33px}.brief-close{grid-template-columns:1fr;padding-top:40px;gap:22px}.preview-note{font-size:10px}}
</style>
