---
import ResponsiveMedia from './ResponsiveMedia.astro';
import { englishInventory, localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';
import { contentText } from '../lib/content-routes.mjs';
import { CATEGORY_PREVIEWS, previewSections } from '../data/category-preview.mjs';
import { cupLandingLabels } from '../data/cup-landing-labels.mjs';
import mediaInventory from '../data/media.json';
const { category, page, language } = Astro.props;
const t = cupLandingLabels(language);
const ui = uiFor(language);
const config = CATEGORY_PREVIEWS[category];
const group = localizedEntry(language, 'architecture:products/cups-bowls');
const sections = previewSections(category, englishInventory()).map((section) => ({
  ...section,
  title: language === 'en' ? section.title : section.id === 'accessories' ? t.lids : ({'single-wall':t.single,'double-wall':t.double,ripple:t.ripple}[section.id] || t.select),
  intro: language === 'en' ? section.intro : section.id === 'accessories' ? t.fit : t.sectionIntro,
}));
const quote = `${routeFor(language, 'architecture:contact')}?${new URLSearchParams({ category: page.title, source: page.route })}`;
const media = (item) => {
  const image = item.featuredMedia;
  const dimensions = mediaInventory.find((asset) => asset.id === image.id).media_details;
  return { src:image.localPath, width:dimensions.width, height:dimensions.height, alt:localizedEntry(language,item.contentKey).alt || image.alt, fit:'contain', position:'center', evidence:'product' };
};
const siblings = Object.keys(CATEGORY_PREVIEWS).filter((slug) => slug !== category).map((slug) => localizedEntry(language, `architecture:products/cups-bowls/${slug}`));
---
<div class="category-preview">
  <nav class="trail" aria-label="Breadcrumb"><a href={routeFor(language,'home')}>{t.home}</a><span>/</span><a href={routeFor(language,'architecture:products')}>{t.products}</a><span>/</span><a href={group.route}>{contentText(group.title)}</a><span>/ {contentText(page.title)}</span></nav>
  <header class="category-intro"><div><p class="eyebrow">{contentText(group.title)}</p><h1>{contentText(page.title)}</h1><p class="category-tagline">{language === 'en' ? config.subtitle : t.select}</p><p class="intro-copy">{language === 'en' ? config.intro : page.intro}</p><a class="primary-link" href={`#${sections[0].id}`}>{t.browse} <span>↓</span></a></div><aside class="range-index" aria-label={t.range}><p>{t.range}</p>{sections.map((section) => <a href={`#${section.id}`}><span>{section.title}</span><small>{section.products.length} {section.id === 'accessories' ? t.components : t.series} ↗</small></a>)}<a href="#ordering"><span>{t.ordering}</span><small>↗</small></a></aside></header>
  <nav class="category-tabs" aria-label={t.range}>{sections.map((section) => <a href={`#${section.id}`}>{section.title}<sup>{section.products.length}</sup></a>)}<a href={quote}>{ui.requestQuote} ↗</a></nav>
  {sections.map((section,index) => <section id={section.id} class:list={['product-section',{accessories:section.id==='accessories'}]}><div class="section-heading"><div><p class="eyebrow">{section.id==='accessories' ? t.complete : t.select}</p><h2>{section.title}</h2></div><p>{section.intro}</p></div><div class:list={['series-grid',{'two-series':section.products.length===2,'one-series':section.products.length===1}]}>{section.products.map((item) => <article class="series-card"><a class="series-image" href={routeFor(language,item.contentKey)}><ResponsiveMedia media={media(item)} eager={index===0} /></a><div class="series-info"><h3><a href={routeFor(language,item.contentKey)}>{contentText(localizedEntry(language,item.contentKey).title)}</a></h3><a class="details-link" href={routeFor(language,item.contentKey)}>{t.details}<span>↗</span></a></div></article>)}</div></section>)}
  <section id="ordering" class="ordering"><div class="ordering-lead"><p class="eyebrow">{t.ordering}</p><h2>{t.orderTitle}</h2><p>{t.orderIntro}</p><a href={quote}>{ui.requestQuote}<span>↗</span></a></div><div class="ordering-steps">{[1,2,3].map((n) => <article><span>0{n}</span><div><h3>{t[`step${n}`]}</h3><p>{t[`step${n}Text`]}</p></div></article>)}<details><summary>{t.confirm}</summary><p>{t.terms}</p></details></div></section>
  <nav class="sibling-links" aria-label={t.more}><span>{t.more}</span>{siblings.map((sibling) => <a href={sibling.route}>{contentText(sibling.title)} ↗</a>)}</nav>
</div>
<style>
  .category-preview{--forest:#1c3927;--muted:#617065;--line:#dce3da;max-width:1320px;margin:auto;padding:0 36px 64px;color:var(--forest)}.preview-note{background:#e9efdf;color:#35503b;text-align:center;font-size:12px;letter-spacing:.06em;padding:8px 16px}.trail{display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted);padding:26px 0}.trail a{text-decoration:none}
  .category-intro{display:grid;grid-template-columns:1.5fr 1fr;gap:72px;padding:24px 0 40px;align-items:center}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;margin:0 0 14px}.category-intro h1{font-size:clamp(38px,4.4vw,62px);line-height:1.05;letter-spacing:-.04em;margin:0}.category-tagline{display:block;font-size:clamp(26px,2.7vw,38px);font-weight:700;letter-spacing:-.03em;margin-bottom:0;line-height:1.2;color:#587253;margin-top:12px}.intro-copy{font-size:17px;line-height:1.65;max-width:570px;color:var(--muted);margin:22px 0}.primary-link{display:inline-flex;gap:36px;padding:14px 20px;background:var(--forest);color:#fffdf8;text-decoration:none;font-weight:700;font-size:15px}
  .range-index{border-top:1px solid var(--forest)}.range-index>p{font-size:11px;letter-spacing:.14em;margin:18px 0 4px;color:var(--muted)}.range-index>a{display:flex;gap:20px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:18px 0;text-decoration:none;font-size:18px}.range-index small{font-size:12px;color:var(--muted);white-space:nowrap}.category-tabs{display:flex;flex-wrap:wrap;gap:28px;align-items:center;border-block:1px solid var(--line);padding:19px 0;font-size:14px;font-weight:700}.category-tabs a{text-decoration:none}.category-tabs a:last-child{margin-inline-start:auto}.category-tabs sup{color:#75866e;font-size:10px;margin-left:6px}
  .product-section{padding:40px 0 10px;scroll-margin-top:130px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:23px}.section-heading h2{font-size:clamp(28px,3vw,36px);line-height:1.12;letter-spacing:-.03em;margin:0}.section-heading .eyebrow{margin-bottom:10px}.section-heading>p{font-size:14px;line-height:1.6;color:var(--muted);max-width:350px;margin:0}.series-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.series-grid.two-series{grid-template-columns:repeat(2,minmax(0,1fr))}.series-grid.one-series{grid-template-columns:minmax(0,1fr)}.one-series .series-card{display:grid;grid-template-columns:1fr 1fr;align-items:center}.series-card{border:1px solid var(--line);background:#fff;overflow:hidden}.series-image{display:block}.series-image :global(img){display:block;width:100%;height:245px;object-fit:contain}.two-series .series-image :global(img){height:285px}.series-info{padding:23px}.series-info h3{font-size:23px;line-height:1.25;letter-spacing:-.025em;margin:0 0 22px}.series-info h3 a{text-decoration:none}.details-link{display:flex;align-items:center;justify-content:space-between;gap:14px;border-top:1px solid var(--line);padding-top:16px;font-size:14px;font-weight:700;text-decoration:none}.accessories{padding-bottom:45px}.accessories .series-image :global(img){height:195px}.accessories .series-info h3{font-size:21px}
  .ordering{display:grid;grid-template-columns:1fr 1.35fr;scroll-margin-top:130px}.ordering-lead{background:var(--forest);color:#fffdf8;padding:38px}.ordering-lead .eyebrow{color:#b9c9ac;font-size:10px}.ordering-lead h2{font-size:36px;line-height:1.12;letter-spacing:-.035em;margin:22px 0}.ordering-lead>p:not(.eyebrow){font-size:16px;line-height:1.6;color:#d4dece}.ordering-lead>a{display:flex;justify-content:space-between;background:#e2ebd4;color:var(--forest);padding:16px 20px;margin-top:28px;font-size:15px;font-weight:700;text-decoration:none}.ordering-steps{padding:16px 36px;background:#edf1e7}.ordering-steps article{display:flex;gap:24px;padding:22px 0;border-bottom:1px solid #d4ddcd}.ordering-steps article>span{font-size:16px;color:#718365;padding-top:2px}.ordering-steps h3{font-size:21px;margin:0 0 8px;letter-spacing:-.02em}.ordering-steps p{font-size:15px;line-height:1.6;margin:0;color:#596951}.ordering-steps details{padding:20px 0 5px;font-size:13px}.ordering-steps summary{cursor:pointer;font-weight:700;min-height:30px}.ordering-steps details p{font-size:13px;margin-top:12px}.sibling-links{display:flex;flex-wrap:wrap;gap:24px;align-items:center;border-top:1px solid var(--line);padding-top:24px;margin-top:32px;font-size:14px}.sibling-links>span{color:var(--muted)}a:hover{text-decoration:underline;text-underline-offset:4px}a:focus-visible,summary:focus-visible{outline:3px solid #71935e;outline-offset:4px}
  @media(max-width:900px){.category-intro{gap:28px}.category-preview{padding-inline:24px}.series-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.series-info{padding:20px}.series-info h3{font-size:22px}.ordering-lead{padding:28px}.ordering-steps{padding:12px 25px}.range-index>a{font-size:16px}.range-index small{font-size:11px}.category-tabs{gap:18px}}
  @media(max-width:580px){.category-preview{padding:0 18px 40px}.preview-note{font-size:10px}.trail{font-size:12px;padding:20px 0}.category-intro{grid-template-columns:1fr;padding-top:12px}.range-index{display:none}.category-intro h1{font-size:42px}.category-tabs{gap:18px;font-size:13px}.category-tabs a:last-child{margin:0}.section-heading{display:block}.section-heading>p{margin-top:13px}.series-grid,.series-grid.two-series{grid-template-columns:1fr}.one-series .series-card{display:block}.series-image :global(img),.two-series .series-image :global(img){height:265px}.accessories .series-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.accessories .one-series{grid-template-columns:1fr}.accessories .series-image :global(img){height:145px}.accessories .one-series .series-image :global(img){height:200px}.accessories .series-info{padding:16px}.accessories .series-info h3{font-size:18px}.accessories .details-link{font-size:12px}.ordering{grid-template-columns:1fr}.ordering-lead h2{font-size:34px}.sibling-links{gap:18px}}

  .category-intro,.section-heading,.series-card,.ordering-lead,.ordering-steps{min-width:0}.range-index small{white-space:normal;text-align:end}.series-info h3{text-wrap:pretty}.category-tabs a{max-width:100%}
</style>

