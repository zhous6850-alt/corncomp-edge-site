---
const { preview = true } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import { ARCHITECTURE_PAGES } from '../lib/site-architecture.mjs';
const page = ARCHITECTURE_PAGES.find((item) => item.route === '/resources/guides/paper-cup-sizes/');
const enquiry = '/contact/?' + new URLSearchParams({product:'Paper cups',source:page.route});
const ids = ['volume','measurements','construction','lids'];
const schema = [
  {'@context':'https://schema.org','@type':'Article',headline:'Paper cup sizes guide.',description:page.description,url:'https://corn-comp.com'+page.route,author:{'@type':'Organization',name:'Corncomp'},dateModified:page.reviewedDate},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Resources',item:'https://corn-comp.com/resources/'},{'@type':'ListItem',position:3,name:page.title,item:'https://corn-comp.com'+page.route}]},
];
---
<BaseLayout title={preview ? 'Paper Cup Sizes Guide - Design Preview | Corncomp' : 'Paper Cup Sizes Guide | Corncomp'} description={page.description} pathname={page.route} bodyClass="architecture-site" structuredData={schema} image="/media/generated/resources-cup-sizes-v2.png">
{preview && <p class="preview-note">DESIGN PREVIEW · 纸杯尺寸指南 · 正式站未修改</p>}
<article class="size-guide">
  <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? '/design-preview/resources/' : '/resources/'}>Resources</a><span>/</span><span>Paper cup sizes</span></nav>
  <header class="guide-header"><p class="eyebrow">SIZES & SELECTION</p><h1>Paper cup<br/><span>sizes guide.</span></h1><p>{page.intro}</p><div class="byline">Prepared by {page.preparedBy}<span>Reviewed <time datetime={page.reviewedDate}>{page.reviewedLabel}</time></span></div></header>
  <div class="reading-layout">
    <aside class="contents"><nav aria-label="On this page"><p>IN THIS GUIDE</p>{page.sections.map((section,index)=><a href={'#'+ids[index]}>{section.title}</a>)}<a href="#checklist">Specification checklist</a><a href="#sources">Official resources</a></nav><a class="browse" href="/products/cups-bowls/paper-cups/">Browse paper cups ↗</a></aside>
    <div class="guide-body">
      <section id="volume"><h2>{page.sections[0].title}</h2><p>{page.sections[0].text}</p><figure class="size-lineup"><img src="/media/generated/resources-cup-sizes-v2.png" width="1536" height="1024" alt="Illustrative comparison of four different paper cup sizes"/><figcaption>Illustrative size comparison. Confirm dimensions for the exact item.</figcaption></figure></section>
      <section id="measurements"><h2>{page.sections[1].title}</h2><p>{page.sections[1].text}</p>
        <figure class="measurement"><svg viewBox="0 0 620 380" role="img" aria-labelledby="measurement-title measurement-desc"><title id="measurement-title">Three measurements to check</title><desc id="measurement-desc">A schematic tapered cup with rim diameter across the top, height on the right, and base diameter below. No numeric dimensions; not to scale.</desc><path d="M180 100 L220 300 Q290 318 360 300 L400 100" fill="#f8faf4" stroke="#3d6145" stroke-width="2"/><ellipse cx="290" cy="100" rx="110" ry="20" fill="#e0e9d8" stroke="#3d6145" stroke-width="2"/><path d="M180 72V36 M400 72V36 M180 47H400 M433 100H465 M395 300H465 M451 100V300 M220 326V356 M360 326V356 M220 344H360" fill="none" stroke="#718466" stroke-width="1.5"/><path d="m180 47 8-4v8z m220 0-8-4v8z M451 100l-4 8h8z M451 300l-4-8h8z M220 344l8-4v8z M360 344l-8-4v8z" fill="#718466"/><text x="290" y="26" text-anchor="middle">Rim diameter</text><text x="474" y="207">Height</text><text x="290" y="374" text-anchor="middle">Base diameter</text></svg><figcaption>Schematic only, not to scale. Use the supplier’s drawing or an approved sample.</figcaption></figure>
      </section>
      <section id="construction"><h2>{page.sections[2].title}</h2><p>{page.sections[2].text}</p><div class="construction-list"><div><h3>Single wall</h3><p>Confirm drink temperature and how the cup will be held.</p></div><div><h3>Double wall</h3><p>Review the finished construction and the matching lid.</p></div><div><h3>Ripple wall</h3><p>Check the outer surface, dimensions and print requirements.</p></div></div></section>
      <section id="lids"><h2>{page.sections[3].title}</h2><p>{page.sections[3].text}</p><p class="fit-note">Same nominal capacity does not mean the same lid fit. Confirm both item references together.</p></section>
      <section id="checklist"><h2>Before you request a quote.</h2><p>Use this checklist to prepare a complete cup specification.</p><div class="table-scroll" role="region" aria-label={page.table.caption} tabindex="0"><table><caption>{page.table.caption}</caption><thead><tr>{page.table.headers.map(header=><th scope="col">{header}</th>)}</tr></thead><tbody>{page.table.rows.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div></section>
      <section id="sources" class="sources"><h2>Official resources.</h2><p>{page.sourceIntro}</p>{page.sources.map(source=><a href={source.url} target="_blank" rel="noopener">{source.title} ↗</a>)}</section>
      <aside class="next-step"><h2>Have a size in mind?</h2><p>Send the target volume, dimensions, quantity and lid requirements.</p><div><a class="action" href={enquiry}>Discuss your specification ↗</a><a class="text-link" href="/products/cups-bowls/paper-cups/">Compare paper cups ↗</a></div></aside>
    </div>
  </div>
</article>
</BaseLayout>
<style>
  .size-guide{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1240px;padding:0 48px 64px;margin:auto;color:var(--ink)}.preview-note{margin:0;padding:8px 16px;background:#edf1e7;text-align:center;color:#405e42;font-size:11px}.crumb{display:flex;flex-wrap:wrap;gap:12px;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}h1,h2,h3,p{text-wrap:pretty}a:focus-visible,.table-scroll:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:110px}
  .guide-header{padding:24px 0 40px;border-bottom:1px solid var(--line)}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}h1{font-size:clamp(44px,5vw,68px);line-height:1.04;letter-spacing:-.045em;margin:0 0 26px}h1 span{color:#718466}.guide-header>p:not(.eyebrow){font-size:18px;line-height:1.8;color:var(--muted);max-width:710px;margin:0 0 24px}.byline{display:flex;flex-wrap:wrap;gap:12px 30px;font-size:11px;color:var(--muted)}
  .reading-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:64px;padding-top:40px}.contents{align-self:start;position:sticky;top:120px}.contents nav{display:flex;flex-direction:column}.contents nav>p{font-size:10px;letter-spacing:.12em;margin:0 0 16px}.contents nav a{font-size:13px;line-height:1.5;color:var(--muted);padding:10px 0;text-decoration:none}.contents nav a:hover{color:var(--ink);text-decoration:underline;text-underline-offset:4px}.browse{display:inline-block;margin-top:24px;font-size:12px;text-underline-offset:5px;min-height:44px}
  .guide-body{min-width:0}.guide-body section{margin-bottom:44px}.guide-body h2{font-size:32px;line-height:1.2;letter-spacing:-.03em;margin:0 0 18px}.guide-body p{font-size:16px;line-height:1.85;color:var(--muted);margin:0 0 22px}figure{margin:28px 0 0}.size-lineup img{display:block;width:100%;height:auto}.size-lineup figcaption,.measurement figcaption{font-size:10px;color:var(--muted);line-height:1.7;margin-top:10px}.measurement{padding:24px;background:#edf1e7}.measurement svg{display:block;width:100%;height:auto}.measurement text{font-family:inherit;font-size:16px;fill:#3d6145}.construction-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;border-block:1px solid var(--line);padding:22px 0}.construction-list h3{font-size:18px;margin:0 0 10px}.construction-list p{font-size:13px;margin:0}.guide-body .fit-note{background:#edf1e7;padding:22px 26px;color:#3d6145;font-size:15px}
  .table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:560px;font-size:13px;line-height:1.7;text-align:left}caption{text-align:left;font-size:11px;color:var(--muted);padding-bottom:14px}th,td{vertical-align:top;padding:18px 14px;border-bottom:1px solid var(--line)}thead{background:#edf1e7}thead th{font-size:11px}tbody th{font-weight:600;width:24%}td{color:var(--muted)}.sources a{display:block;min-height:44px;font-size:13px;line-height:1.8;text-underline-offset:4px;margin-bottom:8px}.next-step{padding:30px;background:#e8ede2}.next-step>div{display:flex;align-items:center;flex-wrap:wrap;gap:16px 26px}.action{display:inline-block;padding:16px 20px;border-radius:3px;background:#3d6145;color:#f3f1dd;text-decoration:none;font-size:13px;font-weight:600}.action:hover{background:#1c3927}.text-link{font-size:13px;text-underline-offset:5px}
  @media(max-width:900px){.size-guide{padding-inline:28px}.reading-layout{grid-template-columns:180px minmax(0,1fr);gap:32px}}
  @media(max-width:760px){.size-guide{padding:0 20px 36px}.crumb{font-size:12px;padding:22px 0}.guide-header{padding:16px 0 28px}h1{font-size:48px}.guide-header>p:not(.eyebrow){font-size:16px}.reading-layout{grid-template-columns:1fr;gap:32px;padding-top:26px}.contents{position:static;background:#edf1e7;padding:24px}.contents nav a{padding:8px 0}.browse{margin-top:14px;min-height:30px}.guide-body h2{font-size:28px}.guide-body section{margin-bottom:34px}.measurement{padding:14px}.construction-list{grid-template-columns:1fr;gap:20px}.next-step{padding:24px}.guide-body p{font-size:15px}}
</style>
