---
const {preview = true} = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import {englishInventory} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import mediaInventory from '../data/media.json';
const choices=[
 {slug:'corrugated-hamburger-box',role:'BURGERS',title:'Fit the burger.',copy:'Start with the finished burger, including the bun and toppings. A hinged corrugated box is one format to compare for the filled height and footprint.',points:[['Choose by','The widest point, total height and space needed for the lid to close.'],['Try with the food','Pack your usual burger. Check clearance, closure and handling with a filled sample.']],link:'Compare burger box formats'},
 {slug:'kraft-wrap-box-pla-window',role:'WRAPS & HANDHELD FOOD',title:'Frame the wrap.',copy:'A windowed wrap box gives a different presentation from a burger box. Compare it around the length, width and way your wrapped item is arranged.',points:[['Choose by','Filled shape, portion length, window position and how the item is inserted.'],['Try at the counter','Use the actual wrap, including any paper liner. Check visibility, closure and removal.']],link:'Explore wrap boxes'},
 {slug:'kraft-french-fries-box',role:'FRIES & SIDES',title:'Size the side.',copy:'Choose an open-top side pack around the portion you serve. Review how it sits beside the main item and how guests reach the food.',points:[['Choose by','Usual serving quantity, pack opening and the finished portion height.'],['Try as an order','Fill the side pack and arrange it with the main item. Include the planned pickup or carrying method.']],link:'View fries packaging'},
].map(c=>{
 const p=englishInventory().find(p=>p.type==='product'&&p.slug===c.slug),a=p.featuredMedia,size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...c,product:p,media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const enquiry='/contact/?'+new URLSearchParams({category:'Fast Food',source:'/applications/fast-food-packaging/'}).toString();
const schema={'@context':'https://schema.org','@type':'WebPage',name:'A format for every item on the menu.',url:'https://corn-comp.com/applications/fast-food-packaging/',about:{'@id':'https://corn-comp.com/#organization'}};
---
<BaseLayout title={preview ? 'Fast Food Packaging - Design Preview | Corncomp' : 'Fast Food Packaging | Corncomp'} description="Choose burger boxes, wrap boxes and fries packs around the filled food and complete order." pathname="/applications/fast-food-packaging/" bodyClass="architecture-site" structuredData={[schema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:'Fast Food',item:schema.url}]}]}>
 {preview && <div class="preview-note">DESIGN PREVIEW · FAST FOOD V2 · 正式站未修改</div>}
 <div class="foodservice-page">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? "/design-preview/applications/" : "/applications/"}>Applications</a><span>/ Fast Food</span></nav>
 <header class="service-heading"><p class="eyebrow">FAST FOOD / BURGERS / WRAPS / SIDES</p><div><h1>A format for every<br/><span>item on the menu.</span></h1><div><p>Start with the finished food. Match each pack to its shape, then try the combination as a complete order.</p><a href="#service-range">Find your menu format ↓</a></div></div></header>
 <figure class="service-scene"><img src="/media/generated/fast-food-scene-preview.png" width="1664" height="936" alt="Illustrative fast-food counter with a burger box, windowed wrap box and fries pack" fetchpriority="high"/><figcaption><span>AT THE COUNTER / food fit · portion · complete order</span><span>AI-generated scene illustration. Product photos below show catalogue formats.</span></figcaption></figure>
 <section id="service-range" class="service-range"><div class="range-heading"><p class="eyebrow">START WITH YOUR MENU</p><h2>Different foods.<br/>Different starting formats.</h2><p>Compare the menu items separately before choosing a shared look. The same box shape does not need to serve every dish.</p></div><div class="service-grid">{choices.map(c=><article class="service-choice"><a class="choice-image" href={c.product.route} aria-label={'View '+contentText(c.product.title)}><ResponsiveMedia media={c.media}/></a><div class="choice-copy"><p class="eyebrow">{c.role}</p><h3>{c.title}</h3><p>{c.copy}</p><dl>{c.points.map(([title,copy])=><div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl><a class="product-link" href={c.product.route}>{c.link} ↗</a><a class="enquire-link" href={enquiry+'&product='+encodeURIComponent(contentText(c.product.title))}>Ask about this format ↗</a></div></article>)}</div></section>
 <section id="order-check" class="order-check"><div><p class="eyebrow">BEFORE MAKING IT A MEAL</p><h2>Try the order<br/>as it leaves the counter.</h2><p>Put the main item and sides together. Check how the filled packs sit, how staff close them and how the order reaches the customer.</p><a href="/products/food-boxes-containers/cone-fry-packaging/">Need another side format? Explore cones & fry packs ↗</a></div><ol><li><span>01</span><div><h3>Food fit</h3><p>Use normal portions, toppings and liners. Check headroom, closure and food access in each selected pack.</p></div></li><li><span>02</span><div><h3>Holding & handling</h3><p>Share serving temperature, moisture or oil content and time before eating. Trial the packs under your expected service conditions.</p></div></li><li><span>03</span><div><h3>The complete meal</h3><p>Combine the main item and sides in the intended tray or carrier. Confirm dimensions and check the filled arrangement and handover.</p></div></li></ol><p class="scope-note">Final suitability depends on the selected construction and actual food conditions. Grease resistance, temperature suitability, holding performance and carrying arrangements need item-specific checks; the illustrations are not test evidence.</p></section>
 <section class="service-close"><div><p class="eyebrow">A USEFUL PLACE TO START</p><h2>What is on<br/>your menu?</h2><p>Send menu photos, filled food dimensions, portions, pickup or delivery conditions, artwork needs, quantity and destination. We’ll help shortlist the formats.</p></div><div><a class="project-button" href={enquiry}>Plan your fast-food packaging ↗</a><a href="/custom-packaging/">Explore branding for your range ↗</a><a href={preview ? "/design-preview/applications/" : "/applications/"}>← All applications</a></div></section>
 </div>
</BaseLayout>
<style>
 @media(min-width:1001px){.service-grid{grid-template-columns:1fr!important}.service-choice{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center}.choice-image :global(img){height:340px!important}.choice-copy dl{display:grid;grid-template-columns:1fr 1fr;gap:24px}.choice-copy{padding:32px!important}}
 .foodservice-page{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;color:#405e42;text-align:center;padding:8px 16px;font-size:11px}.crumb{display:flex;gap:12px;flex-wrap:wrap;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}.service-heading{padding:22px 0 36px}.service-heading>div{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.service-heading h1{font-size:clamp(44px,4.8vw,68px);line-height:1.05;letter-spacing:-.045em;margin:0}.service-heading h1 span{color:#718466}.service-heading p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted);max-width:420px;margin:0 0 22px}.service-heading a{font-size:14px;font-weight:700;text-underline-offset:5px}.service-scene{margin:0}.service-scene>img{display:block;width:100%;height:420px;object-fit:cover}.service-scene figcaption{display:flex;justify-content:space-between;gap:24px;font-size:10px;color:var(--muted);line-height:1.7;padding:13px 0;border-bottom:1px solid var(--line)}.service-range{padding:56px 0}.range-heading{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;align-items:end;margin-bottom:30px}.range-heading>.eyebrow{grid-column:1/-1}.range-heading h2,.order-check h2,.service-close h2{font-size:clamp(32px,3.2vw,44px);line-height:1.1;letter-spacing:-.035em;margin:0 0 20px}.range-heading>p:last-child{font-size:16px;line-height:1.8;color:var(--muted);max-width:460px}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.service-choice{min-width:0;border:1px solid var(--line)}.choice-image{display:block;background:#fff}.choice-image :global(img){display:block;width:100%;height:270px;object-fit:contain}.choice-copy{padding:26px}.choice-copy .eyebrow{color:#718466;font-size:9px;margin-bottom:14px}.choice-copy h3{font-size:28px;line-height:1.1;letter-spacing:-.03em;margin:0 0 18px}.choice-copy>p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);margin:0 0 22px}.choice-copy dl{margin:0 0 22px}.choice-copy dl>div{border-top:1px solid var(--line);padding:15px 0}.choice-copy dt{font-size:12px;font-weight:700;margin-bottom:8px}.choice-copy dd{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.product-link,.enquire-link{display:block;font-size:12px;text-underline-offset:5px}.product-link{font-weight:700;margin-bottom:18px}.enquire-link{color:var(--muted)}.order-check{background:#edf1e7;display:grid;grid-template-columns:.9fr 1.1fr;gap:32px 60px;padding:44px}.order-check>div>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted)}.order-check>div>a{display:inline-block;margin-top:12px;font-size:13px;text-underline-offset:5px}.order-check ol{list-style:none;padding:0;margin:0}.order-check li{display:flex;gap:22px;border-top:1px solid #cad5c3;padding:20px 0}.order-check li>span{font-size:10px;color:#7c8b72}.order-check h3{font-size:20px;letter-spacing:-.02em;margin:0 0 10px}.order-check li p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.scope-note{grid-column:1/-1;border-top:1px solid #cad5c3;padding-top:18px;font-size:12px;line-height:1.8;color:var(--muted);margin:0}.service-close{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding-top:56px}.service-close p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:550px}.service-close>div:last-child{display:flex;flex-direction:column;align-items:start;gap:22px}.service-close a{font-size:12px;text-underline-offset:5px}.project-button{display:inline-flex;min-height:52px;background:var(--ink);color:#f3f1dd;padding:17px 22px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:120px}
 @media(max-width:1000px){.foodservice-page{padding-inline:28px}.service-heading>div{gap:32px}.service-grid{gap:18px}.choice-copy{padding:20px}.choice-copy h3{font-size:25px}.choice-image :global(img){height:230px}.order-check{padding:32px;gap:30px}}
 @media(max-width:650px){.foodservice-page{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.service-heading{padding:16px 0 28px}.service-heading>div{grid-template-columns:1fr;gap:24px}.service-heading h1{font-size:44px}.service-heading p:not(.eyebrow){font-size:16px}.service-scene>img{height:270px}.service-scene figcaption{flex-direction:column;gap:7px}.service-range{padding:40px 0}.range-heading{display:block}.range-heading h2,.order-check h2,.service-close h2{font-size:33px}.service-grid{grid-template-columns:1fr;gap:24px}.choice-image :global(img){height:280px}.choice-copy{padding:24px}.choice-copy h3{font-size:28px}.order-check{grid-template-columns:1fr;padding:28px 24px;gap:24px}.service-close{grid-template-columns:1fr;gap:24px;padding-top:40px}.preview-note{font-size:10px}}
</style>
