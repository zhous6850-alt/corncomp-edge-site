---
const {preview = true} = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveMedia from './ResponsiveMedia.astro';
import {englishInventory} from '../lib/localization.mjs';
import {contentText} from '../lib/content-routes.mjs';
import mediaInventory from '../data/media.json';
const choices=[
 {slug:'cardboard-ice-cream-cup',role:'PORTION & PRESENTATION',title:'Choose the serving.',copy:'Start with your normal portion and toppings. Compare the cup dimensions with the actual serving, rather than choosing by capacity alone.',points:[['Choose by','Scoop size, topping height, cup opening and room for the spoon.'],['Try at the counter','Fill a sample as you would serve it. Check the finished appearance and how guests reach the dessert.']],link:'Compare ice cream cups'},
 {slug:'pla-ice-cream-lid',role:'FOR A COVERED SERVING',title:'Leave room for the lid.',copy:'If customers take the dessert away, include the lid in the selection from the start. The pictured lid is a catalogue format, not a confirmed match for every cup.',points:[['Choose by','The exact cup item, rim dimensions and clearance above the filled portion.'],['Try the complete pack','Confirm the matching lid reference. Check closure and topping clearance using the actual cup and a filled sample.']],link:'View the lid reference'},
 {slug:'cardboard-cutlery',role:'THE SPOON',title:'Pick the spoon.',copy:'Choose the utensil the dessert needs. This catalogue image shows a spoon and a fork; specify the spoon reference rather than assuming both belong in the order.',points:[['Choose by','Cup depth, utensil length, food texture and intended serving temperature.'],['Try with your dessert','Use the proposed spoon with the actual serving. Agree individual wrapping or loose presentation if required.']],link:'Explore cardboard utensils'},
].map(c=>{
 const p=englishInventory().find(p=>p.type==='product'&&p.slug===c.slug),a=p.featuredMedia,size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...c,product:p,media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const enquiry='/contact/?'+new URLSearchParams({category:'Ice Cream & Dessert',source:'/applications/ice-cream-dessert-packaging/'}).toString();
const schema={'@context':'https://schema.org','@type':'WebPage',name:'A serving worth making room for.',url:'https://corn-comp.com/applications/ice-cream-dessert-packaging/',about:{'@id':'https://corn-comp.com/#organization'}};
---
<BaseLayout title={preview ? 'Ice Cream & Dessert Packaging - Design Preview | Corncomp' : 'Ice Cream & Dessert Packaging | Corncomp'} description="Choose dessert cups around portions and toppings, then review exact lid fit and spoon requirements." pathname="/applications/ice-cream-dessert-packaging/" bodyClass="architecture-site" structuredData={[schema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:'Ice Cream & Dessert',item:schema.url}]}]}>
 {preview && <div class="preview-note">DESIGN PREVIEW · ICE CREAM & DESSERT V2 · 正式站未修改</div>}
 <div class="foodservice-page">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={preview ? "/design-preview/applications/" : "/applications/"}>Applications</a><span>/ Ice Cream & Dessert</span></nav>
 <header class="service-heading"><p class="eyebrow">ICE CREAM & DESSERT / PORTION / TOPPINGS / FINISHING TOUCHES</p><div><h1>A serving worth<br/><span>making room for.</span></h1><div><p>Start with the scoop and the toppings. Build the cup, lid and spoon choice around the way you serve it.</p><a href="#service-range">Plan the serving ↓</a></div></div></header>
 <figure class="service-scene"><img src="/media/generated/dessert-service-scene-preview.png" width="1664" height="936" alt="Illustrative dessert shop counter with paper ice cream cups and a cardboard spoon" fetchpriority="high"/><figcaption><span>AT THE DESSERT COUNTER / portion · headroom · spoon</span><span>AI-generated scene illustration. Product photos below show catalogue formats.</span></figcaption></figure>
 <section id="service-range" class="service-range"><div class="range-heading"><p class="eyebrow">START WITH THE PORTION</p><h2>Serve it open.<br/>Or plan it to go.</h2><p>An open serving and a covered takeaway pack have different space needs. Choose the cup around the dessert, then add only the components your service requires.</p></div><div class="service-grid">{choices.map(c=><article class="service-choice"><a class="choice-image" href={c.product.route} aria-label={'View '+contentText(c.product.title)}><ResponsiveMedia media={c.media}/></a><div class="choice-copy"><p class="eyebrow">{c.role}</p><h3>{c.title}</h3><p>{c.copy}</p><dl>{c.points.map(([title,copy])=><div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl><a class="product-link" href={c.product.route}>{c.link} ↗</a><a class="enquire-link" href={enquiry+'&product='+encodeURIComponent(contentText(c.product.title))}>Ask about this format ↗</a></div></article>)}</div></section>
 <section id="serving-check" class="serving-check"><p class="eyebrow">HOW WILL IT BE SERVED?</p><h2>Make room for<br/>the way it leaves the shop.</h2><div class="table-scroll" role="region" aria-label="Scrollable dessert serving comparison" tabindex="0"><table><caption>Two service formats to review</caption><thead><tr><th scope="col">Service</th><th scope="col">Cup & portion</th><th scope="col">What to try</th></tr></thead><tbody><tr><th scope="row">Served at the counter</th><td>Review the visible portion, topping height and room for the spoon.</td><td>Fill the cup as usual and check access, handling and the finished appearance.</td></tr><tr><th scope="row">Taken away with a lid</th><td>Allow clearance for the confirmed lid and agree how the filled cup will be carried.</td><td>Try the exact cup and matching lid with the filled portion under the planned handover conditions.</td></tr></tbody></table></div><p class="scope-note">Confirm temperature suitability, holding conditions, exact lid fit and utensil performance for the selected items. A lid does not establish temperature control or a safe holding period; images are not evidence of compatibility or performance.</p></section>
 <section class="service-close"><div><p class="eyebrow">A USEFUL PLACE TO START</p><h2>What does your<br/>usual serving look like?</h2><p>Send a serving photo, portion size, toppings, temperature and holding conditions, lid or spoon needs, quantity and destination. We’ll help shortlist the formats.</p></div><div><a class="project-button" href={enquiry}>Plan your dessert packaging ↗</a><a href="/custom-packaging/">Explore branding for your range ↗</a><a href={preview ? "/design-preview/applications/" : "/applications/"}>← All applications</a></div></section>
 </div>
</BaseLayout>
<style>
 .serving-check{padding:40px;background:#f2ece5}.serving-check h2{font-size:clamp(32px,3.2vw,44px);line-height:1.1;letter-spacing:-.035em;margin:0 0 28px}.table-scroll{overflow-x:auto}table{width:100%;min-width:580px;border-collapse:collapse;text-align:left;font-size:14px;line-height:1.8}caption{text-align:left;font-size:11px;color:#657064;padding-bottom:15px}th,td{padding:18px;vertical-align:top;border-bottom:1px solid #d6d5c7}thead th{background:#e7e5d8;font-size:12px}td{color:#657064}tbody th{width:24%}.serving-check .scope-note{margin-top:24px}.service-scene>img{object-position:center 55%}@media(max-width:650px){.serving-check{padding:28px 24px}}
 .foodservice-page{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;color:#405e42;text-align:center;padding:8px 16px;font-size:11px}.crumb{display:flex;gap:12px;flex-wrap:wrap;padding:28px 0;font-size:13px;color:var(--muted)}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:700;margin:0 0 20px}.service-heading{padding:22px 0 36px}.service-heading>div{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.service-heading h1{font-size:clamp(44px,4.8vw,68px);line-height:1.05;letter-spacing:-.045em;margin:0}.service-heading h1 span{color:#718466}.service-heading p:not(.eyebrow){font-size:17px;line-height:1.8;color:var(--muted);max-width:420px;margin:0 0 22px}.service-heading a{font-size:14px;font-weight:700;text-underline-offset:5px}.service-scene{margin:0}.service-scene>img{display:block;width:100%;height:420px;object-fit:cover}.service-scene figcaption{display:flex;justify-content:space-between;gap:24px;font-size:10px;color:var(--muted);line-height:1.7;padding:13px 0;border-bottom:1px solid var(--line)}.service-range{padding:56px 0}.range-heading{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;align-items:end;margin-bottom:30px}.range-heading>.eyebrow{grid-column:1/-1}.range-heading h2,.service-check h2,.service-close h2{font-size:clamp(32px,3.2vw,44px);line-height:1.1;letter-spacing:-.035em;margin:0 0 20px}.range-heading>p:last-child{font-size:16px;line-height:1.8;color:var(--muted);max-width:460px}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.service-choice{min-width:0;border:1px solid var(--line)}.choice-image{display:block;background:#fff}.choice-image :global(img){display:block;width:100%;height:270px;object-fit:contain}.choice-copy{padding:26px}.choice-copy .eyebrow{color:#718466;font-size:9px;margin-bottom:14px}.choice-copy h3{font-size:28px;line-height:1.1;letter-spacing:-.03em;margin:0 0 18px}.choice-copy>p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);margin:0 0 22px}.choice-copy dl{margin:0 0 22px}.choice-copy dl>div{border-top:1px solid var(--line);padding:15px 0}.choice-copy dt{font-size:12px;font-weight:700;margin-bottom:8px}.choice-copy dd{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.product-link,.enquire-link{display:block;font-size:12px;text-underline-offset:5px}.product-link{font-weight:700;margin-bottom:18px}.enquire-link{color:var(--muted)}.service-check{background:#edf1e7;display:grid;grid-template-columns:.9fr 1.1fr;gap:32px 60px;padding:44px}.service-check>div>p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted)}.service-check>div>a{display:inline-block;margin-top:12px;font-size:13px;text-underline-offset:5px}.service-check ol{list-style:none;padding:0;margin:0}.service-check li{display:flex;gap:22px;border-top:1px solid #cad5c3;padding:20px 0}.service-check li>span{font-size:10px;color:#7c8b72}.service-check h3{font-size:20px;letter-spacing:-.02em;margin:0 0 10px}.service-check li p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.scope-note{grid-column:1/-1;border-top:1px solid #cad5c3;padding-top:18px;font-size:12px;line-height:1.8;color:var(--muted);margin:0}.service-close{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding-top:56px}.service-close p:not(.eyebrow){font-size:16px;line-height:1.8;color:var(--muted);max-width:550px}.service-close>div:last-child{display:flex;flex-direction:column;align-items:start;gap:22px}.service-close a{font-size:12px;text-underline-offset:5px}.project-button{display:inline-flex;min-height:52px;background:var(--ink);color:#f3f1dd;padding:17px 22px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:120px}
 @media(max-width:1000px){.foodservice-page{padding-inline:28px}.service-heading>div{gap:32px}.service-grid{gap:18px}.choice-copy{padding:20px}.choice-copy h3{font-size:25px}.choice-image :global(img){height:230px}.service-check{padding:32px;gap:30px}}
 @media(max-width:650px){.foodservice-page{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.service-heading{padding:16px 0 28px}.service-heading>div{grid-template-columns:1fr;gap:24px}.service-heading h1{font-size:44px}.service-heading p:not(.eyebrow){font-size:16px}.service-scene>img{height:270px}.service-scene figcaption{flex-direction:column;gap:7px}.service-range{padding:40px 0}.range-heading{display:block}.range-heading h2,.service-check h2,.service-close h2{font-size:33px}.service-grid{grid-template-columns:1fr;gap:24px}.choice-image :global(img){height:280px}.choice-copy{padding:24px}.choice-copy h3{font-size:28px}.service-check{grid-template-columns:1fr;padding:28px 24px;gap:24px}.service-close{grid-template-columns:1fr;gap:24px;padding-top:40px}.preview-note{font-size:10px}}
</style>
