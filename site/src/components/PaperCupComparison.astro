---
import {englishInventory,localizedEntry,routeFor} from '../lib/localization.mjs';
import PaperCupSizeGuide from './PaperCupSizeGuide.astro';
import {cupLandingLabels} from '../data/cup-landing-labels.mjs';
import {contentText} from '../lib/content-routes.mjs';
import {paperCupSeries,paperCupLids,paperCupSleeves,PAPER_CUP_LABELS} from '../data/paper-cup-comparison.mjs';
const {language,page}=Astro.props;
const t=PAPER_CUP_LABELS[language],base=cupLandingLabels(language),records=englishInventory();
const series=paperCupSeries(records),lids=paperCupLids(records),sleeves=paperCupSleeves(records);
const route=slug=>routeFor(language,`product:${slug}`);
const enquiry=slug=>routeFor(language,'architecture:contact')+'?'+new URLSearchParams({product:contentText(localizedEntry(language,`product:${slug}`).title),category:page.title,source:page.route});
const printQuote=routeFor(language,'architecture:contact')+'?'+new URLSearchParams({product:t.customProduct,category:page.title,source:page.route});
---
<section id="paper-cup-comparison" class="paper-cup-comparison" aria-labelledby="paper-cup-comparison-title">
  <header><h2 id="paper-cup-comparison-title">{t.title}</h2><p>{t.intro}</p></header>
  <p id="paper-cup-scroll-hint" class="scroll-hint">{t.scroll}</p>
  <div class="table-scroll" role="region" aria-labelledby="paper-cup-comparison-title" aria-describedby="paper-cup-scroll-hint" tabindex="0">
    <table class="cup-series-comparison"><caption>{t.capacityNote}</caption><thead><tr>{t.headers.map(label=><th scope="col">{label}</th>)}</tr></thead>
      <tbody>{series.map(row=><tr>
        <th scope="row">{base[row.format]}</th><td>{t[row.finish]}{row.pattern&&<small>{t[row.pattern]}</small>}</td>
        <td class="capacity-list">{row.capacities.length?<bdi>{row.capacities.join(' / ')}</bdi>:t.unlisted}</td>
        <td><bdi>{row.rims.join(' / ')}</bdi></td>
        <td><a href={route(row.slug)}>{t.details} <span aria-hidden="true">↗</span></a></td>
        <td><a class="series-quote" href={enquiry(row.slug)}>{t.quote} <span aria-hidden="true">↗</span></a></td>
      </tr>)}</tbody>
    </table>
  </div>
  <PaperCupSizeGuide language={language} />
  <div class="component-section"><h3 id="paper-cup-lids-title">{t.lidsTitle}</h3><p>{t.lidsIntro}</p>
    <div class="table-scroll" role="region" aria-labelledby="paper-cup-lids-title" aria-describedby="paper-cup-scroll-hint" tabindex="0"><table class="cup-lid-comparison"><thead><tr>{t.lidHeaders.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{lids.map(row=><tr><th scope="row"><bdi>{row.diameter}</bdi></th><td><a class="item-code" href={route('pla-lid-for-coffee-cup-black')}><bdi>{row.black}</bdi></a></td><td><a class="item-code" href={route('pla-lid-for-coffee-cup-white')}><bdi>{row.white}</bdi></a></td></tr>)}</tbody></table></div>
  </div>
  <div class="component-section"><h3 id="paper-cup-sleeves-title">{t.sleevesTitle}</h3><p>{t.sleevesIntro}</p>
    <div class="table-scroll" role="region" aria-labelledby="paper-cup-sleeves-title" aria-describedby="paper-cup-scroll-hint" tabindex="0"><table class="cup-sleeve-comparison"><thead><tr>{t.sleeveHeaders.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{sleeves.map(row=><tr><th scope="row"><a class="item-code" href={route('corrugated-board-cup-sleeve-8-12-16-20oz')}><bdi>{row.code}</bdi></a></th><td><bdi>{row.group}</bdi></td><td><bdi>{row.carton}</bdi></td></tr>)}</tbody></table></div>
    <p class="sleeve-details"><a href={route('corrugated-board-cup-sleeve-8-12-16-20oz')}>{t.sleeveDetails} <span aria-hidden="true">↗</span></a></p>
  </div>
  <p class="fit-note">{t.fit}</p>
  <div class="custom-route"><h3>{t.customTitle}</h3><p>{t.customIntro}</p><div class="custom-actions"><a class="custom-page" href={routeFor(language,'architecture:custom-packaging/custom-printed-paper-cups')}>{t.customLink} <span aria-hidden="true">↗</span></a><a class="printing-quote" href={printQuote}>{t.customQuote} <span aria-hidden="true">↗</span></a></div><p class="order-terms">{t.terms}</p></div>
</section>
<style>
 .paper-cup-comparison{padding:40px 0 20px;color:#1c3927;scroll-margin-top:130px}.paper-cup-comparison header{max-width:900px}.paper-cup-comparison h2{font-size:clamp(28px,3vw,36px);letter-spacing:-.03em;line-height:1.15;margin:0 0 16px}.paper-cup-comparison h3{font-size:clamp(24px,2.5vw,30px);letter-spacing:-.025em;line-height:1.2;margin:0 0 12px}.paper-cup-comparison p{font-size:15px;line-height:1.65;color:#617065;margin:0 0 18px}.paper-cup-comparison .scroll-hint{font-size:12px;margin:0 0 8px}.table-scroll{overflow-x:auto;overscroll-behavior-x:contain;max-width:100%;border:1px solid #dce3da;background:#fff}.table-scroll:focus-visible,a:focus-visible{outline:3px solid #71935e;outline-offset:3px}table{width:100%;border-collapse:collapse;font-size:14px;text-align:start}.cup-series-comparison{min-width:1000px}.cup-lid-comparison{min-width:610px}.cup-sleeve-comparison{min-width:520px}caption{caption-side:bottom;text-align:start;padding:16px 20px;font-size:13px;line-height:1.6;color:#617065;background:#f7f9f4}th,td{padding:17px 18px;border-bottom:1px solid #dce3da;text-align:start;vertical-align:middle;line-height:1.5}thead th{font-size:12px;background:#edf1e7;font-weight:700}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.cup-series-comparison tbody th{font-weight:600;min-width:120px}.capacity-list{max-width:245px;min-width:190px}small{display:block;color:#617065;font-size:12px;margin-top:5px}.item-code{font-family:ui-monospace,monospace;font-size:13px;white-space:nowrap}a{color:inherit;text-underline-offset:4px}.series-quote{font-weight:700;font-size:12px}.component-section{padding-top:36px}.paper-cup-comparison .sleeve-details{font-size:13px;margin-top:14px}.paper-cup-comparison .fit-note{font-size:13px;padding:16px 20px;background:#edf1e7;border-inline-start:3px solid #71935e;margin:24px 0 0}.custom-route{padding:32px 0 24px;border-bottom:1px solid #dce3da}.custom-route>p{max-width:950px}.custom-actions{display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin:22px 0}.custom-page{display:inline-flex;align-items:center;gap:24px;background:#1c3927;color:#fffdf8;padding:16px 20px;font-size:14px;font-weight:700;text-decoration:none}.printing-quote{font-size:14px;font-weight:700}.custom-page:hover{text-decoration:underline}.paper-cup-comparison .order-terms{font-size:13px;margin-bottom:0}
 @media(max-width:680px){.paper-cup-comparison{padding-top:30px}.paper-cup-comparison p{font-size:14px}th,td{padding:15px}.component-section{padding-top:30px}.custom-actions{align-items:start;flex-direction:column;gap:18px}}
</style>
