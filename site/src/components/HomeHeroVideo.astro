---
const { language } = Astro.props;
const [pause, play] = {
  en: ['Pause video', 'Play video'],
  zh: ['暂停视频', '播放视频'],
  de: ['Video pausieren', 'Video abspielen'],
  fr: ['Mettre en pause', 'Lire la vidéo'],
  es: ['Pausar vídeo', 'Reproducir vídeo'],
  ar: ['إيقاف الفيديو مؤقتًا', 'تشغيل الفيديو'],
}[language];
---
<div class="hero-video" data-hero-video>
  <div class="hero-video-screen" aria-hidden="true"><video muted loop playsinline preload="none" data-src="/media/factory-hero-loop.mp4"></video></div>
  <button class="hero-video-toggle" type="button" data-pause={pause} data-play={play} hidden>{play}</button>
</div>
<script>
  import { initializeHeroVideo } from '../lib/hero-video.mjs';
  initializeHeroVideo();
</script>
<style>
  .hero-video{position:absolute;inset:0}
  .hero-video-screen{position:absolute;inset:0;overflow:hidden;opacity:0;transition:opacity .4s ease;pointer-events:none}
  .is-playing .hero-video-screen{opacity:1}
  .hero-video-screen video{width:100%;height:100%;object-fit:cover}
  .hero-video-toggle{position:absolute;inset-inline-start:24px;bottom:20px;z-index:3;min-height:44px;padding:8px 16px;border:1px solid #fffdf8;background:#14271dcc;color:#fffdf8;font:inherit;cursor:pointer}
  .hero-video-toggle[hidden]{display:none}
  .hero-video-toggle:hover{background:#14271d}
  .hero-video-toggle:focus-visible{outline:3px solid #fffdf8;outline-offset:4px}
  .hero-video-toggle:active{transform:translateY(1px)}
  @media(prefers-reduced-motion:reduce){.hero-video-screen{transition:none}}
</style>
