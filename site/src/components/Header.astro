---
import { navigationFor } from '../lib/site-config.mjs';
import { PRODUCT_CATEGORIES, PRODUCT_GROUPS } from '../lib/site-architecture.mjs';
import { localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';

const { language = 'en' } = Astro.props;
const nav = navigationFor(language);
const ui = uiFor(language);
const languages = [['en', 'English'], ['fr', 'Français'], ['es', 'Español'], ['ar', 'العربية']];
const homeRoute = routeFor(language, 'home');
const productsRoute = routeFor(language, 'architecture:products');
const contactRoute = routeFor(language, 'architecture:contact');
const primaryLinks = [
  ['custom', 'architecture:custom-packaging'],
  ['applications', 'architecture:applications'],
  ['certifications', 'architecture:quality'],
  ['resources', 'architecture:resources'],
  ['about', 'architecture:about'],
].map(([navKey, contentKey]) => {
  const entry = localizedEntry(language, contentKey);
  return { key: navKey, label: nav[navKey]?.[0] || entry.title, route: entry.route };
});
const productGroups = PRODUCT_GROUPS.map((group) => {
  const contentKey = `architecture:${group.route.replace(/^\/+|\/+$/g, '')}`;
  const entry = localizedEntry(language, contentKey);
  return {
    ...entry,
    categories: PRODUCT_CATEGORIES.filter((category) => category.group === group.slug).map((category) => {
      const categoryKey = `architecture:${category.route.replace(/^\/+|\/+$/g, '')}`;
      return localizedEntry(language, categoryKey);
    }),
  };
});
---
<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href={homeRoute} aria-label={ui.brandHomeLabel}>
      <img src="/media/corncomp-logo.png" width="111" height="104" alt="Corncomp">
    </a>
    <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">
      <span>{ui.menu}</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav id="primary-navigation" aria-label={ui.primaryNavigationLabel}>
      <a href={homeRoute}>{nav.home[0]}</a>
      <details class="product-menu">
        <summary>{nav.product[0]}</summary>
        <div class="nav-submenu product-mega-menu">
          <a href={productsRoute}>{ui.allProducts}</a>
          {productGroups.map((group) => <div class="nav-product-group"><a class="nav-group-link" href={group.route}>{group.title}</a>{group.categories.map((category) => <a href={category.route}>{category.title}</a>)}</div>)}
        </div>
      </details>
      {primaryLinks.map((item) => item.key === 'resources' ? (
        <details class="resources-menu">
          <summary>{item.label}</summary>
          <div class="nav-submenu resources-submenu">
            {nav.resources.children.map(([label, route]) => <a href={route}>{label}</a>)}
          </div>
        </details>
      ) : <a href={item.route}>{item.label}</a>)}
      <details class="language-menu">
        <summary>{language.toUpperCase()}</summary>
        <div class="nav-submenu language-submenu">
          {languages.map(([code, label]) => <a href={routeFor(code, 'home')} lang={code} aria-current={code === language ? 'page' : undefined}>{label}</a>)}
        </div>
      </details>
      <a class="nav-contact" href={contactRoute}>{ui.requestQuote}</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const button = header?.querySelector('.menu-toggle');
    const nav = header?.querySelector('#primary-navigation');
    if (!header || !button || !nav) return;

    const setOpen = (open) => {
      header.toggleAttribute('data-menu-open', open);
      button.setAttribute('aria-expanded', String(open));
      if (!open) nav.querySelectorAll('details[open]').forEach((menu) => { menu.open = false; });
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const mobileOpen = button.getAttribute('aria-expanded') === 'true' && button.getClientRects().length > 0;
        const activeMenu = document.activeElement?.closest('details');
        setOpen(false);
        if (mobileOpen) button.focus();
        else if (activeMenu && nav.contains(activeMenu)) activeMenu.querySelector('summary')?.focus();
      }
    });
  })();
</script>

<style>
  .site-header { position: relative; z-index: 50; border-bottom: 1px solid var(--corncomp-line); background: color-mix(in srgb, var(--corncomp-paper) 94%, transparent); }
  .header-inner { width: min(1200px, calc(100% - 48px)); min-height: 84px; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .brand { display: inline-flex; flex: 0 0 auto; }
  .brand img { width: 92px; height: 58px; object-fit: contain; }
  nav { display: flex; align-items: center; gap: clamp(10px, 1.15vw, 18px); color: var(--corncomp-deep-green); font-size: .76rem; font-weight: 700; letter-spacing: .02em; }
  nav a { position: relative; text-decoration: none; }
  nav a:not(.nav-contact)::after { position: absolute; right: 0; bottom: -8px; left: 0; height: 2px; background: var(--corncomp-green); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .2s ease; }
  nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); }
  .nav-contact { padding: 11px 17px; border: 1px solid var(--corncomp-green); border-radius: 4px; color: var(--corncomp-green); }
  details { position: relative; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { margin-inline-start: 6px; content: '▾'; font-size: .7em; }
  .nav-submenu { position: absolute; top: calc(100% + 14px); left: -18px; min-width: 260px; padding: 10px; border: 1px solid var(--corncomp-line); border-radius: 4px; background: #fff; box-shadow: var(--corncomp-shadow); }
  .nav-submenu a { display: block; padding: 9px 10px; line-height: 1.25; }
  .language-submenu { right: 0; left: auto; min-width: 140px; }
  .resources-submenu { inset-inline-start: auto; inset-inline-end: 0; min-width: 180px; }
  .resources-menu summary:focus-visible { outline: 3px solid #72a87d; outline-offset: 3px; }
  .product-mega-menu { display: grid; grid-template-columns: repeat(3, minmax(190px, 1fr)); width: min(760px, calc(100vw - 48px)); }
  .nav-product-group { padding: 8px; }
  .nav-product-group .nav-group-link { color: var(--corncomp-green); font-weight: 900; }
  .menu-toggle { display: none; align-items: center; gap: 10px; padding: 10px 0; border: 0; background: transparent; color: var(--corncomp-deep-green); font: inherit; font-size: .82rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; cursor: pointer; }
  .menu-icon { position: relative; width: 22px; height: 16px; display: block; }
  .menu-icon i { position: absolute; left: 0; width: 22px; height: 2px; background: currentColor; transition: transform .2s ease, top .2s ease; }
  .menu-icon i:first-child { top: 3px; }
  .menu-icon i:last-child { top: 11px; }

  @media (max-width: 980px) {
    .header-inner { width: min(100% - 32px, 1200px); min-height: 72px; }
    .brand img { width: 78px; height: 48px; }
    .menu-toggle { display: inline-flex; }
    nav { position: absolute; top: 100%; right: 0; left: 0; display: grid; gap: 0; padding: 10px 16px 22px; border-bottom: 1px solid var(--corncomp-line); background: var(--corncomp-paper); box-shadow: 0 18px 34px rgba(18, 56, 35, .1); opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity .2s ease, transform .2s ease, visibility .2s; }
    nav a { padding: 15px 8px; border-bottom: 1px solid var(--corncomp-line); font-size: .95rem; }
    nav details { border-bottom: 1px solid var(--corncomp-line); }
    nav summary { padding: 15px 8px; font-size: .95rem; }
    .nav-submenu { position: static; min-width: 0; padding: 0 0 10px 14px; border: 0; box-shadow: none; }
    .product-mega-menu { display: block; width: auto; }
    .nav-submenu a { padding: 9px 8px; border: 0; font-size: .86rem; }
    nav a::after { display: none; }
    .nav-contact { margin-top: 12px; padding: 13px 16px; border: 0; border-radius: 3px; background: var(--corncomp-green); color: white; text-align: center; }
    [data-menu-open] nav { opacity: 1; visibility: visible; transform: translateY(0); }
    [data-menu-open] .menu-icon i:first-child { top: 7px; transform: rotate(45deg); }
    [data-menu-open] .menu-icon i:last-child { top: 7px; transform: rotate(-45deg); }
  }
</style>
