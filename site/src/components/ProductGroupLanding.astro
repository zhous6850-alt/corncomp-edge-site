---
import ResponsiveMedia from './ResponsiveMedia.astro';
import { englishInventory, localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';
import { contentText } from '../lib/content-routes.mjs';
import { PRODUCT_CATEGORIES, categoryForProduct } from '../lib/site-architecture.mjs';
import { cupLandingLabels } from '../data/cup-landing-labels.mjs';
import { FOOD_CATEGORY_PREVIEWS } from '../data/food-category-preview.mjs';
import { foodLandingLabels } from '../data/food-landing-labels.mjs';
import mediaInventory from '../data/media.json';
const { group, page, language='en', preview=false } = Astro.props;
const t=cupLandingLabels(language);
const foodLabels=foodLandingLabels(language);
const ui=uiFor(language);
const servicePreview=group==='foodservice-supplies'&&language==='en';
const serviceIntros={'paper-straws':'Bendy, sharp-edge, solid-colour and patterned paper straws.','disposable-cutlery':'Compare CPLA, wooden and cardboard cutlery series.'};
const inventory=englishInventory();
const preferred={'paper-cups':'double-wall-white-cardboard-paper-cup','salad-bowls':'kraft-paper-bowl','soup-cups':'natural-kraft-soup-cup','ice-cream-cups':'cardboard-ice-cream-cup'};
const categories=PRODUCT_CATEGORIES.filter((category)=>category.group===group && category.slug!=='paper-food-boxes');
const ranges=categories.map((category)=>{
 const entry=localizedEntry(language,`architecture:products/${group}/${category.slug}`);
 const products=inventory.filter((item)=>item.type==='product'&&categoryForProduct(item.slug)?.slug===category.slug);
 const product=products.find((item)=>item.slug===preferred[category.slug])||products.find((item)=>!/lid|sleeve/.test(item.slug))||products[0];
 const image=product.featuredMedia;
 const dimensions=mediaInventory.find((asset)=>asset.id===image.id).media_details;
 return {slug:category.slug,title:contentText(entry.title),intro:servicePreview&&serviceIntros[category.slug]||entry.intro,href:preview&&group==='bagasse'?`/design-preview/bagasse/${category.slug}/`:preview&&group==='foodservice-supplies'?`/design-preview/service/${category.slug}/`:preview&&group==='cups-bowls'?`/design-preview/${category.slug}/`:preview&&group==='food-boxes-containers'&&FOOD_CATEGORY_PREVIEWS[category.slug]?`/design-preview/food/${category.slug}/`:entry.route, media:{src:image.localPath,width:dimensions.width,height:dimensions.height,alt:localizedEntry(language,product.contentKey).alt||image.alt,fit:'contain',position:'center',evidence:'product'}};
});
const chapters=group==='food-boxes-containers'?[
 {id:'meals',title:'For meals & takeaway',intro:'Trays, food pails and meal boxes. Start with the format.',slugs:['paper-trays','square-food-boxes','round-food-boxes','menu-boxes']},
 {id:'handheld',title:'For food on the go',intro:'Formats for sandwiches, burgers, wraps and snacks.',slugs:['sandwich-boxes','burger-boxes','wrap-boxes','cone-fry-packaging']},
 {id:'display',title:'For slices & fresh selections',intro:'Explore the sushi, salad and pizza-slice formats.',slugs:['sushi-boxes','salad-boxes','pizza-slice-boxes']},
].map((chapter,index)=>({...chapter,title:foodLabels.chapters[index][0],intro:foodLabels.chapters[index][1],ranges:chapter.slugs.map(slug=>ranges.find(range=>range.slug===slug))})):[{id:'all-formats',title:null,intro:null,ranges}];
const jumps=chapters.length>1?chapters.map(chapter=>({href:'#'+chapter.id,title:chapter.title})):ranges.map((range,index)=>({href:'#range-'+index,title:range.title}));
const quote=`${routeFor(language,'architecture:contact')}?${new URLSearchParams({category:page.title,source:page.route})}`;
---
{preview && <div class="preview-strip">DESIGN PREVIEW · {page.title} · 正式站未修改</div>}
<div class:list={['group-preview', {'service-preview':group==='foodservice-supplies','bagasse-preview':group==='bagasse'}]}>
 <nav class="crumb" aria-label="Breadcrumb"><a href={routeFor(language,'home')}>{t.home}</a><span>/</span><a href={routeFor(language,'architecture:products')}>{t.products}</a><span>/ {contentText(page.title)}</span></nav>
 <header class="group-heading"><p class="kicker">{ui.productGroup}</p><div class="group-title"><h1>{contentText(page.title)}</h1>{group==='cups-bowls'&&<p class="group-tagline">{t.serving}</p>}</div><div class="heading-bottom"><p>{servicePreview?'Paper straws, cutlery, plates and bags. Explore the product range, then review the specifications for your order.':page.intro}</p><a href="/media/wp/231-corncomp-catalogue.pdf">{t.catalogue} ↗</a></div></header>
 <nav class="quick-nav" aria-label={t.browse}>{jumps.map((jump,index)=><a href={jump.href}><span>{String(index+1).padStart(2,'0')}</span>{jump.title}<b>↓</b></a>)}</nav>
 {chapters.map(chapter=><section id={chapter.id} class="range-chapter">{chapter.title&&<header class="chapter-heading"><h2>{chapter.title}</h2><p>{chapter.intro}</p></header>}<div class:list={['range-grid',{'many-ranges':chapter.ranges.length>6}]} aria-label={chapter.title||t.browse}>{chapter.ranges.map((range,index)=><article id={chapters.length>1?range.slug:`range-${index}`} class="range-card"><a class="range-picture" href={range.href} aria-label={range.title}><ResponsiveMedia media={range.media} eager={index<2&&chapter===chapters[0]}/></a><div class="range-copy"><h2><a href={range.href}>{range.title}</a></h2><p class="description">{range.intro}</p><a class="explore" href={range.href}>{t.browse}<span>↗</span></a></div></article>)}</div></section>)}
 <aside class="custom-band"><div><p class="kicker">{t.customLink}</p><h2>{t.customTitle}</h2><p>{t.customIntro}</p></div><div class="custom-actions"><a class="quote" href={quote}>{ui.requestQuote} ↗</a><a href={routeFor(language,'architecture:custom-packaging')}>{t.customLink} ↗</a></div></aside>
</div>
<style>
 .range-chapter{scroll-margin-top:125px}.range-chapter+.range-chapter{margin-top:48px;padding-top:32px;border-top:1px solid #dce3da}.chapter-heading{margin-bottom:24px;display:flex;justify-content:space-between;gap:25px;align-items:end}.chapter-heading h2{font-size:34px;margin:0;letter-spacing:-.03em}.chapter-heading p{font-size:15px;color:#617065;margin:0;max-width:350px}@media(max-width:600px){.chapter-heading{display:block}.chapter-heading p{margin-top:12px}.chapter-heading h2{font-size:28px}}
   .group-title{display:flex;align-items:baseline;flex-wrap:wrap;gap:12px 28px}.group-title .group-tagline{margin:0}:global(html[lang="zh-CN"]) .group-title{display:block}.group-preview{--ink:#1c3927;--muted:#617065;--line:#dce3da;max-width:1320px;padding:0 36px 64px;margin:auto;color:var(--ink)}
  .preview-strip{background:#e9efdf;color:#35503b;text-align:center;padding:8px 16px;font-size:12px;letter-spacing:.06em}.crumb{display:flex;flex-wrap:wrap;gap:12px;padding:27px 0;color:var(--muted);font-size:14px}.crumb a{text-decoration:none}
  .group-heading{padding:22px 0 32px}.kicker{font-size:11px;letter-spacing:.15em;font-weight:700;margin:0 0 14px}.group-heading h1{font-size:clamp(44px,5vw,68px);letter-spacing:-.045em;line-height:1.06;margin:0}.group-tagline{display:inline-block;color:#65815b;font-size:clamp(28px,3.3vw,44px);font-weight:700;margin-left:28px;letter-spacing:-.035em}.heading-bottom{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-top:22px}.heading-bottom p{font-size:18px;line-height:1.6;margin:0;color:var(--muted)}.heading-bottom>a{font-size:15px;font-weight:700;text-underline-offset:5px;white-space:nowrap}
  .quick-nav{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);margin-bottom:32px}.quick-nav a{display:flex;gap:14px;align-items:center;text-decoration:none;padding:19px 18px;border-inline-end:1px solid var(--line);font-size:15px;font-weight:700}.quick-nav a:first-child{padding-inline-start:0}.quick-nav a:last-child{border:0}.quick-nav span{font-size:11px;color:#7a8a71;font-weight:400}.quick-nav b{margin-inline-start:auto;font-weight:400}
  .range-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.range-card{border:1px solid var(--line);background:#fff;scroll-margin-top:128px;overflow:hidden}.range-picture{display:block;background:#fff}.range-picture :global(img){display:block;width:100%;height:290px;object-fit:contain}.range-copy{padding:25px 28px 22px}.range-copy .kicker{color:#6a7d60;margin-bottom:9px}.range-copy h2{font-size:32px;letter-spacing:-.035em;margin:0 0 12px;line-height:1.1}.range-copy h2 a{text-decoration:none}.description{color:var(--muted);font-size:16px;line-height:1.6;margin:0;max-width:480px}.range-copy ul{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:0;margin:18px 0 22px;color:#586c51;font-size:12px}.range-copy li+li:before{content:' / ';white-space:pre;color:#9ba693;margin:0 10px}.explore{display:flex;justify-content:space-between;min-height:44px;align-items:center;border-top:1px solid var(--line);padding-top:15px;text-decoration:none;font-size:15px;font-weight:700}
  .custom-band{display:flex;align-items:center;justify-content:space-between;gap:40px;background:#e8efdf;padding:36px 40px;margin-top:38px}.custom-band h2{font-size:34px;letter-spacing:-.035em;line-height:1.1;margin:0 0 13px}.custom-band p:not(.kicker){font-size:16px;line-height:1.6;color:var(--muted);margin:0}.custom-actions{display:flex;flex-direction:column;align-items:center;gap:18px;flex-shrink:0;font-size:14px;font-weight:700}.quote{background:var(--ink);color:#fffdf8;padding:16px 25px;text-decoration:none}.preview-help{font-size:12px;color:var(--muted);margin-top:20px}a:hover{text-decoration:underline;text-underline-offset:4px}a:focus-visible{outline:3px solid #71935e;outline-offset:4px}
  @media(max-width:900px){.group-tagline{display:block;margin:12px 0 0}.quick-nav a{padding:17px 12px;gap:8px;font-size:13px}.range-picture :global(img){height:240px}.range-copy{padding:22px}.custom-band{padding:30px}}
  @media(max-width:600px){.group-preview{padding:0 18px 40px}.preview-strip{font-size:10px}.crumb{font-size:12px;padding:20px 0}.group-heading{padding-top:10px}.group-heading h1{font-size:44px}.heading-bottom{align-items:start;flex-direction:column;gap:17px}.heading-bottom p{font-size:16px}.quick-nav{grid-template-columns:1fr 1fr;gap:0;margin-bottom:22px}.quick-nav a,.quick-nav a:first-child{padding:15px 10px}.quick-nav a:nth-child(2){border-inline-end:0}.quick-nav a:nth-child(-n+2){border-bottom:1px solid var(--line)}.range-grid{grid-template-columns:1fr;gap:22px}.range-picture :global(img){height:260px}.range-copy h2{font-size:29px}.custom-band{flex-direction:column;align-items:start;gap:25px;padding:28px}.custom-band h2{font-size:29px}.custom-band br{display:none}.custom-actions{align-items:start}.preview-help{line-height:1.7}}

 .range-grid.many-ranges{grid-template-columns:repeat(3,minmax(0,1fr))}.quick-nav{grid-template-columns:repeat(auto-fit,minmax(185px,1fr))}.quick-nav a{min-width:0;border-bottom:1px solid var(--line);padding-inline-start:14px}.range-copy{display:flex;flex-direction:column;flex:1}.range-copy h2{font-size:clamp(25px,2.2vw,32px)}.range-card{display:flex;flex-direction:column;min-width:0}.description{margin-bottom:20px}.explore{margin-top:auto}.heading-bottom p{max-width:780px}.heading-bottom>a{white-space:normal;flex-shrink:0}.custom-band>div:first-child{min-width:0}.custom-actions{max-width:42%;text-align:center}.group-tagline{margin-inline-start:28px} :global(html[lang="zh-CN"]) .group-tagline{display:block;margin:12px 0 0}
 @media(max-width:900px){.group-tagline{margin:12px 0 0}.range-grid.many-ranges{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.range-grid.many-ranges{grid-template-columns:1fr}.quick-nav{grid-template-columns:1fr 1fr}.custom-actions{max-width:100%;text-align:start}.quick-nav a{font-size:13px}}
.service-preview .range-card:last-child{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;align-items:center}.service-preview .range-card:last-child .range-picture :global(img){height:230px}.service-preview .range-card:last-child .range-copy{padding:28px}.service-preview .quick-nav{grid-template-columns:repeat(5,minmax(0,1fr))}@media(max-width:700px){.service-preview .quick-nav{grid-template-columns:1fr 1fr}.service-preview .range-card:last-child{display:flex}.service-preview .range-card:last-child .range-picture :global(img){height:230px}}
.service-preview .quick-nav span{flex-shrink:0;white-space:nowrap}@media(min-width:701px){.service-preview .quick-nav{grid-template-columns:repeat(4,minmax(0,1fr))}}.service-preview .quick-nav a:last-child{grid-column:1/-1}
.bagasse-preview .quick-nav span{flex-shrink:0;white-space:nowrap}
</style>

