---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import globalCss from '../styles/global.css?raw';
import { canonicalUrl, documentDirection } from '../lib/routes.mjs';

const { title, description = '', language = 'en', pathname = Astro.url.pathname, bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang={language} dir={documentDirection(language)}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    {description && <meta name="description" content={description}>}
    <link rel="canonical" href={canonicalUrl(pathname)}>
    <style is:inline set:html={globalCss} />
  </head>
  <body class={bodyClass}>
    <Header language={language} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
