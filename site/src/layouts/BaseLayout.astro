---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { canonicalUrl, documentDirection } from '../lib/routes.mjs';

const { title, description = '', language = 'en', pathname = Astro.url.pathname } = Astro.props;
---
<!doctype html>
<html lang={language} dir={documentDirection(language)}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    {description && <meta name="description" content={description}>}
    <link rel="canonical" href={canonicalUrl(pathname)}>
  </head>
  <body>
    <Header language={language} />
    <main><slot /></main>
    <Footer />
  </body>
</html>

