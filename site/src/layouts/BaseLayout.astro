---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import globalCss from '../styles/global.css?raw';
import { canonicalUrl, documentDirection } from '../lib/routes.mjs';
import { pageAlternates } from '../lib/site-config.mjs';

const { title, description = '', language = 'en', pathname = Astro.url.pathname, bodyClass = '', image = '/media/corncomp-logo.png', structuredData, ogType = 'website' } = Astro.props;
const canonical = canonicalUrl(pathname);
const socialImage = new URL(image, 'https://corn-comp.com').href;
const alternates = pageAlternates(pathname);
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://corn-comp.com/#organization', name: 'Corncomp', url: 'https://corn-comp.com', email: 'inquiry@corn-comp.com', telephone: '+86-574-86961222',
  logo: 'https://corn-comp.com/media/corncomp-logo.png',
  address: { '@type': 'PostalAddress', streetAddress: 'No.2 Building, No.3 Wanquanhe Road, Xiapu Street, Beilun District', addressLocality: 'Ningbo', addressRegion: 'Zhejiang', addressCountry: 'CN' },
  sameAs: ['https://www.facebook.com/profile.php?id=61592477933421', 'https://www.instagram.com/zxh_0927', 'https://www.linkedin.com/in/sam-zhou-431ab9424/'],
};
const schemas = [organization, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
---
<!doctype html>
<html lang={language} dir={documentDirection(language)}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    {description && <meta name="description" content={description}>}
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/media/corncomp-logo.png">
    {alternates.map((item) => <link rel="alternate" hreflang={item.language} href={canonicalUrl(item.route)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={canonicalUrl(alternates[0].route)} />}
    <meta property="og:type" content={ogType}>
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description}>}
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={socialImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description}>}
    <meta name="twitter:image" content={socialImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replaceAll('<', '\\u003c')} />
    <style is:inline set:html={globalCss} />
  </head>
  <body class={bodyClass}>
    <Header language={language} />
    <main><slot /></main>
    <Footer language={language} />
  </body>
</html>
