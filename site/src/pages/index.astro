---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Corncomp" pathname="/">
  <section class="container hero">
    <p>Biodegradable Food Packaging</p>
    <h1>Leading manufacturer of biodegradable paper straws &amp; food packaging</h1>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 55vh; padding-block: 90px; }
  p { color: var(--corncomp-green); font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .98; color: var(--corncomp-deep-green); }
</style>
