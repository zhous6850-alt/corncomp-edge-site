---
import CustomWorkflow from '../../components/CustomWorkflow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { englishInventory, routeFor } from '../../lib/localization.mjs';
import { paperCupLids, paperCupSeries, paperCupSleeves } from '../../data/paper-cup-comparison.mjs';
import { paperCupSizeRows } from '../../data/paper-cup-sizes.mjs';
import { CUSTOM_WORKFLOW } from '../../data/custom-workflow.mjs';
import mediaInventory from '../../data/media.json';
export function getStaticPaths() {
  return ['custom-printed-paper-cups','custom-paper-straws'].map(service => ({params:{service}}));
}
const cups = Astro.params.service === 'custom-printed-paper-cups';
const title = cups ? 'Custom paper cups' : 'Custom paper straws';
const seoTitle = cups ? 'Custom Printed Paper Cups and Lids' : title;
const route = '/custom-packaging/' + Astro.params.service + '/';
const enquiry = '/contact/?' + new URLSearchParams({product:title,category:cups?'Paper Cups':'Paper Straws',source:route}).toString();
const records = englishInventory();
const printableSlugs = [
  'single-wall-white-cardboard-paper-cup',
  'single-wall-kraft-paper-cup',
  'double-wall-white-cardboard-paper-cup',
  'double-wall-kraft-paper-cup',
  'ripple-natural-kraft-paper-cup-vertical-style',
  'ripple-natural-kraft-paper-cup-horizon-style',
];
const seriesLinkText = {
  'single-wall-white-cardboard-paper-cup': 'White single wall specifications',
  'single-wall-kraft-paper-cup': 'Kraft single wall specifications',
  'double-wall-white-cardboard-paper-cup': 'White double wall specifications',
  'double-wall-kraft-paper-cup': 'Kraft double wall specifications',
  'ripple-natural-kraft-paper-cup-vertical-style': 'Kraft vertical ripple specifications',
  'ripple-natural-kraft-paper-cup-horizon-style': 'Kraft horizontal ripple specifications',
};
const finishLabel = { white: 'White cardboard', kraft: 'Natural kraft' };
const formatLabel = { single: 'Single wall', double: 'Double wall', ripple: 'Ripple wall' };
const cupSeries = paperCupSeries(records).filter((row) => printableSlugs.includes(row.slug)).map((row) => ({
  ...row,
  formatName: formatLabel[row.format],
  finishName: row.pattern ? `Natural kraft, ${row.pattern} ripple` : finishLabel[row.finish],
  href: routeFor('en', `product:${row.slug}`),
  linkText: seriesLinkText[row.slug],
}));
const cupSizes = paperCupSizeRows(records);
const cupLids = paperCupLids(records);
const cupSleeves = paperCupSleeves(records);
const blackLid = routeFor('en', 'product:pla-lid-for-coffee-cup-black');
const whiteLid = routeFor('en', 'product:pla-lid-for-coffee-cup-white');
const sleeveRoute = routeFor('en', 'product:corrugated-board-cup-sleeve-8-12-16-20oz');
const qualityRoute = routeFor('en', 'architecture:quality');
const paperCupsCompare = routeFor('en', 'architecture:products/cups-bowls/paper-cups') + '#paper-cup-comparison';
const sleeveFit = 'One sleeve fits 8oz single-wall paper cups. The second sleeve fits 12, 16 and 20oz single-wall paper cups (240, 360, 480 and 600 ml).';
const faqs = [
  ['Which paper cups can be custom printed?', 'Custom printing is currently available for our kraft paper cups (single wall, double wall and ripple wall) and for our white cardboard single and double wall cups. If you are considering another cup material or style, please ask us first.'],
  ['What is the minimum order for custom printed cups?', 'The minimum order is 50,000 pieces per item for custom printed cups and 30,000 pieces per item for plain cups.'],
  ['How long does production take?', 'Lead time is about 30 days from order confirmation. We confirm the schedule in your quotation.'],
  ['Which lids and sleeves can I use with my cups?', 'PLA, PP and PET lids can all be supplied in the rim size that matches your cup. Our catalogue lists black and white PLA lids in 63, 75, 80 and 90 mm; PP and PET lids are available on request. Corrugated cup sleeves are listed in brown or white.'],
  ['How do I choose the right lid size?', 'Match the lid to the cup’s rim (top) diameter, not to the volume or the item number. There is no fixed lid for each cup, so we recommend checking a sample before you approve printing.'],
  ['What artwork do you need from me?', 'Editable vector artwork if available, with fonts or outlined text, colour references and any required marks. We will share the artwork template and print area for your chosen cup before you finalise the file.'],
  ['Can I see a proof or sample before production?', 'Yes. We agree the review method with you: a digital proof, an existing unprinted sample or a custom printed sample. A digital proof checks layout only. Sample scope, cost and timing are agreed before we proceed.'],
  ['Do your certificates cover my printed cups?', 'Company certificates do not automatically cover every cup, lid or coating. Tell us the items and destination market, and we will confirm which documents apply to your order.'],
  ['What should I include in a quote request?', 'The cup style and capacity as well as the item number, lid and sleeve needs, the drink and serving temperature, quantity, artwork, packing, destination and the documents you require.'],
  ['Which sleeve fits my cup?', sleeveFit],
];
const formats = (cups ? [
  ['Single wall','single-wall-kraft-paper-cup','A straightforward format. Review the construction against the drink and serving conditions.',[
    ['single-wall-white-cardboard-paper-cup','White single wall paper cups'],
    ['single-wall-kraft-paper-cup','Kraft single wall paper cups'],
  ]],
  ['Double wall','double-wall-kraft-paper-cup','A two-wall format. Confirm the size, artwork area and packing for the selected item.',[
    ['double-wall-white-cardboard-paper-cup','White double wall paper cups'],
    ['double-wall-kraft-paper-cup','Kraft double wall paper cups'],
  ]],
  ['Ripple wall','ripple-natural-kraft-paper-cup-vertical-style','A textured outer wall. Review the surface and available print treatment before preparing artwork.',[
    ['ripple-natural-kraft-paper-cup-vertical-style','Kraft ripple cups, vertical pattern'],
    ['ripple-natural-kraft-paper-cup-horizon-style','Kraft ripple cups, horizontal pattern'],
  ]],
] : [
  ['Small-dot pattern','small-dot-paper-straws','A catalogue pattern reference. Discuss colour and artwork requirements for your project.'],
  ['Large-dot pattern','big-dot-paper-straws','Explore a different pattern scale. Confirm the final design and construction together.'],
  ['Wave pattern','wave-paper-straws','A graphic pattern reference. Review diameter, length and wrapping for the selected straw.'],
]).map((entry)=>{
  const [name,slug,description,series]=entry;
  const product = records.find(item=>item.type==='product'&&item.slug===slug);
  const image = product.featuredMedia;
  const size = mediaInventory.find(asset=>asset.id===image.id).media_details;
  return {name,description,href:product.route,series:(series||[]).map(([seriesSlug,label])=>({label,href:routeFor('en',`product:${seriesSlug}`)})),media:{src:image.localPath,width:size.width,height:size.height,alt:image.alt||name,fit:'contain',position:'center',evidence:'product'}};
});
const checks = cups ? [
  ['Capacity is only the start.','Specify the catalogue item or target capacity, rim diameter and height. A volume label alone does not establish lid fit.'],
  ['Match the complete set.','Identify the lid and sleeve for the selected cup. There is no fixed lid for each cup, so match the lid to the rim diameter.'],
  ['Design for the surface.','Share editable artwork, colour references, print coverage and required legal marks. Confirm the print area before final artwork.'],
  ['Agree the finished pack.','Include quantity, sleeve or inner packing, carton requirements and destination in the brief.'],
] : [
  ['Diameter & length','Start with the beverage, cup height and lid opening. Confirm both dimensions rather than choosing by appearance alone.'],
  ['Colour & artwork','Provide a pattern reference or editable artwork, colour requirements and print direction for review.'],
  ['Individual wrapping','Tell us whether individual wrapping is required and share wrapper artwork or identification needs.'],
  ['Outer packing & destination','Specify quantity, inner packs, cartons and destination. Confirm construction and any required test-report scope.'],
];
const cupSteps = CUSTOM_WORKFLOW.en.steps.map((step, index) => index === 3
  ? [step[0], step[1].replace('MOQ, price and lead time remain order-specific.', 'Minimum order, price and lead time are confirmed for the items and quantity you choose.')]
  : step);
const schema = [
 {'@context':'https://schema.org','@type':'WebPage','@id':'https://corn-comp.com'+route+'#webpage',name:seoTitle,url:'https://corn-comp.com'+route,about:{'@id':'https://corn-comp.com/#organization'}},
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Custom Packaging',item:'https://corn-comp.com/custom-packaging/'},{'@type':'ListItem',position:3,name:title,item:'https://corn-comp.com'+route}]},
 ...(cups ? [{
  '@context':'https://schema.org','@type':'FAQPage','@id':'https://corn-comp.com'+route+'#faq',
  mainEntity:faqs.map(([name,text])=>({ '@type':'Question', name, acceptedAnswer:{ '@type':'Answer', text } })),
 }] : []),
];
---
<BaseLayout title={seoTitle+' | Corncomp'} description={cups?'Custom printed paper cups from Corncomp: kraft single, double and ripple wall, and white single and double wall, 120 to 600 mL, with PLA, PP or PET lids in the matching rim size.':'Plan paper straw dimensions, patterns, wrapping and packing with Corncomp.'} pathname={route} bodyClass="architecture-site" structuredData={schema}>
 <div class:list={['service-preview',cups?'cup-service':'straw-service']}>
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/custom-packaging/">Custom Packaging</a><span>/ {title}</span></nav>
 <header class="service-hero"><div><p class="eyebrow">CORNCOMP / {cups?'YOUR CUP, YOUR WAY':'SMALL DETAIL. DISTINCTIVE LOOK.'}</p><h1>{cups?<>Custom Printed Paper Cups<br/><em>and Lids</em></>:<>Custom paper<br/><em>straws</em></>}</h1><p class="hero-intro">{cups?'Custom printing is currently available for our kraft paper cups and our white cardboard single and double wall cups. Choose a construction and size, then select the lid and sleeve you need. Share your artwork and quantity, and we will confirm the details for your order.':'From the first sip to the last detail. Plan the dimensions, print and wrapping around your drink and your brand.'}</p><a class="project-button" href={enquiry}>Plan your {cups?'cup':'straw'} project <span>↗</span></a></div><aside class="project-sheet"><p class="eyebrow">{cups?'THE CUP PROJECT':'THE STRAW PROJECT'}</p><h2>{cups?'The right base.\nA considered finish.':'Size. Pattern.\nPresentation.'}</h2><dl>{(cups?[['01','Construction','Single / double / ripple wall'],['02','Dimensions','Capacity / rim / height'],['03','Brand details','Artwork / colour / packing']]:[['01','Dimensions','Diameter / length'],['02','Appearance','Colour / pattern / print'],['03','Presentation','Wrapping / inner pack / carton']]).map(([n,label,value])=><div><dt><span>{n}</span>{label}</dt><dd>{value}</dd></div>)}</dl><p class="sheet-foot">A project brief, not a final specification.<br/>Details are confirmed for the selected order.</p></aside></header>
 <nav class="section-nav" aria-label="On this page">{cups ? <><a href="#formats">Explore cup formats ↓</a><a href="#sizes">Sizes and rims ↓</a><a href="#lids-sleeves">Lids and sleeves ↓</a><a href="#details">The details to confirm ↓</a><a href="#artwork">Prepare your brief ↓</a><a href="#documents">Documents ↓</a><a href="#faq">FAQ ↓</a></> : <><a href="#formats">Explore patterns ↓</a><a href="#details">The details to confirm ↓</a><a href="#artwork">Prepare your brief ↓</a></>}</nav>
 <section id="formats" class="formats"><div class="section-heading"><div><p class="eyebrow">{cups?'CHOOSE YOUR CONSTRUCTION':'FIND A VISUAL DIRECTION'}</p><h2>{cups?'Choose your cup construction':'A little pattern.\nA lot of character.'}</h2></div><p>{cups?'Custom printing is currently available for our kraft paper cups in single wall, double wall and ripple wall, and for our white cardboard single and double wall cups. The images show standard products, not your printed design.':'Use these catalogue patterns as a starting point. Custom artwork, colours and dimensions are reviewed for each project.'}</p></div><div class="format-grid">{formats.map(format=><article><a class="format-image" href={format.href} aria-label={'View '+format.name}><ResponsiveMedia media={format.media}/></a><div class="format-copy"><h3>{format.name}</h3><p>{format.description}</p>{format.series?.length>0 && <ul class="series-links">{format.series.map((item)=><li><a href={item.href}>{item.label}</a></li>)}</ul>}<a href={format.href}>View catalogue product ↗</a></div></article>)}</div></section>
 {cups && <section id="sizes" class="spec-block"><h2>Paper cup sizes and rim diameters</h2><p>Capacities and rim diameters are listed per series. Open a product page for the exact dimensions and carton packing of each item.</p><div class="table-scroll" tabindex="0"><table><caption>Listed capacities and rim diameters by cup series</caption><thead><tr><th scope="col">Construction</th><th scope="col">Finish / style</th><th scope="col">Listed capacity (mL)</th><th scope="col">Listed rim (mm)</th><th scope="col">Details</th></tr></thead><tbody>{cupSeries.map((row)=><tr><td>{row.formatName}</td><td>{row.finishName}</td><td>{row.capacities.join(' / ')}</td><td>{row.rims.join(' / ')}</td><td><a href={row.href}>{row.linkText}</a></td></tr>)}</tbody></table></div><p>Listed capacity is not the same as usable fill volume. Tell us the drink, fill line and serving temperature, and we will review the size with you.</p><h3>White single wall cups: sizes by item</h3><div class="table-scroll" tabindex="0"><table><caption>White single wall paper cups (catalogue specifications)</caption><thead><tr><th scope="col">Item reference</th><th scope="col">Listed capacity (mL)</th><th scope="col">Top diameter (mm)</th><th scope="col">Base diameter (mm)</th><th scope="col">Height (mm)</th></tr></thead><tbody>{cupSizes.map((row)=><tr><th scope="row">{row.code}</th><td>{row.volume}</td><td>{row.top}</td><td>{row.bottom}</td><td>{row.height}</td></tr>)}</tbody></table></div><p>Please note: some item numbers are shared between our Single Wall and Ripple (Horizon) white cups, and their specifications differ. When you request a quote, please state the style and the capacity as well as the item number.</p><p><a href={paperCupsCompare}>Compare all paper cup ranges</a></p></section>}
 {cups && <section id="lids-sleeves" class="spec-block"><h2>Lids and sleeves for your cups</h2><p>PLA, PP and PET lids can all be supplied in the rim size that matches your cup. The PLA lids below are listed in our catalogue; PP and PET lids are available on request. There is no fixed lid for each cup, so match the lid to the cup’s rim diameter and check a sample before you approve printing.</p><div class="table-scroll" tabindex="0"><table><caption>PLA coffee lids by listed diameter</caption><thead><tr><th scope="col">Listed diameter (mm)</th><th scope="col">Black PLA reference</th><th scope="col">White PLA reference</th></tr></thead><tbody>{cupLids.map((row)=><tr><th scope="row">{row.diameter}</th><td><a href={blackLid}>{row.black}</a></td><td><a href={whiteLid}>{row.white}</a></td></tr>)}</tbody></table></div><p><a href={blackLid}>Black PLA coffee lids</a> · <a href={whiteLid}>White PLA coffee lids</a></p><h3>Corrugated cup sleeves</h3><div class="table-scroll" tabindex="0"><table><caption>Catalogue cup groups for corrugated sleeves</caption><thead><tr><th scope="col">Item reference</th><th scope="col">Catalogue cup group</th><th scope="col">Sleeves/carton</th></tr></thead><tbody>{cupSleeves.map((row)=><tr><th scope="row"><a href={sleeveRoute}>{row.code}</a></th><td>{row.group}</td><td>{row.carton}</td></tr>)}</tbody></table></div><p>{sleeveFit} Both are offered in brown or white.</p><p><a href={sleeveRoute}>Review sleeve specifications</a></p></section>}
 <section id="details" class="details"><div><p class="eyebrow">{cups?'FIT BEFORE PRINT':'BUILT AROUND THE DRINK'}</p><h2>{cups?'Check the fit\nbefore you print.':'Make every\ndetail count.'}</h2><p>{cups?'Treat the cup, lid and artwork as one project. Match the lid to the rim diameter and check a sample before you approve printing.':'The right appearance is only part of the brief. Define how the straw will be used, wrapped and supplied.'}</p><a href={cups?'/resources/guides/paper-cup-sizes/':'/products/foodservice-supplies/paper-straws/'}>{cups?'Read the cup sizes guide':'Browse the straw range'} ↗</a></div><dl>{checks.map(([name,description],index)=><div><dt><span>0{index+1}</span>{name}</dt><dd>{description}</dd></div>)}</dl></section>
 <div id="artwork"><CustomWorkflow language="en" route={route} title={title} steps={cups?cupSteps:undefined} /></div>
 {cups && <section id="documents" class="spec-block"><h2>Documents and certification scope</h2><p>Company certificates do not automatically cover every cup, lid or coating. Tell us the items and destination market, and we will confirm which documents apply to your order.</p><p><a href={qualityRoute}>Check document scope</a></p></section>}
 {cups && <section id="moq" class="spec-block"><h2>Minimum order and lead time</h2><ul><li>Custom printed cups: 50,000 pieces per item.</li><li>Plain cups: 30,000 pieces per item.</li><li>Lead time: about 30 days from order confirmation.</li></ul><p>We confirm quantities and the schedule in your quotation.</p></section>}
 {cups && <section id="faq" class="spec-block"><h2>Custom paper cup questions</h2>{faqs.map(([question,answer])=><div class="faq-item"><h3>{question}</h3><p>{answer}</p></div>)}</section>}
 <section class="enquiry-band"><div><p class="eyebrow">YOUR NEXT {cups?'CUP':'STRAW'} PROJECT</p><h2>Let’s make it yours.</h2><p>Share what you have. We’ll review what still needs to be defined.</p></div><div><a class="project-button" href={enquiry}>Start your project ↗</a><a class="back-link" href="/custom-packaging/">← All custom packaging</a></div></section>
 </div>
</BaseLayout>
<style>
 .service-preview{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;--tint:#edf1e7;max-width:1400px;margin:auto;padding:0 48px 64px;color:var(--ink)}.straw-service{--tint:#f0eddf}.preview-note{background:#edf1e7;color:#405e42;text-align:center;padding:8px 16px;font-size:11px;letter-spacing:.05em}.crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--muted);padding:28px 0}.crumb a{text-decoration:none}.service-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:64px;align-items:center;padding:32px 0 56px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.15em;margin:0 0 20px}.service-hero h1{font-size:clamp(46px,5vw,72px);line-height:1.04;letter-spacing:-.05em;margin:0 0 24px}.service-hero em{font-style:normal;color:#718466}.hero-intro{font-size:18px;line-height:1.7;color:var(--muted);max-width:500px;margin:0 0 30px}.project-button{display:inline-flex;gap:32px;justify-content:space-between;align-items:center;background:var(--ink);color:#f3f1dd;min-height:52px;padding:14px 22px;font-size:14px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}.project-sheet{background:var(--tint);border-top:3px solid #7b8c68;padding:30px 32px}.project-sheet h2{font-size:32px;line-height:1.12;letter-spacing:-.03em;white-space:pre-line;margin:0 0 24px}.project-sheet dl{margin:0}.project-sheet dl>div{border-top:1px solid #cfd6c6;padding:15px 0}.project-sheet dt{font-size:14px;font-weight:700;display:flex;gap:18px}.project-sheet dt span{font-size:10px;color:#7e8b71}.project-sheet dd{font-size:13px;color:var(--muted);margin:7px 0 0 31px}.sheet-foot{font-size:11px;line-height:1.7;color:var(--muted);margin:12px 0 0}.section-nav{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.cup-service .section-nav{grid-template-columns:repeat(4,1fr)}.section-nav a{font-size:14px;text-decoration:none;padding:20px;border-right:1px solid var(--line)}.section-nav a:first-child{padding-left:0}.section-nav a:last-child{border:0}.formats{padding:72px 0}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:30px}.section-heading h2,.details h2,.brief h2,.enquiry-band h2{font-size:clamp(34px,3.5vw,48px);line-height:1.1;letter-spacing:-.04em;white-space:pre-line;margin:0 0 20px}.section-heading>p{max-width:370px;font-size:15px;line-height:1.7;color:var(--muted)}.format-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.format-grid article{border:1px solid var(--line)}.format-image{display:block;background:#fff}.format-image :global(img){width:100%;height:300px;object-fit:contain;display:block}.format-copy{padding:24px}.format-copy h3{font-size:25px;letter-spacing:-.03em;margin:0 0 12px}.format-copy p{color:var(--muted);font-size:14px;line-height:1.7;margin:0 0 20px}.series-links{list-style:none;margin:0 0 18px;padding:0}.series-links li+li{margin-top:8px}.format-copy a,.details a,.spec-block a{font-size:13px;font-weight:700;text-underline-offset:5px}.details{background:var(--tint);display:grid;grid-template-columns:1fr 1.15fr;gap:70px;padding:48px}.details>div>p:not(.eyebrow){font-size:16px;line-height:1.7;color:var(--muted);max-width:350px;margin-bottom:26px}.details dl{margin:0}.details dl>div{border-top:1px solid #cad3c2;padding:20px 0}.details dt{display:flex;gap:16px;font-size:19px;font-weight:700}.details dt span{font-size:10px;padding-top:5px;color:#78876c}.details dd{font-size:14px;line-height:1.7;color:var(--muted);margin:10px 0 0 30px}.brief{padding:72px 0}.brief ol{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);padding:0;margin:34px 0 0;border-top:1px solid var(--line)}.brief li{padding:26px 26px 0 0}.brief li+li{border-left:1px solid var(--line);padding-left:26px}.brief li>span{font-size:10px;letter-spacing:.1em;color:#718466}.brief h3{font-size:22px;letter-spacing:-.025em;margin:24px 0 12px}.brief li p{font-size:15px;line-height:1.7;color:var(--muted);margin:0}.spec-block{padding:5