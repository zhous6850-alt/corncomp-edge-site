---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import {englishInventory} from '../../lib/localization.mjs';
import mediaInventory from '../../data/media.json';
const groups=[
 {name:'Takeaway & Delivery',tag:'FROM KITCHEN TO CUSTOMER',line:'Ready for the journey.',slug:'kraft-paper-salad-box-pla-window',guide:'/applications/takeaway-packaging/',copy:'Build the pack around your menu, holding time and delivery conditions. Review closure, handling and the complete takeaway set.',focus:'Closure / transport / holding time',links:[['Meal boxes','/products/food-boxes-containers/menu-boxes/'],['Salad bowls','/products/cups-bowls/salad-bowls/'],['Soup cups','/products/cups-bowls/soup-cups/']]},
 {name:'Restaurant & Foodservice',tag:'A COORDINATED SERVICE',line:'One menu. A considered range.',slug:'kraft-paper-bowl',guide:'/applications/restaurant-packaging/',copy:'Bring meal containers, cups and service accessories together. Plan formats around your portions, service workflow and supply requirements.',focus:'Portions / service / range planning',links:[['Cups & bowls','/products/cups-bowls/'],['Tableware','/products/bagasse/'],['Service supplies','/products/foodservice-supplies/']]},
 {name:'Fast Food',tag:'MADE FOR FOOD ON THE MOVE',line:'From the first bite.',slug:'natural-kraft-hamburger-box',guide:'/applications/fast-food-packaging/',copy:'Choose boxes, sleeves and snack formats around burgers, wraps and sides. Confirm the fit and handling requirements for the food you serve.',focus:'Food fit / handling / packing speed',links:[['Burger boxes','/products/food-boxes-containers/burger-boxes/'],['Wrap boxes','/products/food-boxes-containers/wrap-boxes/'],['Cones & fries','/products/food-boxes-containers/cone-fry-packaging/']]},
 {name:'Ice Cream & Dessert',tag:'THE SWEETER SIDE OF SERVICE',line:'A format for every scoop.',slug:'kraft-colour-ice-cream-cup',guide:'/applications/ice-cream-dessert-packaging/',copy:'Start with serving size, temperature and topping space. Review cup dimensions, lid needs and artwork as one complete brief.',focus:'Portions / temperature / presentation',links:[['Ice cream cups','/products/cups-bowls/ice-cream-cups/'],['Custom packaging','/custom-packaging/']]},
 {name:'Supermarket',tag:'DELI COUNTER / FRESH FOOD / GRAB & GO',line:'From the counter to the shelf.',slug:'black-white-cardboard-sushi-box-pla-window',guide:'/applications/supermarket-packaging/',copy:'Plan packaging for prepared meals, fresh salads and sushi. Review product visibility, closure, label space and outer packing against the actual retail conditions.',focus:'Display / closure / labels / cartons',links:[['Sushi boxes','/products/food-boxes-containers/sushi-boxes/'],['Salad boxes','/products/food-boxes-containers/salad-boxes/'],['Paper bags','/products/foodservice-supplies/paper-bags/']]},
].map((group,i)=>{
 const product=englishInventory().find(p=>p.type==='product'&&p.slug===group.slug);
 const asset=product.featuredMedia;const size=mediaInventory.find(m=>m.id===asset.id).media_details;
 return {...group,id:'scene-'+(i+1),number:'0'+(i+1),enquiry:'/contact/?'+new URLSearchParams({category:group.name,source:'/applications/'}).toString(),media:{src:asset.localPath,width:size.width,height:size.height,alt:asset.alt||group.name+' packaging example',fit:'contain',position:'center',evidence:'product'}};
});
const schema=[{'@context':'https://schema.org','@type':'WebPage',name:'Packaging for every setting. Made for the way you serve.',url:'https://corn-comp.com/applications/',about:{'@id':'https://corn-comp.com/#organization'}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'}]}];
---
<BaseLayout title="Packaging by Application | Corncomp" description="Explore packaging for delivery, foodservice, fast food, desserts and supermarket fresh food." pathname="/applications/" bodyClass="architecture-site" structuredData={schema}>
 <div class="applications-preview">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/ Applications</span></nav>
 <header class="application-hero"><div><p class="eyebrow">CORNCOMP / PACKAGING IN PRACTICE</p><h1>Packaging for every setting.<br/><span>Made for the way you serve.</span></h1><p class="hero-intro">Start with what you serve.<br/>Find the formats that fit the way you prepare, present and deliver it.</p><a class="text-link" href="#scenes">Find your application ↓</a></div><aside class="hero-index"><p class="eyebrow">WHERE DO YOU SERVE?</p>{groups.map(g=><a href={'#'+g.id}><span>{g.number}</span><strong>{g.name}</strong><b>↘</b></a>)}<p class="index-note">Five settings. Different priorities.<br/>One clear starting point for your packaging brief.</p></aside></header>
 <section id="scenes" class="scenes" aria-label="Packaging applications">{groups.map((g,i)=><article id={g.id} class:list={['scene-card',i===4&&'supermarket']}><div class="scene-image"><span class="image-label">{g.number} / APPLICATION</span><ResponsiveMedia media={g.media} eager={i===0}/></div><div class="scene-copy"><p class="eyebrow">{g.tag}</p><h2>{g.name}</h2><h3>{g.line}</h3><p>{g.copy}</p><p class="focus"><span>REVIEW TOGETHER</span>{g.focus}</p><nav class="product-links" aria-label={g.name+' product starting points'}>{g.links.map(([label,href])=><a href={href}>{label} ↗</a>)}</nav><div class="scene-actions">{g.guide?<a class="guide-link" href={g.guide}>Explore this application ↗</a>:<a class="guide-link" href={g.enquiry}>Plan supermarket packaging ↗</a>}{g.guide&&<a class="enquire" href={g.enquiry}>Discuss your requirements</a>}</div></div></article>)}</section>
 <section class="selection"><div class="selection-heading"><div><p class="eyebrow">A PRACTICAL SHORTLIST</p><h2>What matters<br/>in your setting?</h2></div><p>Use the application to narrow the range, then verify the selected construction against your food and operating conditions.</p></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable application planning table"><table><caption>Application planning checkpoints — not product performance guarantees</caption><thead><tr><th scope="col">Application</th><th scope="col">Bring to the brief</th><th scope="col">Start exploring</th></tr></thead><tbody>{groups.map(g=><tr><th scope="row"><a href={'#'+g.id}>{g.name}</a></th><td>{g.focus}</td><td>{g.links.map(([label,href])=><a href={href}>{label} ↗</a>)}</td></tr>)}</tbody></table></div><p class="verification-note">Confirm serving temperature, holding time, barrier needs, closure, matching components and required documents for the selected item. A category or company certificate does not establish performance or certification for every SKU.</p></section>
 <section class="brand-band"><div><p class="eyebrow">A CONSISTENT LOOK ACROSS YOUR RANGE</p><h2>Your menu.<br/>Your brand.</h2><p>Once the format is right, bring artwork, print coverage and packing into the conversation.</p></div><a href="/custom-packaging/">Explore custom packaging ↗</a></section>
 <section class="enquiry-close"><div><p class="eyebrow">LET’S BUILD YOUR SHORTLIST</p><h2>Tell us what you serve.</h2><p>Share the food, portion, service conditions, quantity and destination.<br/>We’ll review the requirements before confirming the next steps.</p></div><a class="project-button" href="/contact/?source=%2Fapplications%2F">Discuss your packaging ↗</a></section>
 </div>
</BaseLayout>
<style>
 .applications-preview{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 64px;color:var(--ink)}.preview-note{background:#edf1e7;text-align:center;padding:8px 16px;color:#405e42;font-size:11px;letter-spacing:.05em}.crumb{display:flex;gap:12px;font-size:13px;color:var(--muted);padding:28px 0}.crumb a{text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.15em;font-weight:700;margin:0 0 20px}.application-hero{display:grid;grid-template-columns:1.25fr 1fr;gap:70px;align-items:center;padding:32px 0 64px}.application-hero h1{font-size:clamp(48px,5.4vw,78px);line-height:1.04;letter-spacing:-.05em;margin:0 0 28px}.application-hero h1 span{color:#718466}.hero-intro{font-size:18px;line-height:1.7;color:var(--muted);margin:0 0 28px}.text-link{font-size:14px;font-weight:700;text-underline-offset:6px}.hero-index{background:#edf1e7;padding:28px 32px;border-top:3px solid #7b8c68}.hero-index>a{display:flex;gap:18px;border-top:1px solid #ccd6c5;padding:16px 0;text-decoration:none;align-items:center}.hero-index>a>span{font-size:10px;color:#7b8c68}.hero-index strong{font-size:17px;font-weight:500;flex:1}.hero-index b{font-size:20px;font-weight:400}.index-note{font-size:11px;line-height:1.7;color:var(--muted);margin:12px 0 0}.scenes{display:grid;grid-template-columns:1fr 1fr;gap:30px}.scene-card{border:1px solid var(--line);scroll-margin-top:120px;overflow:hidden}.scene-image{position:relative;background:#fff}.scene-image :global(img){width:100%;height:310px;object-fit:contain;display:block}.image-label{position:absolute;z-index:1;left:18px;top:16px;font-size:9px;letter-spacing:.12em;padding:7px 9px;background:#f7f7ee;color:#3e583f}.scene-copy{padding:30px}.scene-copy>.eyebrow{font-size:9px;color:#718466;margin-bottom:13px}.scene-copy h2{font-size:34px;line-height:1.08;letter-spacing:-.035em;margin:0 0 14px}.scene-copy h3{font-size:18px;font-weight:500;margin:0 0 14px}.scene-copy>p:not(.eyebrow):not(.focus){font-size:15px;line-height:1.8;color:var(--muted);margin:0 0 22px;max-width:540px}.focus{font-size:12px;color:#53694b;line-height:1.7;border-top:1px solid var(--line);padding-top:17px;margin:0 0 18px}.focus span{display:block;font-size:9px;letter-spacing:.12em;margin-bottom:6px;color:#7a8a70}.product-links{display:flex;gap:10px 18px;flex-wrap:wrap}.product-links a{font-size:12px;text-underline-offset:5px}.scene-actions{display:flex;gap:15px;flex-wrap:wrap;justify-content:space-between;align-items:center;margin-top:27px;padding-top:19px;border-top:1px solid var(--line)}.guide-link{font-size:14px;font-weight:700;text-decoration:none}.enquire{font-size:11px;color:var(--muted);text-underline-offset:4px}.supermarket{grid-column:1/-1;display:grid;grid-template-columns:1fr 1.1fr;background:#edf1e7}.supermarket .scene-image{display:flex;align-items:center}.supermarket .scene-image :global(img){height:100%;max-height:440px}.supermarket .scene-copy{padding:40px}.supermarket h2{font-size:44px}.selection{padding:72px 0}.selection-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:25px}.selection h2,.brand-band h2,.enquiry-close h2{font-size:clamp(34px,3.6vw,48px);line-height:1.1;letter-spacing:-.04em;margin:0 0 20px}.selection-heading>p{font-size:16px;line-height:1.8;color:var(--muted);max-width:400px}.table-scroll{overflow-x:auto}table{width:100%;min-width:650px;border-collapse:collapse;text-align:left;font-size:14px;line-height:1.7}caption{text-align:left;font-size:11px;color:var(--muted);padding-bottom:15px}th,td{padding:20px;border-bottom:1px solid var(--line);vertical-align:top}thead th{background:#edf1e7;font-size:11px}tbody th{width:28%;font-size:15px}td{color:var(--muted)}td a{display:inline-block;margin-right:18px;font-size:12px;text-underline-offset:4px}.verification-note{font-size:12px;line-height:1.8;color:var(--muted);max-width:900px;margin:22px 0 0}.brand-band{background:#f0eddf;padding:40px 48px;display:flex;align-items:center;justify-content:space-between;gap:40px}.brand-band p:not(.eyebrow){font-size:16px;line-height:1.7;color:var(--muted);max-width:550px;margin:0}.brand-band>a{font-size:14px;font-weight:700;text-underline-offset:6px;flex-shrink:0}.enquiry-close{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:60px 0 0}.enquiry-close p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);margin:0}.project-button{display:inline-flex;background:var(--ink);color:#f3f1dd;font-size:14px;font-weight:700;text-decoration:none;padding:18px 24px;min-height:52px;border-radius:3px;flex-shrink:0}.project-button:hover{background:#36593d}a:focus-visible,.table-scroll:focus-visible{outline:3px solid #7b945e;outline-offset:5px}
 @media(max-width:1000px){.applications-preview{padding-inline:28px}.application-hero{gap:36px}.application-hero h1{font-size:56px}.scene-copy{padding:24px}.scene-copy h2{font-size:29px}.scene-image :global(img){height:260px}.supermarket .scene-copy{padding:30px}}
 @media(max-width:650px){.applications-preview{padding:0 20px 36px}.crumb{padding:20px 0;font-size:12px}.application-hero{grid-template-columns:1fr;gap:32px;padding:20px 0 36px}.application-hero h1{font-size:48px}.hero-intro{font-size:16px}.hero-index{padding:24px}.hero-index strong{font-size:16px}.scenes{grid-template-columns:1fr;gap:24px}.scene-image :global(img){height:270px}.scene-copy{padding:24px}.scene-copy h2{font-size:30px}.supermarket{display:block}.supermarket .scene-image :global(img){height:270px}.supermarket .scene-copy{padding:24px}.supermarket h2{font-size:34px}.selection{padding:44px 0}.selection-heading{display:block}.selection-heading>p{font-size:15px}.selection h2,.brand-band h2,.enquiry-close h2{font-size:34px}.brand-band{padding:28px 24px;flex-direction:column;align-items:start;gap:26px}.enquiry-close{flex-direction:column;align-items:start;padding-top:40px;gap:25px}.enquiry-close br{display:none}.preview-note{font-size:10px}}
</style>
