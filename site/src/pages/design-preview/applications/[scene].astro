---
import DessertPreview from '../../../components/DessertPreview.astro';
import FastFoodPreview from '../../../components/FastFoodPreview.astro';
import RestaurantPreview from '../../../components/RestaurantPreview.astro';
import TakeawayPreview from '../../../components/TakeawayPreview.astro';
import SupermarketPreview from '../../../components/SupermarketPreview.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResponsiveMedia from '../../../components/ResponsiveMedia.astro';
import {APPLICATION_SCENES} from '../../../data/application-scenes.mjs';
import {englishInventory} from '../../../lib/localization.mjs';
import {contentText} from '../../../lib/content-routes.mjs';
import mediaInventory from '../../../data/media.json';
export function getStaticPaths(){return APPLICATION_SCENES.map(scene=>({params:{scene:scene.slug},props:{scene}}));}
const {scene}=Astro.props;
const inventory=englishInventory();
const products=scene.products.map((slug,i)=>{
 const p=inventory.find(p=>p.type==='product'&&p.slug===slug);
 const a=p.featuredMedia;const size=mediaInventory.find(m=>m.id===a.id).media_details;
 return {...p,title:contentText(p.title),use:scene.uses[i],media:{src:a.localPath,width:size.width,height:size.height,alt:contentText(a.alt||p.title),fit:'contain',position:'center',evidence:'product'}};
});
const [hero,...companions]=products;
const enquiry='/contact/?'+new URLSearchParams({category:scene.name,source:'/applications/'+scene.slug+'/'}).toString();
const url='https://corn-comp.com/applications/'+scene.slug+'/';
const schema=[{'@context':'https://schema.org','@type':'WebPage',name:scene.headline,url,about:{'@id':'https://corn-comp.com/#organization'}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Applications',item:'https://corn-comp.com/applications/'},{'@type':'ListItem',position:3,name:scene.name,item:url}]}];
---
{scene.slug === 'supermarket-packaging' ? <SupermarketPreview/> : scene.slug === 'takeaway-packaging' ? <TakeawayPreview/> : scene.slug === 'restaurant-packaging' ? <RestaurantPreview/> : scene.slug === 'fast-food-packaging' ? <FastFoodPreview/> : scene.slug === 'ice-cream-dessert-packaging' ? <DessertPreview/> : <BaseLayout title={scene.name+' Packaging — Design Preview | Corncomp'} description={scene.intro} pathname={'/applications/'+scene.slug+'/'} bodyClass="architecture-site" structuredData={schema}>
 <div class="preview-note">DESIGN PREVIEW · {scene.name} · 正式站未修改</div>
 <div class="scene-preview" style={'--scene-tint:'+scene.tint}>
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/design-preview/applications/">Applications</a><span>/ {scene.name}</span></nav>
 <header class="scene-hero"><div class="hero-copy"><p class="eyebrow">{scene.eyebrow}</p><p class="scene-name">{scene.name}</p><h1>{scene.headline}</h1><p class="intro">{scene.intro}</p><div class="hero-actions"><a class="project-button" href={enquiry}>Plan your packaging ↗</a><a class="text-link" href="#range">Build your shortlist ↓</a></div></div><figure class="hero-product"><span class="image-label">A STARTING POINT / {hero.use}</span><ResponsiveMedia media={hero.media} eager/><figcaption><span>{hero.title}</span><a href={hero.route}>View product ↗</a></figcaption></figure></header>
 <nav class="page-nav" aria-label="Scene sections"><a href="#range">01 <span>Build the set</span> ↓</a><a href="#priorities">02 <span>What to review</span> ↓</a><a href="#brief">03 <span>Prepare your brief</span> ↓</a></nav>
 <section id="range" class="range-section"><div class="range-intro"><p class="eyebrow">THINK BEYOND ONE CONTAINER</p><h2>A coordinated set.<br/>Not an isolated item.</h2><p>The hero product is one possible starting point. Explore complementary formats, then confirm the complete selection for your menu and service.</p><a href="/products/">Browse all product categories ↗</a><div class="set-summary"><span>YOUR STARTING POINTS</span>{scene.uses.map((use,i)=><p><b>0{i+1}</b>{use}</p>)}</div></div><div class="companion-grid">{companions.map(p=><article><a class="companion-image" href={p.route} aria-label={'View '+p.title}><ResponsiveMedia media={p.media}/></a><div class="companion-copy"><p class="eyebrow">{p.use}</p><h3>{p.title}</h3><a href={p.route}>Explore this product ↗</a></div></article>)}</div></section>
 <section id="priorities" class="priorities"><div><p class="eyebrow">THE SETTING CHANGES THE SPECIFICATION</p><h2>Start with<br/>what matters.</h2><p>Use these checkpoints to shape the conversation. They are review requirements, not guarantees of product performance.</p></div><ol>{scene.checks.map(([title,copy],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
 <section id="brief" class="brief-section"><div><p class="eyebrow">A USEFUL BRIEF SAVES GUESSWORK</p><h2>Bring the details.<br/>We’ll review the options.</h2><p>{scene.brief}</p></div><div class="brief-steps"><div><span>01 / DEFINE</span><h3>Describe the use.</h3><p>Share actual food and service conditions, plus any product references you already have.</p></div><div><span>02 / CONFIRM</span><h3>Review the selected item.</h3><p>Confirm dimensions, materials, matching components, sample requirements and applicable documents.</p></div><div><span>03 / PLAN</span><h3>Agree the supply details.</h3><p>MOQ, price, artwork, packing and timing are confirmed for the final order specification.</p></div></div></section>
 <aside class="custom-note"><div><p class="eyebrow">MAKE THE RANGE YOURS</p><h2>A consistent look.<br/>Across the whole service.</h2><p>Discuss custom printing after the format is selected. Artwork and available treatments depend on the product.</p></div><a href="/custom-packaging/">Explore custom packaging ↗</a></aside>
 <section class="enquiry-close"><div><p class="eyebrow">{scene.name.toUpperCase()} / NEXT STEPS</p><h2>Let’s build your shortlist.</h2><p>Send your requirements with this application already included.</p></div><a class="project-button" href={enquiry}>Discuss {scene.name.toLowerCase()} ↗</a></section>
 <nav class="other-scenes" aria-label="Other applications"><p class="eyebrow">EXPLORE ANOTHER SETTING</p><div>{APPLICATION_SCENES.filter(s=>s.slug!==scene.slug).map(s=><a href={'/design-preview/applications/'+s.slug+'/'}>{s.name} ↗</a>)}</div><a class="overview" href="/design-preview/applications/">← All applications</a></nav>
 </div>
</BaseLayout>}
<style>
 .scene-preview{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 56px;color:var(--ink)}.preview-note{background:#edf1e7;text-align:center;color:#405e42;padding:8px 16px;font-size:11px;letter-spacing:.05em}.crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--muted);padding:28px 0}.crumb a{text-decoration:none}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.14em;margin:0 0 20px}.scene-hero{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding:24px 0 48px}.scene-name{font-size:14px;color:#718466;margin:0 0 16px}.scene-hero h1{font-size:clamp(42px,4.6vw,64px);line-height:1.06;letter-spacing:-.045em;max-width:590px;margin:0 0 24px}.intro{font-size:17px;line-height:1.8;color:var(--muted);max-width:470px;margin:0 0 28px}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:22px}.project-button{display:inline-flex;background:var(--ink);color:#f3f1dd;min-height:52px;padding:17px 22px;font-size:13px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}.text-link{font-size:13px;font-weight:700;text-underline-offset:5px}.hero-product{margin:0;border:1px solid var(--line);position:relative;background:#fff;min-width:0}.hero-product :global(img){display:block;width:100%;height:380px;object-fit:contain}.image-label{position:absolute;top:16px;left:16px;background:var(--scene-tint);padding:8px 10px;font-size:9px;letter-spacing:.1em;color:#4a6345}.hero-product figcaption{padding:16px 20px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;background:#fffdf7}.hero-product figcaption>span{max-width:300px}.hero-product figcaption>a{font-weight:700;white-space:nowrap;text-underline-offset:4px}.page-nav{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.page-nav a{display:flex;align-items:center;gap:18px;border-right:1px solid var(--line);padding:20px;font-size:11px;color:#78886e;text-decoration:none}.page-nav a:first-child{padding-left:0}.page-nav a:last-child{border:0}.page-nav span{font-size:14px;color:var(--ink);flex:1}.range-section{display:grid;grid-template-columns:.85fr 1.4fr;gap:55px;padding:72px 0}.range-intro h2,.priorities h2,.brief-section h2,.custom-note h2,.enquiry-close h2{font-size:clamp(32px,3.1vw,44px);line-height:1.12;letter-spacing:-.035em;margin:0 0 23px}.range-intro>p:not(.eyebrow),.priorities>div>p:not(.eyebrow),.brief-section>div>p:not(.eyebrow){color:var(--muted);font-size:16px;line-height:1.8;max-width:440px}.range-intro>a{display:inline-block;margin-top:10px;font-size:13px;font-weight:700;text-underline-offset:5px}.set-summary{margin-top:32px;border-top:1px solid var(--line);padding-top:18px}.set-summary>span{font-size:9px;letter-spacing:.1em;color:#7a8a70}.set-summary p{font-size:13px;margin:14px 0;display:flex;gap:20px}.set-summary b{font-size:10px;font-weight:400;color:#7a8a70}.companion-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}.companion-grid article{min-width:0;border:1px solid var(--line);background:#fffdf7}.companion-image{display:block;background:#fff}.companion-image :global(img){display:block;width:100%;height:240px;object-fit:contain}.companion-copy{padding:22px}.companion-copy .eyebrow{font-size:9px;color:#7a8a70;margin-bottom:13px}.companion-copy h3{font-size:23px;letter-spacing:-.025em;line-height:1.2;margin:0 0 24px}.companion-copy>a{font-size:12px;text-underline-offset:5px}.priorities{display:grid;grid-template-columns:1fr 1.15fr;gap:70px;background:var(--scene-tint);padding:48px}.priorities ol{list-style:none;padding:0;margin:0}.priorities li{display:flex;gap:22px;padding:22px 0;border-top:1px solid #cbd5c5}.priorities li>span{font-size:11px;color:#7a8a70}.priorities h3{font-size:22px;letter-spacing:-.025em;line-height:1.2;margin:0 0 10px}.priorities li p{font-size:15px;line-height:1.8;color:var(--muted);margin:0}.brief-section{padding:72px 0}.brief-steps{display:grid;grid-template-columns:repeat(3,1fr);margin-top:32px;border-top:1px solid var(--line)}.brief-steps>div{padding:24px 24px 0 0}.brief-steps>div+div{padding-left:24px;border-left:1px solid var(--line)}.brief-steps span{font-size:10px;letter-spacing:.1em;color:#718466}.brief-steps h3{font-size:21px;letter-spacing:-.02em;margin:24px 0 12px}.brief-steps p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.custom-note{background:#f0eddf;padding:36px 44px;display:flex;justify-content:space-between;align-items:center;gap:40px}.custom-note p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);max-width:570px;margin:0}.custom-note>a{font-size:13px;font-weight:700;text-underline-offset:5px;flex-shrink:0}.enquiry-close{padding:56px 0;display:flex;align-items:center;justify-content:space-between;gap:32px}.enquiry-close h2{margin-bottom:16px}.enquiry-close p:not(.eyebrow){font-size:15px;color:var(--muted);line-height:1.8;margin:0}.enquiry-close>a{flex-shrink:0}.other-scenes{border-top:1px solid var(--line);padding-top:28px}.other-scenes>div{display:flex;gap:16px 28px;flex-wrap:wrap}.other-scenes a{font-size:13px;text-underline-offset:5px}.other-scenes .overview{display:inline-block;margin-top:28px;color:var(--muted);font-size:12px}section{scroll-margin-top:120px}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}
 @media(max-width:1000px){.scene-preview{padding-inline:28px}.scene-hero{gap:30px}.scene-hero h1{font-size:46px}.hero-product :global(img){height:320px}.range-section{gap:32px}.companion-image :global(img){height:210px}.companion-copy{padding:18px}.companion-copy h3{font-size:21px}.priorities{padding:32px;gap:36px}}
 @media(max-width:650px){.scene-preview{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.scene-hero{grid-template-columns:1fr;gap:28px;padding:16px 0 32px}.scene-hero h1{font-size:43px}.intro{font-size:16px}.hero-product :global(img){height:300px}.hero-product figcaption{padding:15px;font-size:11px}.page-nav{grid-template-columns:1fr}.page-nav a,.page-nav a:first-child{padding:15px 0;border:0;border-bottom:1px solid var(--line)}.page-nav a:last-child{border:0}.range-section{grid-template-columns:1fr;padding:44px 0;gap:28px}.companion-grid{gap:14px}.companion-image :global(img){height:180px}.companion-copy{padding:15px}.companion-copy h3{font-size:19px}.companion-copy .eyebrow{font-size:8px}.companion-copy>a{font-size:11px}.priorities{grid-template-columns:1fr;padding:28px 24px;gap:25px}.range-intro h2,.priorities h2,.brief-section h2,.custom-note h2,.enquiry-close h2{font-size:33px}.brief-section{padding:44px 0}.brief-steps{grid-template-columns:1fr}.brief-steps>div,.brief-steps>div+div{padding:22px 0;border-left:0;border-bottom:1px solid var(--line)}.brief-steps h3{margin-top:15px}.custom-note{padding:28px 24px;flex-direction:column;align-items:start;gap:24px}.enquiry-close{flex-direction:column;align-items:start;padding:40px 0;gap:25px}.preview-note{font-size:10px}}
</style>
