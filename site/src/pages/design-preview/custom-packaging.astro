---
import BaseLayout from '../../layouts/BaseLayout.astro';
const enquiry = '/contact/?category=Custom%20Packaging&source=%2Fcustom-packaging%2F';
const specifications = [
  ['Format & size', 'Product type, catalogue reference or target dimensions, and intended food or drink.'],
  ['Material & construction', 'Required construction, serving temperature and any matching components to review.'],
  ['Artwork & colour', 'Editable artwork, print coverage, colours and the details that matter to your brand.'],
  ['Packing & destination', 'Quantity, individual wrapping, carton requirements and delivery destination.'],
];
const steps = [
  ['Share your brief', 'Tell us what you serve, the packaging you need and your target quantity.'],
  ['Review the details', 'We review the format, construction, artwork and packing requirements together.'],
  ['Confirm the sample', 'Agree the sample type and approval steps appropriate to your project.'],
  ['Plan production', 'Confirm the specification, MOQ, price, documents and timing before production.'],
];
---
<BaseLayout title="Custom Packaging — Design Preview | Corncomp" description="Explore custom paper cup and paper straw projects with Corncomp." pathname="/custom-packaging/" bodyClass="architecture-site">
  <div class="design-notice">DESIGN PREVIEW · 定制包装页设计预览 · 正式站未修改</div>
  <div class="custom-preview">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Custom Packaging</span></nav>
    <header class="studio-hero">
      <div class="hero-copy"><p class="eyebrow">CORNCOMP / CUSTOM PACKAGING</p><h1>Your packaging.<br/><span>Your signature.</span></h1><p class="intro">Make your next serving unmistakably yours. Start with the right format. Bring your artwork. Let’s work through the details.</p><div class="hero-actions"><a class="project-button" href={enquiry}>Start your project <span>↗</span></a><a class="text-link" href="#custom-ranges">Explore the options ↓</a></div><p class="small-note">Paper cups · Paper straws · Project-specific packaging enquiries</p></div>
      <div class="product-board"><figure class="cup-study"><div class="branded-picture"><img class="brand-stamp" src="/media/corncomp-logo.png" width="222" height="208" alt="Corncomp"/><img src="/media/wp/263--2026-07-25-100816.png" width="1200" height="1376" alt="White double-wall paper cup with coffee, shown as a base format for artwork review" fetchpriority="high"/></div><figcaption>01 / THE FORMAT <span>Start with the right base.</span></figcaption></figure><figure class="print-study"><div class="branded-picture"><img class="brand-stamp" src="/media/corncomp-logo.png" width="222" height="208" alt="Corncomp"/><img src="/media/generated/custom-straws-forest-preview.png" width="1086" height="1448" alt="Three complete paper straws with different printed stripe patterns"/></div><figcaption>02 / THE EXPRESSION <span>Explore print and colour.</span></figcaption></figure></div>
    </header>
    <div class="section-index"><a href="#custom-ranges">01 <span>Choose your format</span> ↓</a><a href="#specification">02 <span>Make it specific</span> ↓</a><a href="#process">03 <span>From brief to production</span> ↓</a></div>
    <section id="custom-ranges" class="ranges">
      <div class="section-heading"><p class="eyebrow">A GOOD PLACE TO START</p><h2>Find your format.<br/>Then make it yours.</h2><p>Two dedicated services to explore. For other food packaging formats, send us your requirements for review.</p></div>
      <div class="service-list"><a href="/design-preview/custom-printed-paper-cups/"><span class="service-number">01</span><div><h3>Custom paper cups</h3><p>Start with cup construction and size.<br/>Then review artwork, print coverage and packing.</p><span class="service-tags">CONSTRUCTION / SIZE / ARTWORK</span></div><span class="service-arrow">↗</span></a><a href="/design-preview/custom-paper-straws/"><span class="service-number">02</span><div><h3>Custom paper straws</h3><p>Plan diameter, length and appearance.<br/>Review printing, wrapping and carton requirements.</p><span class="service-tags">DIAMETER / LENGTH / WRAPPING</span></div><span class="service-arrow">↗</span></a><a class="other-format" href={enquiry}>Working on another format?<span>Tell us what you have in mind ↗</span></a></div>
    </section>
    <section id="specification" class="specification"><div><p class="eyebrow">THE DETAILS MAKE THE DIFFERENCE</p><h2>More than<br/>a logo.</h2><p>A useful brief connects the look of your packaging with how it will be used, packed and supplied.</p><a class="text-link" href="/design-preview/custom-cup-guide/">Read the custom cup guide ↗</a></div><dl>{specifications.map(([title,copy],index)=><div><dt><span>0{index+1}</span>{title}</dt><dd>{copy}</dd></div>)}</dl></section>
    <section id="process" class="process"><div class="process-heading"><div><p class="eyebrow">A CLEAR WAY FORWARD</p><h2>From your brief<br/>to the next serving.</h2></div><p>Agree the details at each stage.<br/>Keep the project moving with a clear specification.</p></div><ol>{steps.map(([title,copy],index)=><li><span class="step-number">0{index+1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></section>
    <section class="project-close"><div><p class="eyebrow">LET’S MAKE IT YOURS</p><h2>A new look starts<br/>with a conversation.</h2><p>Share your product, quantity, artwork needs and destination.<br/>We’ll review the requirements before confirming the next steps.</p></div><div class="close-actions"><a class="project-button" href={enquiry}>Start your project ↗</a><span>Have a reference image or an item number?<br/>Mention it in your enquiry.</span></div></section>
  </div>
</BaseLayout>
<style>
 .branded-picture{position:relative;background:#244936}.product-board .brand-stamp{position:absolute;z-index:1;top:12px;left:12px;width:clamp(42px,4vw,65px);height:auto;aspect-ratio:auto;background:transparent;filter:url(#corncomp-navigation-logo)}.print-study .branded-picture>img:not(.brand-stamp){background:#244936}
 .custom-preview{--forest:#1c3927;--sage:#edf1e7;--muted:#657064;--line:#d4ddcf;max-width:1400px;margin:auto;padding:0 48px 64px;color:var(--forest)}.design-notice{background:#edf1e7;color:#405e42;text-align:center;font-size:11px;padding:8px 16px;letter-spacing:.06em}.crumb{display:flex;gap:12px;font-size:13px;color:#657064;padding:28px 0}.crumb a{text-decoration:none}.studio-hero{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;padding:24px 0 48px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.16em;margin:0 0 22px}.hero-copy h1{font-size:clamp(48px,5.2vw,78px);line-height:1.02;letter-spacing:-.055em;margin:0 0 28px}.hero-copy h1 span{color:#718466}.intro{max-width:450px;font-size:18px;line-height:1.7;color:var(--muted);margin:0 0 30px}.hero-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.project-button{background:var(--forest);color:#f3f1dd;display:inline-flex;align-items:center;justify-content:space-between;gap:32px;min-height:52px;padding:14px 22px;text-decoration:none;font-size:14px;font-weight:700;border-radius:3px}.project-button:hover{background:#36593d}.text-link{font-size:14px;font-weight:700;text-underline-offset:6px}.small-note{font-size:11px;color:var(--muted);margin-top:24px;line-height:1.6}.product-board{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start}.product-board figure{margin:0;min-width:0}.cup-study{padding-top:0}.print-study{padding-top:76px}.product-board img{display:block;width:100%;object-fit:contain;aspect-ratio:3/4;background:#fff}.cup-study img{background:#244936}.product-board figcaption{font-size:10px;letter-spacing:.1em;padding-top:14px}.product-board figcaption span{display:block;font-size:12px;letter-spacing:0;color:var(--muted);margin-top:6px}.section-index{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.section-index a{display:flex;align-items:center;gap:20px;padding:22px 20px;font-size:11px;color:var(--muted);text-decoration:none;border-right:1px solid var(--line)}.section-index a:first-child{padding-left:0}.section-index a:last-child{border:0}.section-index span{font-size:14px;color:var(--forest);flex:1}.ranges{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px;padding:88px 0}.section-heading h2,.specification h2,.process h2,.project-close h2{font-size:clamp(36px,3.5vw,52px);line-height:1.08;letter-spacing:-.04em;margin:0 0 24px}.section-heading>p:last-child,.specification>div>p:not(.eyebrow){font-size:17px;line-height:1.7;color:var(--muted);max-width:360px}.service-list>a{border-top:1px solid var(--line);display:flex;gap:24px;padding:28px 0;text-decoration:none}.service-list h3{font-size:28px;letter-spacing:-.025em;line-height:1.15;margin:0 0 12px}.service-list p{font-size:15px;line-height:1.7;color:var(--muted);margin:0 0 18px}.service-number{font-size:11px;color:#7d8c74;padding-top:6px}.service-arrow{margin-left:auto;font-size:26px;font-weight:400}.service-tags{font-size:9px;letter-spacing:.11em;color:#65765b}.service-list>a:hover h3{text-decoration:underline;text-underline-offset:5px}.service-list .other-format{justify-content:space-between;gap:18px;flex-wrap:wrap;font-size:13px;padding-bottom:0}.other-format span{text-decoration:underline;text-underline-offset:4px}.specification{display:grid;grid-template-columns:1fr 1.1fr;gap:90px;background:var(--sage);padding:56px}.specification .text-link{display:inline-block;margin-top:20px}.specification dl{margin:0}.specification dl>div{border-top:1px solid #cbd6c4;padding:20px 0}.specification dt{display:flex;gap:18px;font-size:19px;font-weight:700}.specification dt span{font-size:10px;color:#6d7c61;padding-top:6px}.specification dd{font-size:15px;line-height:1.6;color:#64705e;margin:10px 0 0 32px}.process{padding:88px 0}.process-heading{display:flex;gap:40px;justify-content:space-between;align-items:end;margin-bottom:36px}.process-heading>p{color:var(--muted);font-size:15px;line-height:1.7;max-width:330px}.process ol{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}.process li{padding:26px 24px 0 0}.process li+li{border-left:1px solid var(--line);padding-left:24px}.step-number{font-size:13px;color:#78896a}.process h3{font-size:20px;margin:32px 0 12px;letter-spacing:-.02em}.process li p{font-size:14px;color:var(--muted);line-height:1.7;margin:0}.project-close{background:#e5eadb;border-top:3px solid #6e8561;padding:50px 56px;display:flex;justify-content:space-between;gap:36px;align-items:center}.project-close p:not(.eyebrow){font-size:15px;line-height:1.7;color:#65705e;margin:0}.close-actions{display:flex;flex-direction:column;gap:18px;flex-shrink:0}.close-actions>span{font-size:11px;color:#65705e;line-height:1.7}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}section{scroll-margin-top:120px}
 @media(max-width:1000px){.custom-preview{padding-inline:28px}.studio-hero{gap:28px}.hero-copy h1{font-size:54px}.intro{font-size:16px}.ranges{gap:48px}.specification{gap:42px;padding:36px}.process h3{font-size:18px}.project-close{padding:36px}.hero-actions{gap:18px}}
 @media(max-width:700px){.custom-preview{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.studio-hero{grid-template-columns:1fr;padding:18px 0 32px;gap:34px}.hero-copy h1{font-size:52px}.eyebrow{margin-bottom:18px;font-size:10px}.intro{font-size:16px}.print-study{padding-top:42px}.product-board img{max-height:300px}.section-index{grid-template-columns:1fr}.section-index a,.section-index a:first-child{padding:16px 0;border:0;border-bottom:1px solid var(--line)}.section-index a:last-child{border:0}.ranges{grid-template-columns:1fr;gap:28px;padding:48px 0}.section-heading h2,.specification h2,.process h2,.project-close h2{font-size:36px}.service-list h3{font-size:26px}.service-list>a{gap:18px}.specification{grid-template-columns:1fr;gap:30px;padding:28px 24px}.process{padding:48px 0}.process-heading{display:block;margin-bottom:24px}.process ol{grid-template-columns:1fr 1fr;gap:26px 0}.process li{padding-right:18px}.process li+li{padding-left:18px}.process li:nth-child(3){border-left:0;padding-left:0}.process h3{margin-top:18px}.project-close{flex-direction:column;align-items:start;padding:30px 24px}.project-close br{display:none}.close-actions{width:100%}.close-actions .project-button{align-self:start}}
</style>
