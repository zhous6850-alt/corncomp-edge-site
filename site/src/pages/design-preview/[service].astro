---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { englishInventory } from '../../lib/localization.mjs';
import mediaInventory from '../../data/media.json';
export function getStaticPaths() {
  return ['custom-printed-paper-cups','custom-paper-straws'].map(service => ({params:{service}}));
}
const cups = Astro.params.service === 'custom-printed-paper-cups';
const title = cups ? 'Custom paper cups' : 'Custom paper straws';
const route = '/custom-packaging/' + Astro.params.service + '/';
const enquiry = '/contact/?' + new URLSearchParams({product:title,category:cups?'Paper Cups':'Paper Straws',source:route}).toString();
const formats = (cups ? [
  ['Single wall','single-wall-kraft-paper-cup','A straightforward format. Review construction against the drink and serving conditions.'],
  ['Double wall','double-wall-kraft-paper-cup','A two-wall format. Confirm the size, artwork area and packing for the selected item.'],
  ['Ripple wall','ripple-natural-kraft-paper-cup-vertical-style','A textured outer wall. Review the surface and available print treatment before artwork.'],
] : [
  ['Small-dot pattern','small-dot-paper-straws','A catalogue pattern reference. Discuss colour and artwork requirements for your project.'],
  ['Large-dot pattern','big-dot-paper-straws','Explore a different pattern scale. Confirm the final design and construction together.'],
  ['Wave pattern','wave-paper-straws','A graphic pattern reference. Review diameter, length and wrapping for the selected straw.'],
]).map(([name,slug,description])=>{
  const product = englishInventory().find(item=>item.type==='product'&&item.slug===slug);
  const image = product.featuredMedia;
  const size = mediaInventory.find(asset=>asset.id===image.id).media_details;
  return {name,description,href:product.route,media:{src:image.localPath,width:size.width,height:size.height,alt:image.alt||name,fit:'contain',position:'center',evidence:'product'}};
});
const checks = cups ? [
  ['Capacity is only the start.','Specify the catalogue item or target capacity, rim diameter and height. A volume label alone does not establish lid fit.'],
  ['Match the complete set.','Identify the exact lid, sleeve or accessory required. Matching components need confirmation for the selected cup.'],
  ['Design for the surface.','Share editable artwork, colour references, print coverage and required legal marks. Confirm the print area before final artwork.'],
  ['Agree the finished pack.','Include quantity, sleeve or inner packing, carton requirements and destination in the brief.'],
] : [
  ['Diameter & length','Start with the beverage, cup height and lid opening. Confirm both dimensions rather than choosing by appearance alone.'],
  ['Colour & artwork','Provide a pattern reference or editable artwork, colour requirements and print direction for review.'],
  ['Individual wrapping','Tell us whether individual wrapping is required and share wrapper artwork or identification needs.'],
  ['Outer packing & destination','Specify quantity, inner packs, cartons and destination. Confirm construction and any required test-report scope.'],
];
const schema = [
 {'@context':'https://schema.org','@type':'WebPage','@id':'https://corn-comp.com'+route+'#webpage',name:title,url:'https://corn-comp.com'+route,about:{'@id':'https://corn-comp.com/#organization'}},
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:'https://corn-comp.com/'},{'@type':'ListItem',position:2,name:'Custom Packaging',item:'https://corn-comp.com/custom-packaging/'},{'@type':'ListItem',position:3,name:title,item:'https://corn-comp.com'+route}]}
];
---
<BaseLayout title={title+' — Design Preview | Corncomp'} description={cups?'Plan cup construction, size, artwork and packing with Corncomp.':'Plan paper straw dimensions, patterns, wrapping and packing with Corncomp.'} pathname={route} bodyClass="architecture-site" structuredData={schema}>
 <div class="preview-note">DESIGN PREVIEW · {cups?'纸杯':'纸吸管'}定制服务设计预览 · 正式站未修改</div>
 <div class:list={['service-preview',cups?'cup-service':'straw-service']}>
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/design-preview/custom-packaging/">Custom Packaging</a><span>/ {title}</span></nav>
 <header class="service-hero"><div><p class="eyebrow">CORNCOMP / {cups?'YOUR CUP, YOUR WAY':'SMALL DETAIL. DISTINCTIVE LOOK.'}</p><h1>{cups?<>A cup that<br/>carries <em>your brand.</em></>:<>A finishing touch.<br/><em>Made yours.</em></>}</h1><p class="hero-intro">{cups?'Start with what you serve. Choose a cup construction, then bring the size, artwork and packing details together.':'From the first sip to the last detail. Plan the dimensions, print and wrapping around your drink and your brand.'}</p><a class="project-button" href={enquiry}>Plan your {cups?'cup':'straw'} project <span>↗</span></a></div><aside class="project-sheet"><p class="eyebrow">{cups?'THE CUP PROJECT':'THE STRAW PROJECT'}</p><h2>{cups?'The right base.\nA considered finish.':'Size. Pattern.\nPresentation.'}</h2><dl>{(cups?[['01','Construction','Single / double / ripple wall'],['02','Dimensions','Capacity / rim / height'],['03','Brand details','Artwork / colour / packing']]:[['01','Dimensions','Diameter / length'],['02','Appearance','Colour / pattern / print'],['03','Presentation','Wrapping / inner pack / carton']]).map(([n,label,value])=><div><dt><span>{n}</span>{label}</dt><dd>{value}</dd></div>)}</dl><p class="sheet-foot">A project brief, not a final specification.<br/>Details are confirmed for the selected order.</p></aside></header>
 <nav class="section-nav" aria-label="On this page"><a href="#formats">Explore {cups?'cup formats':'patterns'} ↓</a><a href="#details">The details to confirm ↓</a><a href="#artwork">Prepare your brief ↓</a></nav>
 <section id="formats" class="formats"><div class="section-heading"><div><p class="eyebrow">{cups?'CHOOSE YOUR CONSTRUCTION':'FIND A VISUAL DIRECTION'}</p><h2>{cups?'Start with the cup.':'A little pattern.\nA lot of character.'}</h2></div><p>{cups?'Compare base formats before developing the artwork. Images show catalogue products, not your final printed design.':'Use these catalogue patterns as a starting point. Custom artwork, colours and dimensions are reviewed for each project.'}</p></div><div class="format-grid">{formats.map(format=><article><a class="format-image" href={format.href} aria-label={'View '+format.name}><ResponsiveMedia media={format.media}/></a><div class="format-copy"><h3>{format.name}</h3><p>{format.description}</p><a href={format.href}>View catalogue product ↗</a></div></article>)}</div></section>
 <section id="details" class="details"><div><p class="eyebrow">{cups?'FIT BEFORE PRINT':'BUILT AROUND THE DRINK'}</p><h2>{cups?'Good design\nstarts with fit.':'Make every\ndetail count.'}</h2><p>{cups?'Treat the cup, lid and artwork as one project. Confirm the physical details before committing to the design.':'The right appearance is only part of the brief. Define how the straw will be used, wrapped and supplied.'}</p><a href={cups?'/resources/guides/paper-cup-sizes/':'/products/foodservice-supplies/paper-straws/'}>{cups?'Read the cup sizes guide':'Browse the straw range'} ↗</a></div><dl>{checks.map(([name,description],index)=><div><dt><span>0{index+1}</span>{name}</dt><dd>{description}</dd></div>)}</dl></section>
 <section id="artwork" class="brief"><div><p class="eyebrow">FROM IDEA TO APPROVAL</p><h2>Bring the idea.<br/>Let’s work through the details.</h2></div><ol><li><span>01 / YOUR INPUT</span><h3>Share a useful brief.</h3><p>{cups?'Cup type, size or item reference, quantity, artwork, required accessories and destination.':'Diameter, length, quantity, design reference, wrapping requirements and destination.'}</p></li><li><span>02 / JOINT REVIEW</span><h3>Review before approval.</h3><p>Agree the construction, print requirements and sample type. Production follows the files and specification approved for the order.</p></li><li><span>03 / NEXT STEPS</span><h3>Confirm the complete scope.</h3><p>MOQ, pricing, packing, documents and timing are confirmed against the final requirements, not assumed from a reference image.</p></li></ol></section>
 <section class="enquiry-band"><div><p class="eyebrow">YOUR NEXT {cups?'CUP':'STRAW'} PROJECT</p><h2>Let’s make it yours.</h2><p>Share what you have. We’ll review what still needs to be defined.</p></div><div><a class="project-button" href={enquiry}>Start your project ↗</a><a class="back-link" href="/design-preview/custom-packaging/">← All custom packaging</a></div></section>
 </div>
</BaseLayout>
<style>
 .service-preview{--ink:#1c3927;--muted:#657064;--line:#d4ddcf;--tint:#edf1e7;max-width:1400px;margin:auto;padding:0 48px 64px;color:var(--ink)}.straw-service{--tint:#f0eddf}.preview-note{background:#edf1e7;color:#405e42;text-align:center;padding:8px 16px;font-size:11px;letter-spacing:.05em}.crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--muted);padding:28px 0}.crumb a{text-decoration:none}.service-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:64px;align-items:center;padding:32px 0 56px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.15em;margin:0 0 20px}.service-hero h1{font-size:clamp(46px,5vw,72px);line-height:1.04;letter-spacing:-.05em;margin:0 0 24px}.service-hero em{font-style:normal;color:#718466}.hero-intro{font-size:18px;line-height:1.7;color:var(--muted);max-width:500px;margin:0 0 30px}.project-button{display:inline-flex;gap:32px;justify-content:space-between;align-items:center;background:var(--ink);color:#f3f1dd;min-height:52px;padding:14px 22px;font-size:14px;font-weight:700;text-decoration:none;border-radius:3px}.project-button:hover{background:#36593d}.project-sheet{background:var(--tint);border-top:3px solid #7b8c68;padding:30px 32px}.project-sheet h2{font-size:32px;line-height:1.12;letter-spacing:-.03em;white-space:pre-line;margin:0 0 24px}.project-sheet dl{margin:0}.project-sheet dl>div{border-top:1px solid #cfd6c6;padding:15px 0}.project-sheet dt{font-size:14px;font-weight:700;display:flex;gap:18px}.project-sheet dt span{font-size:10px;color:#7e8b71}.project-sheet dd{font-size:13px;color:var(--muted);margin:7px 0 0 31px}.sheet-foot{font-size:11px;line-height:1.7;color:var(--muted);margin:12px 0 0}.section-nav{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.section-nav a{font-size:14px;text-decoration:none;padding:20px;border-right:1px solid var(--line)}.section-nav a:first-child{padding-left:0}.section-nav a:last-child{border:0}.formats{padding:72px 0}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:30px}.section-heading h2,.details h2,.brief h2,.enquiry-band h2{font-size:clamp(34px,3.5vw,48px);line-height:1.1;letter-spacing:-.04em;white-space:pre-line;margin:0 0 20px}.section-heading>p{max-width:370px;font-size:15px;line-height:1.7;color:var(--muted)}.format-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.format-grid article{border:1px solid var(--line)}.format-image{display:block;background:#fff}.format-image :global(img){width:100%;height:300px;object-fit:contain;display:block}.format-copy{padding:24px}.format-copy h3{font-size:25px;letter-spacing:-.03em;margin:0 0 12px}.format-copy p{color:var(--muted);font-size:14px;line-height:1.7;margin:0 0 20px}.format-copy a,.details a{font-size:13px;font-weight:700;text-underline-offset:5px}.details{background:var(--tint);display:grid;grid-template-columns:1fr 1.15fr;gap:70px;padding:48px}.details>div>p:not(.eyebrow){font-size:16px;line-height:1.7;color:var(--muted);max-width:350px;margin-bottom:26px}.details dl{margin:0}.details dl>div{border-top:1px solid #cad3c2;padding:20px 0}.details dt{display:flex;gap:16px;font-size:19px;font-weight:700}.details dt span{font-size:10px;padding-top:5px;color:#78876c}.details dd{font-size:14px;line-height:1.7;color:var(--muted);margin:10px 0 0 30px}.brief{padding:72px 0}.brief ol{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);padding:0;margin:34px 0 0;border-top:1px solid var(--line)}.brief li{padding:26px 26px 0 0}.brief li+li{border-left:1px solid var(--line);padding-left:26px}.brief li>span{font-size:10px;letter-spacing:.1em;color:#718466}.brief h3{font-size:22px;letter-spacing:-.025em;margin:24px 0 12px}.brief li p{font-size:15px;line-height:1.7;color:var(--muted);margin:0}.enquiry-band{padding:40px 48px;background:#e5eadb;border-top:3px solid #7b8c68;display:flex;align-items:center;justify-content:space-between;gap:36px}.enquiry-band h2{margin-bottom:14px}.enquiry-band p:not(.eyebrow){font-size:15px;color:var(--muted);line-height:1.7;margin:0}.enquiry-band>div:last-child{display:flex;flex-direction:column;gap:20px;align-items:start;flex-shrink:0}.back-link{font-size:12px;text-underline-offset:4px}section{scroll-margin-top:120px}a:focus-visible{outline:3px solid #7b945e;outline-offset:5px}
 @media(max-width:950px){.service-preview{padding-inline:28px}.service-hero{gap:30px}.service-hero h1{font-size:52px}.project-sheet{padding:24px}.project-sheet h2{font-size:28px}.details{padding:32px;gap:36px}.format-image :global(img){height:240px}.format-copy{padding:20px}.format-copy h3{font-size:22px}.enquiry-band{padding:32px}}
 @media(max-width:650px){.service-preview{padding:0 20px 36px}.crumb{font-size:12px;padding:20px 0}.service-hero{grid-template-columns:1fr;padding:20px 0 32px;gap:32px}.service-hero h1{font-size:48px}.hero-intro{font-size:16px}.eyebrow{font-size:10px}.section-nav{grid-template-columns:1fr}.section-nav a,.section-nav a:first-child{padding:15px 0;border:0;border-bottom:1px solid var(--line)}.section-nav a:last-child{border:0}.formats,.brief{padding:44px 0}.section-heading{display:block;margin-bottom:24px}.section-heading h2,.details h2,.brief h2,.enquiry-band h2{font-size:34px}.format-grid{grid-template-columns:1fr;gap:20px}.format-image :global(img){height:290px}.details{grid-template-columns:1fr;padding:28px 24px;gap:28px}.brief ol{grid-template-columns:1fr;margin-top:25px}.brief li,.brief li+li{padding:24px 0;border-left:0;border-bottom:1px solid var(--line)}.brief h3{margin-top:16px}.enquiry-band{flex-direction:column;align-items:start;padding:28px 24px}.preview-note{font-size:10px}}
</style>
