---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { englishInventory } from '../../lib/localization.mjs';
import mediaInventory from '../../data/media.json';
const inventory = englishInventory();
const ranges = [
  { title: 'Paper Cups', slug: 'double-wall-white-cardboard-paper-cup', href: '/design-preview/paper-cups/', use: 'FOR YOUR DRINKS', description: 'Single-wall, double-wall and ripple-wall formats. Find your cup, then review lids and sleeves.', tags: ['Single wall', 'Double wall', 'Ripple wall'] },
  { title: 'Salad Bowls', slug: 'kraft-paper-bowl', href: '/design-preview/salad-bowls/', use: 'FOR FRESH MEALS', description: 'Kraft and white cardboard bowls. Choose the base first, then explore the matching lid options.', tags: ['Kraft', 'White cardboard', 'Lid options'] },
  { title: 'Soup Cups', slug: 'natural-kraft-soup-cup', href: '/design-preview/soup-cups/', use: 'FOR SOUPS & SIDES', description: 'Explore kraft, cardboard and bagasse cup series, with lids listed separately for comparison.', tags: ['Kraft', 'Cardboard', 'Bagasse'] },
  { title: 'Ice Cream Cups', slug: 'cardboard-ice-cream-cup', href: '/design-preview/ice-cream-cups/', use: 'FOR DESSERTS', description: 'Paper cup formats for ice cream and desserts. Review the available series and catalogue sizes.', tags: ['Kraft', 'Cardboard', 'Catalogue sizes'] },
].map((range) => {
  const product = inventory.find((item) => item.type === 'product' && item.slug === range.slug);
  const image = product.featuredMedia;
  const dimensions = mediaInventory.find((asset) => asset.id === image.id).media_details;
  return { ...range, media: { src: image.localPath, width: dimensions.width, height: dimensions.height, alt: image.alt, fit: 'contain', position: 'center', evidence: 'product' } };
});
---
<BaseLayout title="Cups & Bowls — Design Preview | Corncomp" pathname="/products/cups-bowls/" bodyClass="architecture-site">
  <div class="preview-strip">DESIGN PREVIEW · 杯碗大类页设计预览 · 正式站未修改</div>
  <div class="group-preview">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/ Cups &amp; Bowls</span></nav>
    <header class="group-heading"><p class="kicker">THE CORNCOMP RANGE</p><h1>Cups &amp; Bowls<span>For every serving.</span></h1><div class="heading-bottom"><p>Drinks, fresh meals, soups or desserts.<br />Start with what you serve. Find the format that fits.</p><a href="/media/wp/231-corncomp-catalogue.pdf">View catalogue ↗</a></div></header>
    <nav class="quick-nav" aria-label="Choose a category">{ranges.map((range, index) => <a href={`#range-${index}`}><span>0{index + 1}</span>{range.title}<b>↓</b></a>)}</nav>
    <section class="range-grid" aria-label="Cup and bowl categories">{ranges.map((range, index) => <article id={`range-${index}`} class="range-card">
      <a class="range-picture" href={range.href} aria-label={`Explore ${range.title}`}><ResponsiveMedia media={range.media} eager={index < 2} /></a>
      <div class="range-copy"><p class="kicker">{range.use}</p><h2><a href={range.href}>{range.title}</a></h2><p class="description">{range.description}</p><ul>{range.tags.map((tag) => <li>{tag}</li>)}</ul><a class="explore" href={range.href}>Explore {range.title.toLowerCase()} <span>↗</span></a></div>
    </article>)}</section>
    <aside class="custom-band"><div><p class="kicker">MAKE IT YOURS</p><h2>Your format. Your brand.</h2><p>Need custom printing or help choosing matching components?<br />Share your product, quantity and destination.</p></div><div class="custom-actions"><a class="quote" href="/contact/?category=Cups%20%26%20Bowls&source=%2Fproducts%2Fcups-bowls%2F">Request a quote ↗</a><a href="/custom-packaging/">Explore custom packaging ↗</a></div></aside>
    <p class="preview-help">预览说明：四个分类均可进入新版细分类预览；具体产品仍链接现有详情页。</p>
  </div>
</BaseLayout>
<style>
  .group-preview{--ink:#1c3927;--muted:#617065;--line:#dce3da;max-width:1320px;padding:0 36px 64px;margin:auto;color:var(--ink)}
  .preview-strip{background:#e9efdf;color:#35503b;text-align:center;padding:8px 16px;font-size:12px;letter-spacing:.06em}.crumb{display:flex;flex-wrap:wrap;gap:12px;padding:27px 0;color:var(--muted);font-size:14px}.crumb a{text-decoration:none}
  .group-heading{padding:22px 0 32px}.kicker{font-size:11px;letter-spacing:.15em;font-weight:700;margin:0 0 14px}.group-heading h1{font-size:clamp(44px,5vw,68px);letter-spacing:-.045em;line-height:1.06;margin:0}.group-heading h1 span{display:inline-block;color:#65815b;font-size:.66em;margin-left:28px;letter-spacing:-.035em}.heading-bottom{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-top:22px}.heading-bottom p{font-size:18px;line-height:1.6;margin:0;color:var(--muted)}.heading-bottom>a{font-size:15px;font-weight:700;text-underline-offset:5px;white-space:nowrap}
  .quick-nav{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);margin-bottom:32px}.quick-nav a{display:flex;gap:14px;align-items:center;text-decoration:none;padding:19px 18px;border-inline-end:1px solid var(--line);font-size:15px;font-weight:700}.quick-nav a:first-child{padding-inline-start:0}.quick-nav a:last-child{border:0}.quick-nav span{font-size:11px;color:#7a8a71;font-weight:400}.quick-nav b{margin-inline-start:auto;font-weight:400}
  .range-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.range-card{border:1px solid var(--line);background:#fff;scroll-margin-top:128px;overflow:hidden}.range-picture{display:block;background:#fff}.range-picture :global(img){display:block;width:100%;height:290px;object-fit:contain}.range-copy{padding:25px 28px 22px}.range-copy .kicker{color:#6a7d60;margin-bottom:9px}.range-copy h2{font-size:32px;letter-spacing:-.035em;margin:0 0 12px;line-height:1.1}.range-copy h2 a{text-decoration:none}.description{color:var(--muted);font-size:16px;line-height:1.6;margin:0;max-width:480px}.range-copy ul{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:0;margin:18px 0 22px;color:#586c51;font-size:12px}.range-copy li+li:before{content:' / ';white-space:pre;color:#9ba693;margin:0 10px}.explore{display:flex;justify-content:space-between;min-height:44px;align-items:center;border-top:1px solid var(--line);padding-top:15px;text-decoration:none;font-size:15px;font-weight:700}
  .custom-band{display:flex;align-items:center;justify-content:space-between;gap:40px;background:#e8efdf;padding:36px 40px;margin-top:38px}.custom-band h2{font-size:34px;letter-spacing:-.035em;line-height:1.1;margin:0 0 13px}.custom-band p:not(.kicker){font-size:16px;line-height:1.6;color:var(--muted);margin:0}.custom-actions{display:flex;flex-direction:column;align-items:center;gap:18px;flex-shrink:0;font-size:14px;font-weight:700}.quote{background:var(--ink);color:#fffdf8;padding:16px 25px;text-decoration:none}.preview-help{font-size:12px;color:var(--muted);margin-top:20px}a:hover{text-decoration:underline;text-underline-offset:4px}a:focus-visible{outline:3px solid #71935e;outline-offset:4px}
  @media(max-width:900px){.group-heading h1 span{display:block;margin:12px 0 0}.quick-nav a{padding:17px 12px;gap:8px;font-size:13px}.range-picture :global(img){height:240px}.range-copy{padding:22px}.custom-band{padding:30px}}
  @media(max-width:600px){.group-preview{padding:0 18px 40px}.preview-strip{font-size:10px}.crumb{font-size:12px;padding:20px 0}.group-heading{padding-top:10px}.group-heading h1{font-size:44px}.heading-bottom{align-items:start;flex-direction:column;gap:17px}.heading-bottom p{font-size:16px}.quick-nav{grid-template-columns:1fr 1fr;gap:0;margin-bottom:22px}.quick-nav a,.quick-nav a:first-child{padding:15px 10px}.quick-nav a:nth-child(2){border-inline-end:0}.quick-nav a:nth-child(-n+2){border-bottom:1px solid var(--line)}.range-grid{grid-template-columns:1fr;gap:22px}.range-picture :global(img){height:260px}.range-copy h2{font-size:29px}.custom-band{flex-direction:column;align-items:start;gap:25px;padding:28px}.custom-band h2{font-size:29px}.custom-band br{display:none}.custom-actions{align-items:start}.preview-help{line-height:1.7}}
</style>
