---
import BaseLayout from '../layouts/BaseLayout.astro';
import categories from '../data/categories.json';
import records from '../data/records.json';
import { categoryLanguage, contentPath, contentTitle, localizeInternalLinks } from '../lib/content-routes.mjs';
import { categoryIdsByLanguage, navigationFor } from '../lib/site-config.mjs';

export function getStaticPaths() {
  const contentPaths = records.filter((record) => !['/cart/', '/checkout/', '/my-account/'].includes(record.route)).filter((record) => contentPath(record.route) !== null).map((record) => ({ params: { path: contentPath(record.route) }, props: { record } }));
  const allProducts = records.filter((record) => record.type === 'product');
  const categoryPaths = categories.map((category) => {
    const products = allProducts.filter((product) => product.categoryIds.includes(category.id));
    return { params: { path: contentPath(category.route) }, props: { category, products, language: categoryLanguage(products) } };
  });
  const archivePaths = ['fr', 'es', 'ar'].flatMap((language) => [
    { params: { path: `${language}/shop` }, props: { archive: 'shop', language } },
    { params: { path: `${language}/blog` }, props: { archive: 'blog', language } },
  ]);
  return [...contentPaths, ...categoryPaths, ...archivePaths];
}

const { record, category, products = [], language = 'en', archive } = Astro.props;
const currentLanguage = record?.language || language;
const isShop = record?.route === '/shop/' || archive === 'shop';
const isBlog = record?.route === '/blog/' || archive === 'blog';
const isInquiryPage = record?.body.includes('corncomp-inquiry-form');
const shopCategories = isShop ? categoryIdsByLanguage[currentLanguage].map((id) => {
  const item = categories.find((category) => category.id === id);
  const categoryProducts = item ? records.filter((product) => product.type === 'product' && product.language === currentLanguage && product.categoryIds.includes(item.id)) : [];
  return { ...item, products: categoryProducts, image: categoryProducts.find((product) => product.featuredMedia)?.featuredMedia };
}).filter((item) => item.route) : [];
const insightPosts = isBlog ? records.filter((item) => item.type === 'post' && item.language === currentLanguage) : [];
const recordCategories = record?.type === 'product' ? categories.filter((item) => record.categoryIds.includes(item.id)) : [];
const relatedProducts = record?.type === 'product' ? records.filter((item) => item.type === 'product' && item.id !== record.id && item.language === record.language && item.categoryIds.some((id) => record.categoryIds.includes(id))).slice(0, 4) : [];
const bodyHtml = localizeInternalLinks(record?.body || '');
const copy = {
  en: { shop: ['Product', 'Browse our full range by category below.', 'Categories', 'Products'], blog: 'Blog', home: 'Home', related: 'Related Products', sent: 'Thank you. Your inquiry has been sent successfully.' },
  fr: { shop: ['Produits', 'Parcourez notre gamme complète par catégorie.', 'Catégories', 'Produits'], blog: 'Blog', home: 'Accueil', related: 'Produits associés', sent: 'Merci. Votre demande a bien été envoyée.' },
  es: { shop: ['Productos', 'Explore nuestra gama completa por categoría.', 'Categorías', 'Productos'], blog: 'Blog', home: 'Inicio', related: 'Productos relacionados', sent: 'Gracias. Su consulta se ha enviado correctamente.' },
  ar: { shop: ['المنتجات', 'تصفح مجموعتنا الكاملة حسب الفئة.', 'الفئات', 'منتجات'], blog: 'المدونة', home: 'الرئيسية', related: 'منتجات ذات صلة', sent: 'شكرًا لك. تم إرسال استفسارك بنجاح.' },
}[currentLanguage];
const nav = navigationFor(currentLanguage);
const pageTitle = record ? contentTitle(record) : `${archive === 'shop' ? copy.shop[0] : copy.blog} | Corncomp`;
const pagePath = record?.route || `/${currentLanguage}/${archive}/`;
const structuredData = record?.type === 'product' ? {
  '@context': 'https://schema.org', '@type': 'Product', name: record.title.replace(/<[^>]+>/g, ''), url: `https://corn-comp.com${record.route}`,
  image: record.featuredMedia ? new URL(record.featuredMedia.localPath, 'https://corn-comp.com').href : undefined,
  description: (record.seo.description || record.excerpt || '').replace(/<[^>]+>/g, '').trim(),
  category: recordCategories.map((item) => item.name).join(', '), brand: { '@type': 'Brand', name: 'Corncomp' },
} : undefined;
---
{record || archive ? (
  <BaseLayout title={pageTitle} description={record?.seo.description || ''} language={currentLanguage} pathname={pagePath} image={record?.featuredMedia?.localPath} structuredData={structuredData}>
    <article class:list={['content-shell', `content-${record?.type || archive}`, { 'has-inquiry-form': isInquiryPage }]}>
      {record?.type === 'product' ? (
        <>
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={nav.home[1]}>{copy.home}</a><span>/</span><a href={nav.product[1]}>{nav.product[0]}</a><span>/</span><span set:html={record.title} /></nav>
          <div class="product-lead">
            <header class="content-heading product-summary"><p class="content-kind">Product</p><h1 set:html={record.title} />{record.excerpt && <div class="product-excerpt" set:html={localizeInternalLinks(record.excerpt)} />}{recordCategories.length > 0 && <p class="product-categories">{recordCategories.map((item) => <a href={item.route} set:html={item.name} />)}</p>}</header>
            {record.featuredMedia && <figure class="featured-media product-media"><img src={record.featuredMedia.localPath} alt={record.featuredMedia.alt} loading="eager" decoding="async"></figure>}
          </div>
          <div class="wordpress-content" set:html={bodyHtml} />
          {relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-title"><h2 id="related-title">{copy.related}</h2><div class="product-grid">{relatedProducts.map((product) => <article class="product-card"><a href={product.route}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt} loading="lazy" decoding="async" />}<h3 set:html={product.title} /></a></article>)}</div></section>}
        </>
      ) : isShop ? (
        <section class="shop-archive" aria-labelledby="shop-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="shop-title" set:html={record?.title || copy.shop[0]} /><p>{copy.shop[1]}</p></header><div class="shop-directory"><aside class="shop-category-list" aria-label="Product categories"><h2>{copy.shop[2]}</h2><ul>{shopCategories.map((item) => <li><a href={item.route} set:html={item.name} /></li>)}</ul></aside><div class="shop-category-grid">{shopCategories.map((item) => <article class="shop-category-card"><a href={item.route}>{item.image && <img src={item.image.localPath} alt={item.name} loading="lazy" decoding="async" />}<div><h2 set:html={item.name} /><p>{item.products.length} {copy.shop[3]}</p></div></a></article>)}</div></div>{record && <div class="wordpress-content archive-source" set:html={bodyHtml} />}</section>
      ) : isBlog ? (
        <section class="insight-archive" aria-labelledby="blog-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="blog-title" set:html={record?.title || copy.blog} /></header><div class="insight-grid">{insightPosts.map((post) => <article class="insight-card"><a href={post.route}>{post.featuredMedia && <img src={post.featuredMedia.localPath} alt={post.featuredMedia.alt} loading="lazy" decoding="async" />}<div><p class="content-kind">Insight</p><h2 set:html={post.title} /></div></a></article>)}</div>{record && <div class="wordpress-content archive-source" set:html={bodyHtml} />}</section>
      ) : isInquiryPage ? (
        <div class="contact-layout"><header class="content-heading"><p class="content-kind">Corncomp</p><h1 set:html={record.title} /></header><div><p id="inquiry-sent" class="inquiry-success" role="status">{copy.sent}</p><div class="wordpress-content" set:html={bodyHtml} /></div></div>
      ) : (
        <><header class="content-heading"><p class="content-kind">{record.type === 'post' ? 'Insight' : 'Corncomp'}</p><h1 set:html={record.title} /></header>{record.featuredMedia && <figure class="featured-media"><img src={record.featuredMedia.localPath} alt={record.featuredMedia.alt} loading="eager" decoding="async"></figure>}<div class="wordpress-content" set:html={bodyHtml} /></>
      )}
    </article>
  </BaseLayout>
) : (
  <BaseLayout title={category.seo.title} description={category.seo.description} language={language} pathname={category.route}>
    <section class="content-shell category-archive" aria-labelledby="category-title"><header class="content-heading"><p class="content-kind">Product category</p><h1 id="category-title" set:html={category.name} />{category.description && <div set:html={localizeInternalLinks(category.description)} />}</header><div class="product-grid">{products.map((product) => <article class="product-card"><a href={product.route}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt} loading="lazy" decoding="async" />}<h2 set:html={product.title} /></a></article>)}</div></section>
  </BaseLayout>
)}
