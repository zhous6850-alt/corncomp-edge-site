---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import PageHero from '../components/PageHero.astro';
import EditorialCard from '../components/EditorialCard.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import { mediaFor } from '../lib/visual-media.mjs';
import { companyCertificates, supplyChainDocuments } from '../data/certificates.mjs';
import { contentDescription, contentPath, contentText, contentTitle, localizeInternalLinks, normalizeBodyHeadings } from '../lib/content-routes.mjs';
import { allLocalizedEntries, contentKeyForArchitecture, englishInventory, localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';
import { extractProductFacts, localizedProductBody } from '../lib/product-facts.mjs';
import { PRODUCT_CATEGORIES, PRODUCT_GROUPS, categoryForProduct } from '../lib/site-architecture.mjs';

export function getStaticPaths() {
  const archiveRoutes = [['en', 'blog', '/blog/'], ['fr', 'blog', '/fr/blog/'], ['es', 'blog', '/es/blog/'], ['ar', 'blog', '/ar/blog/']];
  const pages = allLocalizedEntries().filter(({ language, contentKey }) => language !== 'en' || contentKey !== 'home').map(({ language, contentKey, route }) => ({ params: { path: contentPath(route) }, props: { language, contentKey } }));
  return [...pages, ...archiveRoutes.map(([language, archive, route]) => ({ params: { path: contentPath(route) }, props: { language, archive } }))];
}

const archiveRoutes = [['en', 'blog', '/blog/'], ['fr', 'blog', '/fr/blog/'], ['es', 'blog', '/es/blog/'], ['ar', 'blog', '/ar/blog/']];

const { language = 'en', contentKey, archive } = Astro.props;
const inventory = englishInventory();
const source = contentKey ? inventory.find((item) => item.contentKey === contentKey) : null;
const entry = contentKey ? localizedEntry(language, contentKey) : null;
const ui = uiFor(language);
const localized = language !== 'en';
const architecture = source?.type === 'architecture' ? source : null;
const product = source?.type === 'product' ? source : null;
const post = source?.type === 'post' ? source : null;
const page = architecture ? entry : null;
const text = {
  en: ['Home','Products','Blog','Insight','Primary sources','Check the official record','Open page','Prepared by','Last reviewed:','Product category','Corncomp product range','Sourcing guidance','Built for B2B sourcing','View products','Explore categories','Thank you. Your inquiry has been sent successfully.','Name','Business email','Company','Country / market','Phone / WhatsApp','Estimated quantity','Product or format','Item / SKU','Category','Requirements','Send inquiry','Browse our full range by category below.'],
  fr: ['Accueil','Produits','Conseils sur les emballages','Article','Sources principales','Consulter les sources officielles','Ouvrir la page','Préparé par','Dernière révision :','Catégorie de produits','Gamme de produits Corncomp','Conseils d’approvisionnement','Conçu pour l’approvisionnement B2B','Voir les produits','Explorer les catégories','Merci. Votre demande a bien été envoyée.','Nom','E-mail professionnel','Entreprise','Pays / marché','Téléphone / WhatsApp','Quantité estimée','Produit ou format','Article / référence','Catégorie','Besoins','Envoyer la demande','Parcourez notre gamme complète par catégorie.'],
  es: ['Inicio','Productos','Guías de envases','Artículo','Fuentes principales','Consultar las fuentes oficiales','Abrir página','Preparado por','Última revisión:','Categoría de productos','Gama de productos Corncomp','Orientación de compra','Creado para compras B2B','Ver productos','Explorar categorías','Gracias. Su consulta se ha enviado correctamente.','Nombre','Correo electrónico profesional','Empresa','País / mercado','Teléfono / WhatsApp','Cantidad estimada','Producto o formato','Artículo / referencia','Categoría','Requisitos','Enviar consulta','Explore nuestra gama completa por categoría.'],
  ar: ['الرئيسية','المنتجات','دليل التغليف المستدام','مقال','المصادر الرئيسية','راجع السجل الرسمي','فتح الصفحة','إعداد','آخر مراجعة:','فئة المنتجات','مجموعة منتجات Corncomp','إرشادات التوريد','معدّ للتوريد بين الشركات','عرض المنتجات','استكشاف الفئات','شكرًا لك. تم إرسال استفسارك بنجاح.','الاسم','البريد الإلكتروني للعمل','الشركة','الدولة / السوق','الهاتف / WhatsApp','الكمية التقديرية','المنتج أو الشكل','الصنف / الرمز','الفئة','المتطلبات','إرسال الاستفسار','تصفح مجموعتنا الكاملة حسب الفئة.'],
}[language];
const [homeLabel, productsLabel, blogLabel, insightLabel, sourcesLabel, officialLabel, openLabel, preparedLabel, reviewedLabel, categoryLabel, rangeLabel, sourcingLabel, b2bLabel, viewLabel, exploreLabel, sentLabel, nameLabel, emailLabel, companyLabel, countryLabel, phoneLabel, quantityLabel, productLabel, skuLabel, categoryFormLabel, requirementsLabel, sendLabel, shopIntro] = text;
const architectureKey = (route) => contentKeyForArchitecture({ route });
const localizedArchitecture = (route) => localizedEntry(language, architectureKey(route));
const productCategory = product ? categoryForProduct(product.slug) : null;
const categoryPage = productCategory ? localizedArchitecture(productCategory.route) : null;
const productGroup = productCategory ? PRODUCT_GROUPS.find((item) => item.slug === productCategory.group) : null;
const groupPage = productGroup ? localizedArchitecture(productGroup.route) : null;
const architectureCategory = architecture?.kind === 'product-category' ? PRODUCT_CATEGORIES.find((item) => item.route === architecture.route) : null;
const architectureGroup = architecture?.kind === 'product-group' ? PRODUCT_GROUPS.find((item) => item.route === architecture.route) : architectureCategory ? PRODUCT_GROUPS.find((item) => item.slug === architectureCategory.group) : null;
const architectureProducts = architectureCategory ? inventory.filter((item) => item.type === 'product' && categoryForProduct(item.slug)?.slug === architectureCategory.slug) : [];
const groupCategories = architectureGroup ? PRODUCT_CATEGORIES.filter((item) => item.group === architectureGroup.slug) : [];
const relatedProducts = product ? inventory.filter((item) => item.type === 'product' && item.contentKey !== product.contentKey && categoryForProduct(item.slug)?.slug === productCategory.slug).slice(0, 4) : [];
const facts = product ? extractProductFacts(product) : null;
const displayFacts = facts ? { ...facts, tables: facts.tables.map(({ headers, rows }) => ({ headers, rows: rows.map((row) => row.map((cell) => ui.specificationValues?.[cell] || cell)) })) } : null;
const productHtml = product ? (localized ? localizedProductBody(entry, displayFacts, ui) : product.body) : '';
const bodyHtml = product ? normalizeBodyHeadings(localizeInternalLinks(productHtml, language, entry.route)) : post ? normalizeBodyHeadings(localizeInternalLinks(localized ? entry.bodyHtml : post.body, language, entry.route)) : '';
const itemCodes = facts?.itemCodes || [];
const contactRoute = routeFor(language, 'architecture:contact');
const quoteHref = entry ? `${contactRoute}?${new URLSearchParams({ product: contentText(entry.title), sku: itemCodes.length === 1 ? itemCodes[0] : '', category: categoryPage?.title || '', source: entry.route }).toString()}` : contactRoute;
const breadcrumbs = entry ? [[homeLabel, routeFor(language, 'home')], ...(product ? [[productsLabel, routeFor(language, 'architecture:products')], [groupPage.title, groupPage.route], [categoryPage.title, categoryPage.route]] : post ? [[blogLabel, language === 'en' ? '/blog/' : `/${language}/blog/`]] : architecture?.kind?.startsWith('product-') ? [[productsLabel, routeFor(language, 'architecture:products')]] : []), [entry.title, entry.route]] : [];
const breadcrumbSchema = breadcrumbs.length > 1 ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map(([name, route], index) => ({ '@type': 'ListItem', position: index + 1, name: contentText(name), item: `https://corn-comp.com${route}` })) } : null;
const productSchema = product ? { '@context': 'https://schema.org', '@type': 'Product', name: contentText(entry.title), url: `https://corn-comp.com${entry.route}`, image: product.featuredMedia ? new URL(product.featuredMedia.localPath, 'https://corn-comp.com').href : undefined, description: localized ? entry.description : contentDescription(product), category: categoryPage.title, brand: { '@type': 'Brand', name: 'Corncomp' }, sku: itemCodes.length === 1 ? itemCodes[0] : undefined, additionalProperty: itemCodes.map((value) => ({ '@type': 'PropertyValue', name: 'Item number', value })) } : null;
const listingSchema = architectureCategory ? { '@context': 'https://schema.org', '@type': 'ItemList', name: contentText(page.title), itemListElement: architectureProducts.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: contentText(localizedEntry(language, item.contentKey).title), url: `https://corn-comp.com${routeFor(language, item.contentKey)}` })) } : null;
const articleSchema = post || architecture?.kind === 'guide' ? { '@context': 'https://schema.org', '@type': 'Article', name: contentText(entry.title), headline: contentText(entry.title), description: entry.description, mainEntityOfPage: `https://corn-comp.com${entry.route}`, image: post?.featuredMedia ? new URL(post.featuredMedia.localPath, 'https://corn-comp.com').href : undefined, dateModified: entry.dateModified || entry.reviewedDate, author: { '@id': 'https://corn-comp.com/#organization' }, publisher: { '@id': 'https://corn-comp.com/#organization' } } : null;
const webPageSchema = architecture && !listingSchema && !articleSchema ? { '@context': 'https://schema.org', '@type': 'WebPage', name: contentText(page.title), url: `https://corn-comp.com${page.route}`, description: page.description } : null;
const structuredData = [productSchema, listingSchema, articleSchema, webPageSchema, breadcrumbSchema].filter(Boolean);
const pageTitle = entry ? (localized ? `${entry.title} | Corncomp` : source.type === 'architecture' ? `${source.title} | Corncomp` : contentTitle(source)) : `${archive === 'shop' ? productsLabel : blogLabel} | Corncomp`;
const pageDescription = entry ? (localized ? entry.description : source.description || contentDescription(source)) : archive === 'shop' ? `${productsLabel} Corncomp` : `${blogLabel} Corncomp`;
const pagePath = entry?.route || archiveRoutes.find(([lang, kind]) => lang === language && kind === archive)?.[2];
const pageImage = product?.featuredMedia?.localPath || post?.featuredMedia?.localPath;
const pageAlt = localized ? entry?.alt : product?.featuredMedia?.alt || post?.featuredMedia?.alt;
const archivePosts = archive === 'blog' ? inventory.filter((item) => item.type === 'post').map((item) => ({ source: item, entry: localizedEntry(language, item.contentKey) })) : [];
const archiveCategories = archive === 'shop' ? PRODUCT_CATEGORIES.map((item) => { const category = localizedArchitecture(item.route); const products = inventory.filter((product) => product.type === 'product' && categoryForProduct(product.slug)?.slug === item.slug); return { category, products, image: products.find((item) => item.featuredMedia)?.featuredMedia }; }) : [];
const visibleTitle = (value) => contentText(value);
---
{source?.type === 'home' ? <HomePage language={language} content={entry} ui={ui} /> : entry ? (
  <BaseLayout title={pageTitle} description={pageDescription} language={language} pathname={entry.route} image={pageImage} structuredData={structuredData} bodyClass={architecture || product ? 'architecture-site' : ''} ogType={post || architecture?.kind === 'guide' ? 'article' : 'website'}>
    {product ? <article class="content-shell content-product architecture-product">
      <nav class="breadcrumbs" aria-label="Breadcrumb">{breadcrumbs.map(([name, route], i) => <>{i > 0 && <span>/</span>}{i === breadcrumbs.length - 1 ? <span>{visibleTitle(name)}</span> : <a href={route}>{visibleTitle(name)}</a>}</>)}</nav>
      <div class="product-lead"><header class="content-heading product-summary"><p class="content-kind">{visibleTitle(categoryPage.title)}</p><h1>{visibleTitle(entry.title)}</h1>{localized ? <div class="product-excerpt"><p>{entry.summary}</p></div> : product.excerpt && <div class="product-excerpt" set:html={localizeInternalLinks(product.excerpt, language, entry.route)} />}<a class="button-primary" href={quoteHref}>{ui.requestQuote}</a></header>{product.featuredMedia && <figure class="featured-media product-media"><img src={product.featuredMedia.localPath} alt={pageAlt} loading="eager" decoding="async"></figure>}</div>
      <div class="product-detail-layout"><div class="wordpress-content" set:html={bodyHtml} /><aside class="buying-note">{localized ? <><p class="eyebrow">{ui.orderingQuestions}</p><h2>{entry.orderingHeading}</h2><p>{entry.orderTerms}</p><p>{entry.documentScope}</p><a href={quoteHref}>{ui.requestQuote}</a></> : <><p class="eyebrow">Before ordering</p><h2>Confirm the full specification</h2><p>Share the size, quantity, material or coating requirement, print artwork, packing, destination and required documents. Final feasibility, MOQ, lead time and certification scope are confirmed for the selected item.</p><a href={quoteHref}>Send this product with your inquiry</a></>}</aside></div>
      {relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-title"><h2 id="related-title">{ui.relatedProducts}</h2><div class="product-grid">{relatedProducts.map((item) => { const localizedItem = localizedEntry(language, item.contentKey); return <article class="product-card"><a href={localizedItem.route}>{item.featuredMedia && <img src={item.featuredMedia.localPath} alt={localized ? localizedItem.alt : item.featuredMedia.alt} loading="lazy" decoding="async" />}<h3>{visibleTitle(localizedItem.title)}</h3></a></article>; })}</div></section>}
    </article> : post ? <article class="content-shell content-post">
      <nav class="breadcrumbs" aria-label="Breadcrumb">{breadcrumbs.map(([name, route], i) => <>{i > 0 && <span>/</span>}{i === breadcrumbs.length - 1 ? <span>{visibleTitle(name)}</span> : <a href={route}>{visibleTitle(name)}</a>}</>)}</nav><header class="content-heading"><p class="content-kind">{insightLabel}</p><h1>{visibleTitle(entry.title)}</h1></header>{post.featuredMedia && <figure class="featured-media"><img src={post.featuredMedia.localPath} alt={pageAlt} loading="eager" decoding="async"></figure>}<div class="wordpress-content" set:html={bodyHtml} />
    </article> : architectureCategory ? <section class="content-shell category-archive" aria-labelledby="category-title">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><a href={routeFor(language, 'architecture:products')}>{productsLabel}</a><span>/</span><a href={localizedArchitecture(architectureGroup.route).route}>{visibleTitle(localizedArchitecture(architectureGroup.route).title)}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav><header class="architecture-hero compact-hero"><p class="eyebrow">{visibleTitle(localizedArchitecture(architectureGroup.route).title)}</p><h1 id="category-title">{visibleTitle(page.title)}</h1><p>{page.intro}</p><a class="text-link" href={`${contactRoute}?category=${encodeURIComponent(page.title)}&source=${encodeURIComponent(page.route)}`}>{ui.requestQuote} →</a></header><div class="product-grid category-product-grid">{architectureProducts.map((item) => { const localizedItem = localizedEntry(language, item.contentKey); return <article class="product-card"><a href={localizedItem.route}>{item.featuredMedia && <img src={item.featuredMedia.localPath} alt={localized ? localizedItem.alt : item.featuredMedia.alt} loading="lazy" decoding="async" />}<div><p class="content-kind">{visibleTitle(page.title)}</p><h2>{visibleTitle(localizedItem.title)}</h2></div></a></article>; })}</div><section class="buying-guidance"><div><p class="eyebrow">{sourcingLabel}</p><h2>{b2bLabel}</h2></div><div class="architecture-grid">{page.sections.map((section) => <article class="architecture-card"><h3>{section.title}</h3><p>{section.text}</p></article>)}</div></section>
    </section> : architecture.kind === 'products' ? <section class="content-shell architecture-page"><header class="architecture-hero"><p class="eyebrow">{rangeLabel}</p><h1>{visibleTitle(page.title)}</h1><p>{page.intro}</p></header><div class="architecture-grid product-group-grid">{PRODUCT_GROUPS.map((group) => { const localizedItem = localizedArchitecture(group.route); return <a class="architecture-card product-group-card" href={localizedItem.route}><p class="eyebrow">{ui.productGroup}</p><h2>{visibleTitle(localizedItem.title)}</h2><p>{localizedItem.intro}</p><span>{exploreLabel} →</span></a>; })}</div><section class="buying-guidance"><div class="architecture-grid">{page.sections.map((section) => <article class="architecture-card"><h2>{section.title}</h2><p>{section.text}</p></article>)}</div><a class="button-primary" href={contactRoute}>{ui.requestQuote}</a></section></section>
    : architecture.kind === 'product-group' ? <section class="content-shell architecture-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><a href={routeFor(language, 'architecture:products')}>{productsLabel}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav><header class="architecture-hero compact-hero"><p class="eyebrow">{ui.productGroup}</p><h1>{visibleTitle(page.title)}</h1><p>{page.intro}</p></header><div class="architecture-grid category-directory">{groupCategories.map((item) => { const localizedItem = localizedArchitecture(item.route); return <a class="architecture-card" href={localizedItem.route}><h2>{visibleTitle(localizedItem.title)}</h2><p>{localizedItem.intro}</p><span>{viewLabel} →</span></a>; })}</div></section>
    : architecture.kind === 'contact' ? <section class="content-shell contact-layout"><header class="architecture-hero compact-hero"><p class="eyebrow">{ui.contactUs}</p><h1>{visibleTitle(page.title)}</h1><p>{page.intro}</p><div class="contact-direct"><a href="mailto:inquiry@corn-comp.com">inquiry@corn-comp.com</a><span>+86 574 8696 1222</span></div></header><div class="inquiry-panel"><p id="inquiry-sent" class="inquiry-success" role="status">{sentLabel}</p><form class="corncomp-inquiry-form" action="/api/inquiry" method="post"><div class="form-grid"><label>{nameLabel}<input name="name" autocomplete="name" required></label><label>{emailLabel}<input name="email" type="email" autocomplete="email" required></label><label>{companyLabel}<input name="company" autocomplete="organization" required></label><label>{countryLabel}<input name="country" autocomplete="country-name" required></label><label>{phoneLabel}<input name="phone" autocomplete="tel"></label><label>{quantityLabel}<input name="quantity" inputmode="numeric"></label><label class="form-wide">{productLabel}<input name="productName"></label><label>{skuLabel}<input name="productSku"></label><label>{categoryFormLabel}<input name="category"></label><label class="form-wide">{requirementsLabel}<textarea name="message" rows="6" required></textarea></label></div><input type="hidden" name="sourcePath"><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button-primary" type="submit">{sendLabel}</button></form></div><script is:inline>(() => { const form = document.querySelector('.corncomp-inquiry-form'); if (!form) return; const params = new URLSearchParams(window.location.search); const values = { productName: params.get('product'), productSku: params.get('sku'), category: params.get('category'), sourcePath: params.get('source') || document.referrer || window.location.pathname }; for (const [name, value] of Object.entries(values)) if (value && form.elements[name]) form.elements[name].value = value; if (params.get('sent') === '1') document.getElementById('inquiry-sent')?.classList.add('is-visible'); })();</script></section>
    : <section class="content-shell architecture-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav>{(architecture.route === '/about/' || architecture.route === '/quality/') ? <PageHero eyebrow={visibleTitle(page.title)} title={visibleTitle(page.title)} intro={page.intro} media={architecture.route === '/about/' ? mediaFor('architecture:about', language) : null} compact={architecture.route === '/quality/'} /> : <header class="architecture-hero compact-hero"><p class="eyebrow">{visibleTitle(page.title)}</p><h1>{visibleTitle(page.title)}</h1><p>{page.intro}</p>{architecture.kind === 'guide' && <p class="guide-meta">{preparedLabel}{' '}{page.preparedBy} <span aria-hidden="true">·</span> {reviewedLabel}{' '}{page.reviewedLabel}</p>}</header>}{architecture.route === '/quality/' && <CertificateGallery company={companyCertificates(language)} supplyChain={supplyChainDocuments(language)} language={language} />}{page.links.length > 0 && <div class:list={['architecture-grid', 'linked-page-grid', { 'editorial-card-grid': architecture.route === '/quality/' }]}>{page.links.map((item, index) => architecture.route === '/quality/' ? <EditorialCard title={visibleTitle(item.title)} text={item.text} href={item.route} media={index === 0 ? mediaFor('architecture:resources/guides/food-packaging-certifications', language) : null} /> : <a class="architecture-card" href={item.route}><h2>{visibleTitle(item.title)}</h2><p>{item.text}</p><span>{openLabel} →</span></a>)}</div>}<div class:list={['architecture-grid','content-section-grid',{ 'has-links': page.links.length > 0 }]}>{page.sections.map((section) => <article class="architecture-card"><h2>{section.title}</h2><p>{section.text}</p></article>)}</div>{page.table && <section class="guide-table-section" aria-label={page.table.caption}><div class="guide-table-scroll"><table class="guide-table"><caption>{page.table.caption}</caption><thead><tr>{page.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{page.table.rows.map((row) => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div></section>}{page.sources?.length > 0 && <section class="guide-sources"><p class="eyebrow">{sourcesLabel}</p><h2>{officialLabel}</h2><p>{page.sourceIntro}</p><ul>{page.sources.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{visibleTitle(item.title)}</a></li>)}</ul></section>}<section class="architecture-cta"><div><p class="eyebrow">{ui.requestQuote}</p><h2>{visibleTitle(page.title)}</h2><p>{page.description}</p></div><a class="button-primary" href={`${contactRoute}?source=${encodeURIComponent(page.route)}`}>{ui.requestQuote}</a></section></section>}
  </BaseLayout>
) : <BaseLayout title={pageTitle} description={pageDescription} language={language} pathname={pagePath} structuredData={{ '@context':'https://schema.org','@type':'ItemList',name:archive === 'shop' ? productsLabel : blogLabel }}><article class:list={['content-shell',`content-${archive}`]}>{archive === 'shop' ? <section class="shop-archive" aria-labelledby="shop-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="shop-title">{productsLabel}</h1><p>{shopIntro}</p></header><div class="shop-directory"><aside class="shop-category-list" aria-label={categoryLabel}><h2>{categoryLabel}</h2><ul>{archiveCategories.map(({ category }) => <li><a href={category.route}>{visibleTitle(category.title)}</a></li>)}</ul></aside><div class="shop-category-grid">{archiveCategories.map(({ category, products, image }) => <article class="shop-category-card"><a href={category.route}>{image && <img src={image.localPath} alt="" loading="lazy" decoding="async" />}<div><h2>{visibleTitle(category.title)}</h2><p>{products.length} {productsLabel}</p></div></a></article>)}</div></div></section> : <section class="insight-archive" aria-labelledby="blog-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="blog-title">{blogLabel}</h1></header><div class="insight-grid">{archivePosts.map(({ source, entry }) => <article class="insight-card"><a href={entry.route}>{source.featuredMedia && <img src={source.featuredMedia.localPath} alt={localized ? entry.alt : source.featuredMedia.alt} loading="lazy" decoding="async" />}<div><p class="content-kind">{insightLabel}</p><h2>{visibleTitle(entry.title)}</h2></div></a></article>)}</div></section>}</article></BaseLayout>}
