---
import BaseLayout from '../layouts/BaseLayout.astro';
import categories from '../data/categories.json';
import records from '../data/records.json';
import { categoryLanguage, contentDescription, contentPath, contentTitle, localizeInternalLinks, normalizeBodyHeadings } from '../lib/content-routes.mjs';
import { categoryIdsByLanguage, navigationFor } from '../lib/site-config.mjs';
import { ARCHITECTURE_PAGES, LEGACY_PAGE_REDIRECTS, PRODUCT_CATEGORIES, PRODUCT_CATEGORY_BY_SLUG, PRODUCT_GROUPS, canonicalProductRoute, categoryForProduct } from '../lib/site-architecture.mjs';

export function getStaticPaths() {
  const retiredEnglishRoutes = new Set(Object.keys(LEGACY_PAGE_REDIRECTS));
  const contentPaths = records
    .filter((record) => !['/', '/cart/', '/checkout/', '/my-account/'].includes(record.route))
    .filter((record) => record.language !== 'en' || (record.type !== 'product' && !retiredEnglishRoutes.has(record.route)))
    .filter((record) => contentPath(record.route) !== null)
    .map((record) => ({ params: { path: contentPath(record.route) }, props: { record } }));
  const allProducts = records.filter((record) => record.type === 'product');
  const categoryPaths = categories.map((category) => {
    const products = allProducts.filter((product) => product.categoryIds.includes(category.id));
    return { params: { path: contentPath(category.route) }, props: { category, products, language: categoryLanguage(products) } };
  }).filter((item) => item.props.language !== 'en');
  const archivePaths = ['fr', 'es', 'ar'].flatMap((language) => [
    { params: { path: `${language}/shop` }, props: { archive: 'shop', language } },
    { params: { path: `${language}/blog` }, props: { archive: 'blog', language } },
  ]);
  const architecturePaths = ARCHITECTURE_PAGES.map((architecturePage) => ({ params: { path: contentPath(architecturePage.route) }, props: { architecturePage } }));
  const architectureProducts = records
    .filter((record) => record.type === 'product' && record.language === 'en' && PRODUCT_CATEGORY_BY_SLUG[record.slug])
    .map((record) => ({ params: { path: contentPath(canonicalProductRoute(record.slug)) }, props: { record: { ...record, route: canonicalProductRoute(record.slug) }, architectureProduct: true, productCategory: categoryForProduct(record.slug) } }));
  return [...contentPaths, ...categoryPaths, ...archivePaths, ...architecturePaths, ...architectureProducts];
}

const { record, category, products = [], language = 'en', archive, architecturePage, architectureProduct = false, productCategory } = Astro.props;
const currentLanguage = record?.language || language;
const isShop = record?.route === '/shop/' || archive === 'shop';
const isBlog = record?.route === '/blog/' || archive === 'blog';
const isInquiryPage = record?.body?.includes('corncomp-inquiry-form');
const shopCategories = isShop ? categoryIdsByLanguage[currentLanguage].map((id) => {
  const item = categories.find((category) => category.id === id);
  const categoryProducts = item ? records.filter((product) => product.type === 'product' && product.language === currentLanguage && product.categoryIds.includes(item.id)) : [];
  const imageProduct = categoryProducts.find((product) => product.featuredMedia && !/\blid\b/i.test(product.title)) || categoryProducts.find((product) => product.featuredMedia);
  return { ...item, products: categoryProducts, image: imageProduct?.featuredMedia };
}).filter((item) => item.route) : [];
const insightPosts = isBlog ? records.filter((item) => item.type === 'post' && item.language === currentLanguage) : [];
const recordCategories = record?.type === 'product' ? categories.filter((item) => record.categoryIds.includes(item.id)) : [];
const relatedProducts = record?.type === 'product' ? records.filter((item) => item.type === 'product' && item.id !== record.id && item.language === record.language && (architectureProduct ? PRODUCT_CATEGORY_BY_SLUG[item.slug] === productCategory.slug : item.categoryIds.some((id) => record.categoryIds.includes(id)))).slice(0, 4) : [];
const bodyHtml = normalizeBodyHeadings(localizeInternalLinks(record?.body || ''));
const copy = {
  en: { shop: ['Product', 'Browse our full range by category below.', 'Categories', 'Products'], blog: 'Blog', home: 'Home', related: 'Related Products', sent: 'Thank you. Your inquiry has been sent successfully.', description: 'Explore Corncomp products, manufacturing information and sustainable food packaging insights.' },
  fr: { shop: ['Produits', 'Parcourez notre gamme complète par catégorie.', 'Catégories', 'Produits'], blog: 'Blog', home: 'Accueil', related: 'Produits associés', sent: 'Merci. Votre demande a bien été envoyée.', description: 'Découvrez les produits Corncomp, notre fabrication et nos conseils sur les emballages alimentaires durables.' },
  es: { shop: ['Productos', 'Explore nuestra gama completa por categoría.', 'Categorías', 'Productos'], blog: 'Blog', home: 'Inicio', related: 'Productos relacionados', sent: 'Gracias. Su consulta se ha enviado correctamente.', description: 'Explore los productos Corncomp, nuestra fabricación y recursos sobre envases alimentarios sostenibles.' },
  ar: { shop: ['المنتجات', 'تصفح مجموعتنا الكاملة حسب الفئة.', 'الفئات', 'منتجات'], blog: 'المدونة', home: 'الرئيسية', related: 'منتجات ذات صلة', sent: 'شكرًا لك. تم إرسال استفسارك بنجاح.', description: 'استكشف منتجات Corncomp ومعلومات التصنيع وموارد تغليف الأغذية المستدامة.' },
}[currentLanguage];
const nav = navigationFor(currentLanguage);
const pageTitle = architecturePage ? `${architecturePage.title} | Corncomp` : record ? contentTitle(record) : `${archive === 'shop' ? copy.shop[0] : copy.blog} | Corncomp`;
const pagePath = architecturePage?.route || record?.route || `/${currentLanguage}/${archive}/`;
const pageDescription = architecturePage?.description || contentDescription(record, copy.description);
const architectureCategory = architecturePage?.kind === 'product-category' ? PRODUCT_CATEGORIES.find((item) => item.route === architecturePage.route) : null;
const architectureGroup = architecturePage?.kind === 'product-group' ? PRODUCT_GROUPS.find((item) => item.route === architecturePage.route) : architectureCategory ? PRODUCT_GROUPS.find((item) => item.slug === architectureCategory.group) : null;
const architectureProducts = architectureCategory ? records.filter((item) => item.type === 'product' && item.language === 'en' && PRODUCT_CATEGORY_BY_SLUG[item.slug] === architectureCategory.slug) : [];
const groupCategories = architectureGroup ? PRODUCT_CATEGORIES.filter((item) => item.group === architectureGroup.slug) : [];
const quoteHref = architectureProduct ? `/contact/?${new URLSearchParams({ product: record.title.replace(/<[^>]+>/g, ''), sku: record.custom?.sku || '', category: productCategory.title, source: record.route }).toString()}` : '/contact/';
const productGroup = architectureProduct ? PRODUCT_GROUPS.find((item) => item.slug === productCategory.group) : null;
const breadcrumbItems = architectureProduct ? [['Home', '/'], ['Products', '/products/'], [productGroup.title, productGroup.route], [productCategory.title, productCategory.route], [record.title.replace(/<[^>]+>/g, ''), record.route]] : architecturePage ? [['Home', '/'], [architecturePage.title, architecturePage.route]] : [];
const breadcrumbSchema = breadcrumbItems.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbItems.map(([name, route], index) => ({ '@type': 'ListItem', position: index + 1, name, item: `https://corn-comp.com${route}` })) } : null;
const productSchema = record?.type === 'product' ? { '@context': 'https://schema.org', '@type': 'Product', name: record.title.replace(/<[^>]+>/g, ''), url: `https://corn-comp.com${record.route}`, image: record.featuredMedia ? new URL(record.featuredMedia.localPath, 'https://corn-comp.com').href : undefined, description: (record.seo.description || record.excerpt || '').replace(/<[^>]+>/g, '').trim(), category: architectureProduct ? productCategory.title : recordCategories.map((item) => item.name).join(', '), brand: { '@type': 'Brand', name: 'Corncomp' } } : null;
const listingSchema = architectureCategory ? { '@context': 'https://schema.org', '@type': 'ItemList', name: architecturePage.title, itemListElement: architectureProducts.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.title.replace(/<[^>]+>/g, ''), url: `https://corn-comp.com${canonicalProductRoute(item.slug)}` })) } : null;
const articleSchema = architecturePage?.kind === 'guide' ? { '@context': 'https://schema.org', '@type': 'Article', headline: architecturePage.title, description: architecturePage.description, mainEntityOfPage: `https://corn-comp.com${architecturePage.route}`, author: { '@type': 'Organization', name: 'Corncomp' } } : null;
const structuredData = [productSchema, breadcrumbSchema, listingSchema, articleSchema].filter(Boolean);
---
{architectureProduct ? (
  <BaseLayout title={pageTitle} description={pageDescription} language="en" pathname={record.route} image={record.featuredMedia?.localPath} structuredData={structuredData} bodyClass="architecture-site">
    <article class="content-shell content-product architecture-product">
      <nav class="breadcrumbs" aria-label="Breadcrumb">{breadcrumbItems.map(([name, route], index) => <>{index > 0 && <span>/</span>}{index === breadcrumbItems.length - 1 ? <span>{name}</span> : <a href={route}>{name}</a>}</>)}</nav>
      <div class="product-lead"><header class="content-heading product-summary"><p class="content-kind">{productCategory.title}</p><h1 set:html={record.title} />{record.excerpt && <div class="product-excerpt" set:html={localizeInternalLinks(record.excerpt)} />}<a class="button-primary" href={quoteHref}>Request a quote for this product</a></header>{record.featuredMedia && <figure class="featured-media product-media"><img src={record.featuredMedia.localPath} alt={record.featuredMedia.alt || record.title.replace(/<[^>]+>/g, '')} loading="eager" decoding="async"></figure>}</div>
      <div class="product-detail-layout"><div class="wordpress-content" set:html={bodyHtml} /><aside class="buying-note"><p class="eyebrow">Before ordering</p><h2>Confirm the full specification</h2><p>Share the size, quantity, material or coating requirement, print artwork, packing, destination and required documents. Final feasibility, MOQ, lead time and certification scope are confirmed for the selected item.</p><a href={quoteHref}>Send this product with your inquiry</a></aside></div>
      {relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-title"><div class="section-heading"><p class="eyebrow">Continue comparing</p><h2 id="related-title">Related {productCategory.title}</h2></div><div class="product-grid">{relatedProducts.map((product) => <article class="product-card"><a href={canonicalProductRoute(product.slug)}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt || product.title.replace(/<[^>]+>/g, '')} loading="lazy" decoding="async" />}<h3 set:html={product.title} /></a></article>)}</div></section>}
    </article>
  </BaseLayout>
) : architecturePage ? (
  <BaseLayout title={pageTitle} description={pageDescription} language="en" pathname={architecturePage.route} structuredData={structuredData} bodyClass="architecture-site">
    {architectureCategory ? (
      <section class="content-shell category-archive" aria-labelledby="category-title"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><a href={architectureGroup.route}>{architectureGroup.title}</a><span>/</span><span>{architecturePage.title}</span></nav><header class="architecture-hero compact-hero"><p class="eyebrow">{architectureGroup.title}</p><h1 id="category-title">{architecturePage.title}</h1><p>{architecturePage.intro}</p><a class="text-link" href={`/contact/?category=${encodeURIComponent(architecturePage.title)}&source=${encodeURIComponent(architecturePage.route)}`}>Discuss a sourcing program →</a></header><div class="product-grid category-product-grid">{architectureProducts.map((product) => <article class="product-card"><a href={canonicalProductRoute(product.slug)}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt || product.title.replace(/<[^>]+>/g, '')} loading="lazy" decoding="async" />}<div><p class="content-kind">{architecturePage.title}</p><h2 set:html={product.title} /></div></a></article>)}</div><section class="buying-guidance"><div><p class="eyebrow">Sourcing guidance</p><h2>Built for B2B sourcing</h2></div><div class="architecture-grid">{architecturePage.sections.map((section) => <article class="architecture-card"><h3>{section.title}</h3><p>{section.text}</p></article>)}</div></section></section>
    ) : architecturePage.kind === 'products' ? (
      <section class="content-shell architecture-page"><header class="architecture-hero"><p class="eyebrow">Corncomp product range</p><h1>{architecturePage.title}</h1><p>{architecturePage.intro}</p></header><div class="architecture-grid product-group-grid">{PRODUCT_GROUPS.map((group) => <a class="architecture-card product-group-card" href={group.route}><p class="eyebrow">Product group</p><h2>{group.title}</h2><p>{group.description}</p><span>Explore categories →</span></a>)}</div><section class="buying-guidance"><h2>Start with the format, finish with the specification</h2><p>Choose a product family, compare available items, then send the exact product with your quantity, customization, packing, destination and document requirements.</p><a class="button-primary" href="/contact/">Request a quote</a></section></section>
    ) : architecturePage.kind === 'product-group' ? (
      <section class="content-shell architecture-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span>{architecturePage.title}</span></nav><header class="architecture-hero compact-hero"><p class="eyebrow">Product group</p><h1>{architecturePage.title}</h1><p>{architecturePage.intro}</p></header><div class="architecture-grid category-directory">{groupCategories.map((item) => <a class="architecture-card" href={item.route}><h2>{item.title}</h2><p>{item.description}</p><span>View products →</span></a>)}</div></section>
    ) : architecturePage.kind === 'contact' ? (
      <section class="content-shell contact-layout"><header class="architecture-hero compact-hero"><p class="eyebrow">Specification-first inquiry</p><h1>{architecturePage.title}</h1><p>{architecturePage.intro}</p><div class="contact-direct"><a href="mailto:inquiry@corn-comp.com">inquiry@corn-comp.com</a><span>+86 574 8696 1222</span></div></header><div class="inquiry-panel"><p id="inquiry-sent" class="inquiry-success" role="status">Thank you. Your inquiry has been sent successfully.</p><form class="corncomp-inquiry-form" action="/api/inquiry" method="post"><div class="form-grid"><label>Name<input name="name" autocomplete="name" required></label><label>Business email<input name="email" type="email" autocomplete="email" required></label><label>Company<input name="company" autocomplete="organization" required></label><label>Country / market<input name="country" autocomplete="country-name" required></label><label>Phone / WhatsApp<input name="phone" autocomplete="tel"></label><label>Estimated quantity<input name="quantity" inputmode="numeric"></label><label class="form-wide">Product or format<input name="productName"></label><label>Item / SKU<input name="productSku"></label><label>Category<input name="category"></label><label class="form-wide">Requirements<textarea name="message" rows="6" required placeholder="Size, material or coating, artwork, packing, destination and required documents"></textarea></label></div><input type="hidden" name="sourcePath"><label class="honeypot">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button-primary" type="submit">Send inquiry</button></form></div><script is:inline>
        (() => { const form = document.querySelector('.corncomp-inquiry-form'); if (!form) return; const params = new URLSearchParams(window.location.search); const values = { productName: params.get('product'), productSku: params.get('sku'), category: params.get('category'), sourcePath: params.get('source') || document.referrer || window.location.pathname }; for (const [name, value] of Object.entries(values)) if (value && form.elements[name]) form.elements[name].value = value; if (params.get('sent') === '1') document.getElementById('inquiry-sent')?.classList.add('is-visible'); })();
      </script></section>
    ) : (
      <section class="content-shell architecture-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{architecturePage.title}</span></nav><header class="architecture-hero compact-hero"><p class="eyebrow">{architecturePage.kind === 'guide' ? 'Practical sourcing guide' : architecturePage.kind === 'trust' ? 'Company evidence' : architecturePage.kind === 'application' || architecturePage.kind === 'applications' ? 'Application planning' : architecturePage.kind === 'resources' ? 'Buyer resources' : 'Custom packaging'}</p><h1>{architecturePage.title}</h1><p>{architecturePage.intro}</p></header>{architecturePage.links.length > 0 && <div class="architecture-grid linked-page-grid">{architecturePage.links.map((item) => <a class="architecture-card" href={item.route}><h2>{item.title}</h2><p>{item.text}</p><span>Open page →</span></a>)}</div>}<div class:list={['architecture-grid', 'content-section-grid', { 'has-links': architecturePage.links.length > 0 }]}>{architecturePage.sections.map((section) => <article class="architecture-card"><h2>{section.title}</h2><p>{section.text}</p></article>)}</div><section class="architecture-cta"><div><p class="eyebrow">Next step</p><h2>Turn the page into a usable specification</h2><p>Send the product, quantity, customization, packing, destination and document requirements for review.</p></div><a class="button-primary" href={`/contact/?source=${encodeURIComponent(architecturePage.route)}`}>Request a quote</a></section></section>
    )}
  </BaseLayout>
) : record || archive ? (
  <BaseLayout title={pageTitle} description={pageDescription} language={currentLanguage} pathname={pagePath} image={record?.featuredMedia?.localPath} structuredData={structuredData}>
    <article class:list={['content-shell', `content-${record?.type || archive}`, { 'has-inquiry-form': isInquiryPage }]}>
      {record?.type === 'product' ? (
        <><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={nav.home[1]}>{copy.home}</a><span>/</span><a href={nav.product[1]}>{nav.product[0]}</a><span>/</span><span set:html={record.title} /></nav><div class="product-lead"><header class="content-heading product-summary"><p class="content-kind">Product</p><h1 set:html={record.title} />{record.excerpt && <div class="product-excerpt" set:html={localizeInternalLinks(record.excerpt)} />}{recordCategories.length > 0 && <p class="product-categories">{recordCategories.map((item) => <a href={item.route} set:html={item.name} />)}</p>}</header>{record.featuredMedia && <figure class="featured-media product-media"><img src={record.featuredMedia.localPath} alt={record.featuredMedia.alt} loading="eager" decoding="async"></figure>}</div><div class="wordpress-content" set:html={bodyHtml} />{relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-title"><h2 id="related-title">{copy.related}</h2><div class="product-grid">{relatedProducts.map((product) => <article class="product-card"><a href={product.route}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt} loading="lazy" decoding="async" />}<h3 set:html={product.title} /></a></article>)}</div></section>}</>
      ) : isShop ? (
        <section class="shop-archive" aria-labelledby="shop-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="shop-title" set:html={record?.title || copy.shop[0]} /><p>{copy.shop[1]}</p></header><div class="shop-directory"><aside class="shop-category-list" aria-label="Product categories"><h2>{copy.shop[2]}</h2><ul>{shopCategories.map((item) => <li><a href={item.route} set:html={item.name} /></li>)}</ul></aside><div class="shop-category-grid">{shopCategories.map((item) => <article class="shop-category-card"><a href={item.route}>{item.image && <img src={item.image.localPath} alt={item.name} loading="lazy" decoding="async" />}<div><h2 set:html={item.name} /><p>{item.products.length} {copy.shop[3]}</p></div></a></article>)}</div></div>{record && <div class="wordpress-content archive-source" set:html={bodyHtml} />}</section>
      ) : isBlog ? (
        <section class="insight-archive" aria-labelledby="blog-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="blog-title" set:html={record?.title || copy.blog} /></header><div class="insight-grid">{insightPosts.map((post) => <article class="insight-card"><a href={post.route}>{post.featuredMedia && <img src={post.featuredMedia.localPath} alt={post.featuredMedia.alt} loading="lazy" decoding="async" />}<div><p class="content-kind">Insight</p><h2 set:html={post.title} /></div></a></article>)}</div>{record && <div class="wordpress-content archive-source" set:html={bodyHtml} />}</section>
      ) : isInquiryPage ? (
        <div class="contact-layout"><header class="content-heading"><p class="content-kind">Corncomp</p><h1 set:html={record.title} /></header><div><p id="inquiry-sent" class="inquiry-success" role="status">{copy.sent}</p><div class="wordpress-content" set:html={bodyHtml} /></div></div>
      ) : (
        <><header class="content-heading"><p class="content-kind">{record.type === 'post' ? 'Insight' : 'Corncomp'}</p><h1 set:html={record.title} /></header>{record.featuredMedia && <figure class="featured-media"><img src={record.featuredMedia.localPath} alt={record.featuredMedia.alt} loading="eager" decoding="async"></figure>}<div class="wordpress-content" set:html={bodyHtml} /></>
      )}
    </article>
  </BaseLayout>
) : (
  <BaseLayout title={category.seo.title} description={contentDescription({ seo: category.seo, excerpt: category.description }, `${category.name.replace(/<[^>]+>/g, '')} products from Corncomp for wholesale food packaging buyers.`)} language={language} pathname={category.route}>
    <section class="content-shell category-archive" aria-labelledby="category-title"><header class="content-heading"><p class="content-kind">Product category</p><h1 id="category-title" set:html={category.name} />{category.description && <div set:html={localizeInternalLinks(category.description)} />}</header><div class="product-grid">{products.map((product) => <article class="product-card"><a href={product.route}>{product.featuredMedia && <img src={product.featuredMedia.localPath} alt={product.featuredMedia.alt} loading="lazy" decoding="async" />}<h2 set:html={product.title} /></a></article>)}</div></section>
  </BaseLayout>
)}
