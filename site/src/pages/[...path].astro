---
import { CONTACT_DESIGN_LABELS } from '../data/contact-design-labels.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import QualityPage from '../components/QualityPage.astro';
import AboutCompanyPreview from '../components/AboutCompanyPreview.astro';
import FactoryPage from '../components/FactoryPage.astro';
import ResourcesPage from '../components/ResourcesPage.astro';
import PaperCupSizesPage from '../components/PaperCupSizesPage.astro';
import CertificationGuidePage from '../components/CertificationGuidePage.astro';
import BlogPage from '../components/BlogPage.astro';
import PublishedApplication from '../components/PublishedApplication.astro';
import HomePage from '../components/HomePage.astro';
import ArchitecturePage from '../components/ArchitecturePage.astro';
import BlogArchive from '../components/BlogArchive.astro';
import BlogArticle from '../components/BlogArticle.astro';
import PageHero from '../components/PageHero.astro';
import EditorialCard from '../components/EditorialCard.astro';
import ResponsiveMedia from '../components/ResponsiveMedia.astro';
import CupCategoryLanding from '../components/CupCategoryLanding.astro';
import FoodCategoryLanding from '../components/FoodCategoryLanding.astro';
import { SERVICE_CATEGORY_PREVIEWS } from '../data/service-category-preview.mjs';
import { BAGASSE_CATEGORY_PREVIEWS } from '../data/bagasse-category-preview.mjs';
import ProductGroupLanding from '../components/ProductGroupLanding.astro';
import mediaInventory from '../data/media.json';
import { PRODUCT_DIRECTORY_TITLES } from '../data/product-directory.mjs';
import { mediaFor, mediaListFor } from '../lib/visual-media.mjs';
import { contentDescription, contentPath, contentText, contentTitle, localizeInternalLinks, normalizeBodyHeadings } from '../lib/content-routes.mjs';
import { allLocalizedEntries, blogLabelsFor, contentKeyForArchitecture, englishInventory, localizedEntry, routeFor, uiFor } from '../lib/localization.mjs';
import { extractProductFacts, localizedProductBody } from '../lib/product-facts.mjs';
import { PRODUCT_CATEGORIES, PRODUCT_GROUPS, categoryForProduct } from '../lib/site-architecture.mjs';

export function getStaticPaths() {
  const archiveRoutes = [['en', 'blog', '/blog/'], ['fr', 'blog', '/fr/blog/'], ['es', 'blog', '/es/blog/'], ['ar', 'blog', '/ar/blog/'], ['zh', 'blog', '/zh/blog/'], ['de', 'blog', '/de/blog/']];
const publishedCustomKeys = new Set(['home','architecture:resources/guides/food-packaging-certifications','architecture:quality','architecture:resources','architecture:resources/guides/paper-cup-sizes','architecture:applications','architecture:applications/takeaway-packaging','architecture:applications/restaurant-packaging','architecture:applications/fast-food-packaging','architecture:applications/ice-cream-dessert-packaging','architecture:custom-packaging','architecture:custom-packaging/custom-printed-paper-cups','architecture:custom-packaging/custom-paper-straws','architecture:resources/guides/custom-printed-paper-cups']);
  const pages = allLocalizedEntries().filter(({ language, contentKey }) => language !== 'en' || !publishedCustomKeys.has(contentKey)).map(({ language, contentKey, route }) => ({ params: { path: contentPath(route) }, props: { language, contentKey } }));
  return [...pages, ...archiveRoutes.filter(([language]) => language !== 'en').map(([language, archive, route]) => ({ params: { path: contentPath(route) }, props: { language, archive } }))];
}

const archiveRoutes = [['en', 'blog', '/blog/'], ['fr', 'blog', '/fr/blog/'], ['es', 'blog', '/es/blog/'], ['ar', 'blog', '/ar/blog/'], ['zh', 'blog', '/zh/blog/'], ['de', 'blog', '/de/blog/']];

const { language = 'en', contentKey, archive } = Astro.props;
const ResourceRedesign = contentKey === 'architecture:about' ? AboutCompanyPreview : language === 'en' && contentKey === 'architecture:about/factory' ? FactoryPage : archive === 'blog' ? BlogPage : ({'architecture:quality':QualityPage,'architecture:resources':ResourcesPage,'architecture:resources/guides/paper-cup-sizes':PaperCupSizesPage,'architecture:resources/guides/food-packaging-certifications':CertificationGuidePage})[contentKey];
const inventory = englishInventory();
const source = contentKey ? inventory.find((item) => item.contentKey === contentKey) : null;
const entry = contentKey ? localizedEntry(language, contentKey) : null;
const ui = uiFor(language);
const localized = language !== 'en';
const architecture = source?.type === 'architecture' ? source : null;
const product = source?.type === 'product' ? source : null;
const post = source?.type === 'post' ? source : null;
const page = architecture ? entry : null;
const text = {
  en: ['Home','Products','Blog','Insight','Primary sources','Check the official record','Open page','Prepared by','Last reviewed:','Product category','Corncomp product range','Sourcing guidance','Built for B2B sourcing','View products','Explore categories','Thank you. Your inquiry has been sent successfully.','Name','Business email','Company','Country / market','Phone / WhatsApp','Estimated quantity','Product or format','Item / SKU','Category','Requirements','Send inquiry','Browse our full range by category below.'],
  fr: ['Accueil','Produits','Conseils sur les emballages','Article','Sources principales','Consulter les sources officielles','Ouvrir la page','Préparé par','Dernière révision :','Catégorie de produits','Gamme de produits Corncomp','Conseils d’approvisionnement','Conçu pour l’approvisionnement B2B','Voir les produits','Explorer les catégories','Merci. Votre demande a bien été envoyée.','Nom','E-mail professionnel','Entreprise','Pays / marché','Téléphone / WhatsApp','Quantité estimée','Produit ou format','Article / référence','Catégorie','Besoins','Envoyer la demande','Parcourez notre gamme complète par catégorie.'],
  es: ['Inicio','Productos','Guías de envases','Artículo','Fuentes principales','Consultar las fuentes oficiales','Abrir página','Preparado por','Última revisión:','Categoría de productos','Gama de productos Corncomp','Orientación de compra','Creado para compras B2B','Ver productos','Explorar categorías','Gracias. Su consulta se ha enviado correctamente.','Nombre','Correo electrónico profesional','Empresa','País / mercado','Teléfono / WhatsApp','Cantidad estimada','Producto o formato','Artículo / referencia','Categoría','Requisitos','Enviar consulta','Explore nuestra gama completa por categoría.'],
  ar: ['الرئيسية','المنتجات','دليل التغليف المستدام','مقال','المصادر الرئيسية','راجع السجل الرسمي','فتح الصفحة','إعداد','آخر مراجعة:','فئة المنتجات','مجموعة منتجات Corncomp','إرشادات التوريد','معدّ للتوريد بين الشركات','عرض المنتجات','استكشاف الفئات','شكرًا لك. تم إرسال استفسارك بنجاح.','الاسم','البريد الإلكتروني للعمل','الشركة','الدولة / السوق','الهاتف / WhatsApp','الكمية التقديرية','المنتج أو الشكل','الصنف / الرمز','الفئة','المتطلبات','إرسال الاستفسار','تصفح مجموعتنا الكاملة حسب الفئة.'],
  zh: ['首页','产品','包装指南','文章','主要来源','查看官方记录','打开页面','编写：','最后审阅：','产品分类','Corncomp 产品系列','采购指南','面向 B2B 采购','查看产品','浏览分类','谢谢，您的询盘已成功发送。','姓名','企业邮箱','公司','国家/市场','电话/WhatsApp','预计数量','产品或形式','货号/SKU','分类','具体要求','发送询盘','请按分类浏览我们的完整产品系列。'],
  de: ['Startseite','Produkte','Verpackungsleitfäden','Artikel','Primärquellen','Offiziellen Nachweis prüfen','Seite öffnen','Erstellt von','Zuletzt geprüft:','Produktkategorie','Corncomp Produktsortiment','Beschaffungsleitfaden','Für B2B-Beschaffung entwickelt','Produkte ansehen','Kategorien entdecken','Vielen Dank. Ihre Anfrage wurde erfolgreich gesendet.','Name','Geschäftliche E-Mail','Unternehmen','Land / Markt','Telefon / WhatsApp','Geschätzte Menge','Produkt oder Format','Artikel / SKU','Kategorie','Anforderungen','Anfrage senden','Entdecken Sie unser vollständiges Sortiment nach Kategorie.'],
}[language];
const [homeLabel, productsLabel, blogLabel, insightLabel, sourcesLabel, officialLabel, , preparedLabel, reviewedLabel, categoryLabel, rangeLabel, sourcingLabel, b2bLabel, viewLabel, , sentLabel, nameLabel, emailLabel, companyLabel, countryLabel, phoneLabel, quantityLabel, productLabel, skuLabel, categoryFormLabel, requirementsLabel, sendLabel, shopIntro] = text;
const architectureKey = (route) => contentKeyForArchitecture({ route });
const localizedArchitecture = (route) => localizedEntry(language, architectureKey(route));
const productCategory = product ? categoryForProduct(product.slug) : null;
const categoryPage = productCategory ? localizedArchitecture(productCategory.route) : null;
const productGroup = productCategory ? PRODUCT_GROUPS.find((item) => item.slug === productCategory.group) : null;
const groupPage = productGroup ? localizedArchitecture(productGroup.route) : null;
const architectureCategory = architecture?.kind === 'product-category' ? PRODUCT_CATEGORIES.find((item) => item.route === architecture.route) : null;
const architectureGroup = architecture?.kind === 'product-group' ? PRODUCT_GROUPS.find((item) => item.route === architecture.route) : architectureCategory ? PRODUCT_GROUPS.find((item) => item.slug === architectureCategory.group) : null;
const architectureProducts = architectureCategory ? inventory.filter((item) => item.type === 'product' && (architectureCategory.slug === 'paper-food-boxes' ? ['paper-trays','square-food-boxes','round-food-boxes','menu-boxes'].includes(categoryForProduct(item.slug)?.slug) : categoryForProduct(item.slug)?.slug === architectureCategory.slug)) : [];
const groupCategories = architectureGroup ? PRODUCT_CATEGORIES.filter((item) => item.group === architectureGroup.slug) : [];
const productMedia = (item) => {
  if (!item?.featuredMedia) return null;
  const image = item.featuredMedia;
  const dimensions = mediaInventory.find((asset) => asset.id === image.id).media_details;
  return { src: image.localPath, width: dimensions.width, height: dimensions.height, alt: localized ? localizedEntry(language, item.contentKey).alt : image.alt, fit: 'contain', position: 'center', evidence: 'product' };
};
const categoryMedia = (category) => mediaFor(architectureKey(category.route), language) || productMedia(inventory.find((item) => item.type === 'product' && categoryForProduct(item.slug)?.slug === category.slug));
const productEvidence = product ? mediaListFor(product.contentKey, language) : [];
const evidenceText = {
  en: { title: 'Company documents and item scope', context: 'Images show product-family and Corncomp facility context. Company certificates do not establish certification for this item. Confirm the documents for the selected material and order.', link: 'Review company-level documents' },
  fr: { title: 'Documents de l’entreprise et portée par article', context: 'Ces images présentent la famille de produits et les installations Corncomp. Les certificats de l’entreprise ne prouvent pas la certification de cet article. Confirmez les documents pour la matière et la commande choisies.', link: 'Consulter les documents de l’entreprise' },
  es: { title: 'Documentos de la empresa y alcance por artículo', context: 'Las imágenes muestran la familia de productos y las instalaciones de Corncomp. Los certificados de la empresa no acreditan la certificación de este artículo. Confirme los documentos para el material y el pedido elegidos.', link: 'Consultar los documentos de la empresa' },
  ar: { title: 'وثائق الشركة ونطاق الصنف', context: 'تعرض الصور عائلة المنتجات وسياق منشأة كورنكومب. شهادات الشركة لا تثبت اعتماد هذا الصنف. أكد الوثائق المنطبقة على الخامة والطلب المختارين.', link: 'مراجعة وثائق الشركة' },
  zh: { title: '公司文件与产品适用范围', context: '图片用于展示产品系列及 Corncomp 工厂环境。公司证书并不代表该产品已经获得同等认证，请确认所选材料和订单对应的文件。', link: '查看公司层面的文件' },
  de: { title: 'Unternehmensdokumente und Artikelumfang', context: 'Die Bilder zeigen die Produktfamilie und das Umfeld der Corncomp-Anlage. Unternehmenszertifikate belegen keine Zertifizierung dieses Artikels. Bestätigen Sie die Dokumente für das gewählte Material und die Bestellung.', link: 'Unternehmensdokumente prüfen' },
}[language];
const relatedProducts = product ? inventory.filter((item) => item.type === 'product' && item.contentKey !== product.contentKey && categoryForProduct(item.slug)?.slug === productCategory.slug).slice(0, 4) : [];
const facts = product ? extractProductFacts(product) : null;
const displayFacts = facts ? { ...facts, tables: facts.tables.map(({ headers, rows }) => ({ headers, rows: rows.map((row) => row.map((cell) => ui.specificationValues?.[cell] || cell)) })) } : null;
const productHtml = product ? (localized ? localizedProductBody(entry, displayFacts, ui) : product.body) : '';
const bodyHtml = product ? normalizeBodyHeadings(localizeInternalLinks(productHtml, language, entry.route)) : post ? normalizeBodyHeadings(localizeInternalLinks(localized ? entry.bodyHtml : post.body, language, entry.route)) : '';
const itemCodes = facts?.itemCodes || [];
const contactRoute = routeFor(language, 'architecture:contact');
const quoteHref = entry ? `${contactRoute}?${new URLSearchParams({ product: contentText(entry.title), sku: itemCodes.length === 1 ? itemCodes[0] : '', category: categoryPage?.title || '', source: entry.route }).toString()}` : contactRoute;
const breadcrumbs = entry ? [[homeLabel, routeFor(language, 'home')], ...(product ? [[productsLabel, routeFor(language, 'architecture:products')], [groupPage.title, groupPage.route], [categoryPage.title, categoryPage.route]] : post ? [[blogLabel, language === 'en' ? '/blog/' : `/${language}/blog/`]] : architecture?.kind?.startsWith('product-') ? [[productsLabel, routeFor(language, 'architecture:products')]] : []), [entry.title, entry.route]] : [];
const breadcrumbSchema = breadcrumbs.length > 1 ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map(([name, route], index) => ({ '@type': 'ListItem', position: index + 1, name: contentText(name), item: `https://corn-comp.com${route}` })) } : null;
const productSchema = product ? { '@context': 'https://schema.org', '@type': 'Product', name: contentText(entry.title), url: `https://corn-comp.com${entry.route}`, image: product.featuredMedia ? new URL(product.featuredMedia.localPath, 'https://corn-comp.com').href : undefined, description: localized ? entry.description : contentDescription(product), category: categoryPage.title, brand: { '@type': 'Brand', name: 'Corncomp' }, sku: itemCodes.length === 1 ? itemCodes[0] : undefined, additionalProperty: itemCodes.map((value) => ({ '@type': 'PropertyValue', name: 'Item number', value })) } : null;
const listingSchema = architectureCategory ? { '@context': 'https://schema.org', '@type': 'ItemList', name: contentText(page.title), itemListElement: architectureProducts.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: contentText(localizedEntry(language, item.contentKey).title), url: `https://corn-comp.com${routeFor(language, item.contentKey)}` })) } : null;
const articleSchema = post || architecture?.kind === 'guide' ? { '@context': 'https://schema.org', '@type': 'Article', name: contentText(entry.title), headline: contentText(entry.title), description: entry.description, mainEntityOfPage: `https://corn-comp.com${entry.route}`, image: post?.featuredMedia ? new URL(post.featuredMedia.localPath, 'https://corn-comp.com').href : undefined, dateModified: entry.dateModified || entry.reviewedDate, author: { '@id': 'https://corn-comp.com/#organization' }, publisher: { '@id': 'https://corn-comp.com/#organization' } } : null;
const webPageSchema = architecture && !listingSchema && !articleSchema ? { '@context': 'https://schema.org', '@type': 'WebPage', name: architecture.kind === 'contact' ? `${CONTACT_DESIGN_LABELS[language].title1} ${CONTACT_DESIGN_LABELS[language].title2}` : architecture.kind === 'products' ? PRODUCT_DIRECTORY_TITLES[language] : contentText(page.title), url: `https://corn-comp.com${page.route}`, description: page.description } : null;
if (architecture?.kind === 'contact') {
  const contactUrl = `https://corn-comp.com${page.route}`;
  Object.assign(breadcrumbSchema, {'@id':`${contactUrl}#breadcrumb`});
  Object.assign(webPageSchema, {
    '@type':'ContactPage', '@id':`${contactUrl}#webpage`, inLanguage:language==='zh'?'zh-CN':language,
    mainEntity:{'@id':'https://corn-comp.com/#organization'},
    about:{'@id':'https://corn-comp.com/#organization'},
    isPartOf:{'@type':'WebSite','@id':'https://corn-comp.com/#website',name:'Corncomp',url:'https://corn-comp.com/'},
    breadcrumb:{'@id':`${contactUrl}#breadcrumb`},
  });
}
const structuredData = [productSchema, listingSchema, articleSchema, webPageSchema, breadcrumbSchema].filter(Boolean);
const pageTitle = entry ? (localized ? `${entry.title} | Corncomp` : source.type === 'architecture' ? `${source.title} | Corncomp` : contentTitle(source)) : `${archive === 'shop' ? productsLabel : blogLabel} | Corncomp`;
const pageDescription = entry ? (localized ? entry.description : source.description || contentDescription(source)) : archive === 'shop' ? `${productsLabel} Corncomp` : `${blogLabel} Corncomp`;
const pagePath = entry?.route || archiveRoutes.find(([lang, kind]) => lang === language && kind === archive)?.[2];
const pageImage = product?.featuredMedia?.localPath || post?.featuredMedia?.localPath;
const archivePosts = archive === 'blog' ? inventory.filter((item) => item.type === 'post').map((item) => ({ source: item, entry: localizedEntry(language, item.contentKey) })) : [];
const relatedPosts = post ? inventory.filter((item) => item.type === 'post' && item.contentKey !== post.contentKey).slice(0, 3).map((item) => ({ source: item, entry: localizedEntry(language, item.contentKey) })) : [];
const blogLabels = { ...blogLabelsFor(language), title: blogLabel, insight: insightLabel };
const archiveCategories = archive === 'shop' ? PRODUCT_CATEGORIES.map((item) => { const category = localizedArchitecture(item.route); const products = inventory.filter((product) => product.type === 'product' && categoryForProduct(product.slug)?.slug === item.slug); return { category, products, image: products.find((item) => item.featuredMedia)?.featuredMedia }; }) : [];
const recentPosts = architecture?.kind === 'resources' ? inventory.filter((item) => item.type === 'post').slice(0, 3).map((item) => ({ source: item, entry: localizedEntry(language, item.contentKey) })) : [];
const visibleTitle = (value) => contentText(value);
---
{ResourceRedesign ? <ResourceRedesign preview={false} /> : contentKey?.startsWith('architecture:applications') ? <PublishedApplication scene={contentKey.replace('architecture:applications', '').replace(/^\//, '')} /> : source?.type === 'home' ? <HomePage language={language} content={entry} ui={ui} /> : entry ? (
  <BaseLayout title={pageTitle} description={pageDescription} language={language} pathname={entry.route} image={pageImage} structuredData={structuredData} bodyClass={architecture || product ? 'architecture-site' : ''} ogType={post || architecture?.kind === 'guide' ? 'article' : 'website'}>
    {product ? <article class="content-shell content-product architecture-product">
      <nav class="breadcrumbs" aria-label="Breadcrumb">{breadcrumbs.map(([name, route], i) => <>{i > 0 && <span>/</span>}{i === breadcrumbs.length - 1 ? <span>{visibleTitle(name)}</span> : <a href={route}>{visibleTitle(name)}</a>}</>)}</nav>
<div class="product-lead"><header class="content-heading product-summary"><p class="content-kind">{visibleTitle(categoryPage.title)}</p><h1>{visibleTitle(entry.title)}</h1>{localized ? <div class="product-excerpt"><p>{entry.summary}</p></div> : product.excerpt && <div class="product-excerpt" set:html={localizeInternalLinks(product.excerpt, language, entry.route)} />}<a class="button-primary" href={quoteHref}>{localized ? ui.requestQuote : 'Add to enquiry'}</a></header>{product.featuredMedia && <figure class="featured-media product-media"><ResponsiveMedia media={productMedia(product)} eager /></figure>}</div>
      <div class="product-detail-layout"><div class="wordpress-content" set:html={bodyHtml} /><aside class="buying-note">{localized ? <><p class="eyebrow">{ui.orderingQuestions}</p><h2>{entry.orderingHeading}</h2><p>{entry.orderTerms}</p><p>{entry.documentScope}</p><a href={quoteHref}>{ui.requestQuote}</a></> : <><p class="eyebrow">Before ordering</p><h2>Confirm the full specification</h2><p>Share the size, quantity, material or coating requirement, print artwork, packing, destination and required documents. Final feasibility, MOQ, lead time and certification scope are confirmed for the selected item.</p><a href={quoteHref}>Send this product with your inquiry</a></>}</aside></div>
      {productEvidence.length > 0 && <section class="product-evidence" aria-labelledby="product-evidence-title">
        <div class="product-evidence__heading"><h2 id="product-evidence-title">{evidenceText.title}</h2><p>{evidenceText.context}</p>{localized && <p>{entry.documentScope}</p>}<a class="text-link" href={routeFor(language, 'architecture:quality')}>{evidenceText.link}</a></div>
        <div class="product-evidence__media">{productEvidence.map((media) => <figure><ResponsiveMedia media={media} /><figcaption>{media.alt}</figcaption></figure>)}</div>
      </section>}
      {relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-title"><h2 id="related-title">{ui.relatedProducts}</h2><div class="product-grid">{relatedProducts.map((item) => { const localizedItem = localizedEntry(language, item.contentKey); return <article class="product-card"><a href={localizedItem.route}><ResponsiveMedia media={productMedia(item)} /><h3>{visibleTitle(localizedItem.title)}</h3></a></article>; })}</div></section>}
    </article> : post ? <BlogArticle source={post} entry={entry} bodyHtml={bodyHtml} language={language} breadcrumbs={breadcrumbs} relatedPosts={relatedPosts} labels={blogLabels} /> : architectureCategory?.group === 'cups-bowls' ? <CupCategoryLanding category={architectureCategory.slug} page={page} language={language} /> : architectureCategory?.group === 'food-boxes-containers' && architectureCategory.slug !== 'paper-food-boxes' ? <FoodCategoryLanding category={architectureCategory.slug} page={page} language={language} /> : architectureCategory?.group === 'bagasse' ? <FoodCategoryLanding category={architectureCategory.slug} page={page} language={language} configs={BAGASSE_CATEGORY_PREVIEWS} groupSlug="bagasse" /> : architectureCategory?.group === 'foodservice-supplies' ? <FoodCategoryLanding category={architectureCategory.slug} page={page} language={language} configs={SERVICE_CATEGORY_PREVIEWS} groupSlug="foodservice-supplies" /> : architectureCategory ? <section class="content-shell category-archive" aria-label={visibleTitle(page.title)}>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><a href={routeFor(language, 'architecture:products')}>{productsLabel}</a><span>/</span><a href={localizedArchitecture(architectureGroup.route).route}>{visibleTitle(localizedArchitecture(architectureGroup.route).title)}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav>
      <PageHero eyebrow={visibleTitle(localizedArchitecture(architectureGroup.route).title)} title={visibleTitle(page.title)} intro={page.intro} media={categoryMedia(architectureCategory)} compact actions={[{ href: `${contactRoute}?category=${encodeURIComponent(page.title)}&source=${encodeURIComponent(page.route)}`, label: ui.requestQuote }]} />
      <div class="product-grid category-product-grid">{architectureProducts.map((item) => { const localizedItem = localizedEntry(language, item.contentKey); return <EditorialCard title={visibleTitle(localizedItem.title)} href={localizedItem.route} media={productMedia(item)} label={visibleTitle(page.title)} />; })}</div>
      <section class="buying-guidance"><div><p class="eyebrow">{sourcingLabel}</p><h2>{b2bLabel}</h2></div><div class="architecture-grid">{page.sections.map((section) => <article class="architecture-card"><h3>{section.title}</h3><p>{section.text}</p></article>)}</div></section>
    </section> : architecture.kind === 'product-group' && ['cups-bowls','food-boxes-containers','bagasse','foodservice-supplies'].includes(architectureGroup.slug) ? <ProductGroupLanding group={architectureGroup.slug} page={page} language={language} /> : architecture.kind === 'product-group' ? <section class="content-shell architecture-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(language, 'home')}>{homeLabel}</a><span>/</span><a href={routeFor(language, 'architecture:products')}>{productsLabel}</a><span>/</span><span>{visibleTitle(page.title)}</span></nav>
      <PageHero eyebrow={ui.productGroup} title={visibleTitle(page.title)} intro={page.intro} media={mediaFor(contentKey, language)} compact />
      <div class="architecture-grid category-directory">{groupCategories.map((item) => { const localizedItem = localizedArchitecture(item.route); return <EditorialCard title={visibleTitle(localizedItem.title)} text={localizedItem.intro} href={localizedItem.route} media={categoryMedia(item)} label={viewLabel} />; })}</div></section>
    : <ArchitecturePage source={architecture} page={page} language={language} ui={ui} contactRoute={contactRoute} contactDesign={architecture.kind === 'contact'} labels={{ homeLabel, rangeLabel, sentLabel, nameLabel, emailLabel, companyLabel, countryLabel, phoneLabel, quantityLabel, productLabel, skuLabel, categoryFormLabel, requirementsLabel, sendLabel, preparedLabel, reviewedLabel, sourcesLabel, officialLabel }} recentPosts={recentPosts} />}
  </BaseLayout>
) : <BaseLayout title={pageTitle} description={pageDescription} language={language} pathname={pagePath} structuredData={{ '@context':'https://schema.org','@type':'ItemList',name:archive === 'shop' ? productsLabel : blogLabel }}><article class:list={['content-shell',`content-${archive}`]}>{archive === 'shop' ? <section class="shop-archive" aria-labelledby="shop-title"><header class="content-heading archive-heading"><p class="content-kind">Corncomp</p><h1 id="shop-title">{productsLabel}</h1><p>{shopIntro}</p></header><div class="shop-directory"><aside class="shop-category-list" aria-label={categoryLabel}><h2>{categoryLabel}</h2><ul>{archiveCategories.map(({ category }) => <li><a href={category.route}>{visibleTitle(category.title)}</a></li>)}</ul></aside><div class="shop-category-grid">{archiveCategories.map(({ category, products, image }) => <article class="shop-category-card"><a href={category.route}>{image && <img src={image.localPath} alt="" loading="lazy" decoding="async" />}<div><h2>{visibleTitle(category.title)}</h2><p>{products.length} {productsLabel}</p></div></a></article>)}</div></div></section> : <BlogArchive posts={archivePosts} language={language} labels={blogLabels} />}</article></BaseLayout>}
